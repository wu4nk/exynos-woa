-      ddi.last_unsignalled = 1;
+      static unsigned no_event;
+      if (no_event++ < 3 || trace_on())
+         fprintf(stderr, "malikm-wddm: pid %lu: no completion event for submission %llu;"
+                 " its waits poll the KMD until it catches up\n", GetCurrentProcessId(), (unsigned long long)wseq);
+      pend_push(NULL);
+      wperf.render_t += perf_now() - t0;
       return 0;
    }
    D3DKMT_RENDER r = {0};
@@ -1042,72 +1149,258 @@ w_render(UINT commandLength, UINT allocations)
    walloc_size = r.NewAllocationListSize;
    wpatch = r.pNewPatchLocationList;
    wpatch_size = r.NewPatchLocationListSize;
+   wseq++;
    return 0;
 }
 
-/* Everything the KMD was given has completed: its fences agree and nothing
- * is queued or running. For when there is no event to wait on. */
+/* Destroy the closed allocations no submission in flight can use any more. */
+static void
+wdead_flush(void)
+{
+   uint32_t kept = 0, gone = 0;
+   for (uint32_t i = 0; i < wdead_n; i++) {
+      if (wdead[i].seq <= wdone) {
+         w_destroy(wdead[i].h);
+         gone++;
+      } else {
+         wdead[kept++] = wdead[i];
+      }
+   }
+   wdead_n = kept;
+   if (gone && trace_on())
+      fprintf(stderr, "malikm-wddm: destroyed %u closed allocations, %u wait for their jobs\n", gone, kept);
+}
+
+/* Retire, without waiting, the submissions that are done. */
+static void
+w_retire(void)
+{
+   uint64_t was = wdone;
+   if (wcur->pend_n > 1) {
+      /* the newest done means all are (one queue, in order) */
+      struct wpend *t = &wcur->pend[(wcur->pend_head + wcur->pend_n - 1) % WPEND];
+      if (t->ev && WaitForSingleObject(t->ev, 0) == WAIT_OBJECT_0) {
+         while (wcur->pend_n)
+            pend_pop();
+      }
+   }
+   while (wcur->pend_n) {
+      struct wpend *p = &wcur->pend[wcur->pend_head];
+      if (p->ev) {
+         if (WaitForSingleObject(p->ev, 0) != WAIT_OBJECT_0)
+            break;
+         pend_pop();
+      } else {
+         if (w_kmd_idle() != 1)
+            break;
+         while (wcur->pend_n)
+            pend_pop();
+         wdone = wseq;
+      }
+   }
+   if (wdone != was && wdead_n)
+      wdead_flush();
+}
