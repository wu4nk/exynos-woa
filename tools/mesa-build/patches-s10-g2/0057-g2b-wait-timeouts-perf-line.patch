+   }
+   if (timeout_ns == 0)
+      wperf.polls++;
+   if (seq <= wdone)
+      return 0;
+   w_retire();
+   if (seq <= wdone)
+      return 0;
+   if (timeout_ns == 0) {
+      wperf.polls_busy++;
+      return -MK_EBUSY;
+   }
+   DWORD ms = 10000;
+   if (timeout_ns < MALIKM_TIMEOUT_INFINITE && timeout_ns / 1000000 < 10000)
+      ms = (DWORD)((timeout_ns + 999999) / 1000000);
+   struct wpend *p = NULL;
+   for (uint32_t k = 0; k < wcur->pend_n; k++) {
