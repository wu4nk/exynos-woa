+   if (seq > wseq)
+      seq = wseq;
+   if (!ddi.on) {
+      /* D3DKMT (tools): no events; the device's WaitForIdle covers everything */
+      if (seq <= wdone)
          return 0;
-      Sleep(1);
+      if (timeout_ns == 0) {
+         wperf.polls++;
+         if (w_kmd_idle() == 1) {
