+                 pname ? pname : "?");
+      }
+   }
    dev->fault_injection_rate =
       debug_get_num_option("PAN_FAULT_INJECTION_RATE", 0);
    screen->max_afbc_packing_ratio = debug_get_num_option(
diff --git a/src/gallium/frontends/d3d10umd/Resource.cpp b/src/gallium/frontends/d3d10umd/Resource.cpp
index e2c55e7..71014ca 100644
--- a/src/gallium/frontends/d3d10umd/Resource.cpp
+++ b/src/gallium/frontends/d3d10umd/Resource.cpp
@@ -207,6 +207,13 @@ extern "C" int malikm_shared_create(void *hRTResource, unsigned w, unsigned h, u
                                     unsigned *hAlloc, void **cpu, unsigned *pitch);
 /* G13: true when the device is bound to the maliwddm runtime (d3d10_gdi.c d3d10_bind_runtime result >= 0). */
 extern "C" bool d3d10_runtime_is_maliwddm(void);
+/* G2b-3 (0046, malikm_drm.c): shared resources on the GPU - the next BO this thread creates is the resource's
+ * runtime allocation (begin/end, end returns its handle or 0); an opened allocation as a "dma-buf" fd for
+ * resource_from_handle (import_alloc, -1 if it has no GPU address; import_done closes the fd). */
+extern "C" void malikm_shared_bo_begin(void *hRTResource, unsigned w, unsigned h, unsigned pitch, unsigned d3dfmt);
+extern "C" unsigned malikm_shared_bo_end(void);
+extern "C" int malikm_import_alloc(unsigned hAlloc);
+extern "C" void malikm_import_done(int fd);
 
 /* G2b-3 (0045, run g2b3-4): DWM on Panfrost composed black. What it opens (the CDD shared primaries, the shadow
  * surface) were imported with resource_from_handle(WINSYS_HANDLE_TYPE_SHARED, CPU pointer) - softpipe's
@@ -390,7 +397,46 @@ CreateResource(D3D10DDI_HDEVICE hDevice,                                // IN
     * kept locked and softpipe renders into it (gdi winsys external memory, patch 0035), so what the creator draws is
     * what an opener of the allocation sees. Single-mip, single-slice only (the shareable case, MS Learn
     * D3D11_RESOURCE_MISC_SHARED: "2D non-mipmapped textures"); anything else keeps the plain path. */
+   /* G2b-3 (0046): on the GPU screen the shared texture's BO is the runtime allocation itself (linear, pitch
+    * aligned as Panfrost lays it out), so what the Mali draws into it is what DWM's import of it reads; no CPU
+    * lock, no copy. The CPU path below stays for softpipe. */
+   const char *cr_sname = screen->get_name ? screen->get_name(screen) : NULL;
+   const bool cr_gpu = cr_sname && strcmp(cr_sname, "softpipe") != 0 && strcmp(cr_sname, "llvmpipe") != 0;
    if ((pCreateResource->MiscFlags & D3D10_DDI_RESOURCE_MISC_SHARED) && !pCreateResource->pPrimaryDesc &&
+       templat.target == PIPE_TEXTURE_2D && pCreateResource->MipLevels == 1 && pCreateResource->ArraySize == 1 &&
+       d3d10_runtime_is_maliwddm() && cr_gpu) {
+      static unsigned shared_creates;
+      unsigned d3dfmt = 0;
+      if (templat.format == PIPE_FORMAT_B8G8R8A8_UNORM)
+         d3dfmt = D3DDDIFMT_A8R8G8B8;
+      else if (templat.format == PIPE_FORMAT_B8G8R8X8_UNORM)
+         d3dfmt = D3DDDIFMT_X8R8G8B8;
+      else if (templat.format == PIPE_FORMAT_R8G8B8A8_UNORM)
+         d3dfmt = D3DDDIFMT_A8B8G8R8;
+      unsigned cpp = util_format_get_blocksize(templat.format);
+      unsigned pitch = (templat.width0 * cpp + 63) & ~63u;
+      unsigned hShared = 0;
+      uint64_t stride = 0;
+      if (d3dfmt) {
+         struct pipe_resource t = templat;
+         t.bind |= PIPE_BIND_SHARED | PIPE_BIND_LINEAR;
+         malikm_shared_bo_begin(hRTResource.handle, templat.width0, templat.height0, pitch, d3dfmt);
+         pResource->resource = screen->resource_create(screen, &t);
+         hShared = malikm_shared_bo_end();
+         if (pResource->resource && screen->resource_get_param)
+            screen->resource_get_param(screen, pipe, pResource->resource, 0, 0, 0, PIPE_RESOURCE_PARAM_STRIDE, 0,
+                                       &stride);
+         if (pResource->resource && !hShared)
+            pipe_resource_reference(&pResource->resource, NULL);   /* not shareable: the runtime has no allocation */
