+/*
+ * exynos-woa G2c (0073): geometry shader emulation on the Bifrost job manager, ported from
+ * JimVulkan/mali-panfrost (MIT, Copyright 2026 XclipseTools) - see pan_gs.h.
+ *
+ * The fragment shader's gl_ViewportIndex and gl_Layer reads, from the slots the emulation writes
+ * them in (PAN_GS_VIEWPORT_SLOT).
+ */
+static bool
+panfrost_move_emulated_inputs(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_input &&
+       intr->intrinsic != nir_intrinsic_load_interpolated_input)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   if (sem.location == VARYING_SLOT_VIEWPORT)
+      sem.location = PAN_GS_VIEWPORT_SLOT;
