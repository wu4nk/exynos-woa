From 36ac4d761ca48c0f98090b0504d92fb9fdb919ad Mon Sep 17 00:00:00 2001
From: exynos-woa <build@local>
Date: Thu, 12 Nov 2026 00:55:14 +0700
Subject: [PATCH] S10: log why D3DKMTLock fails on the D3DKMT (GL ICD) path

---
 include/win32-compat/malikm_drm.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
index 5b2353f..4709891 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -1283,7 +1283,16 @@ w_lock_raw(D3DKMT_HANDLE h)
    l.hDevice = wdevice;
    l.hAllocation = h;
    l.Flags.IgnoreSync = 1;
-   return kmt.Lock(&l) >= 0 ? l.pData : NULL;
+   NTSTATUS st = kmt.Lock(&l);
+   if (st < 0) {
+      /* S10 (notes/beyond1-port.md 2026-11-12): gltest on the S10 - every BO mmap failed (EINVAL) on this D3DKMT path,
+       * GLTEST 0/5 with GL_INVALID_FRAMEBUFFER_OPERATION. The status says why; the first 8 failures are logged. */
+      static LONG n;
+      if (InterlockedIncrement(&n) <= 8)
+         malikm_tlog("kmt Lock 0x%x (device 0x%x) failed 0x%08lx", h, wdevice, (unsigned long)st);
+      return NULL;
+   }
+   return l.pData;
 }
 
 static void
-- 
2.43.0

