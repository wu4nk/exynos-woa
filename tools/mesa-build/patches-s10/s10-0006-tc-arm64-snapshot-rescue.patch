From 30d5c42f93f6d7e84d0c8f107a60c775a91ac2c8 Mon Sep 17 00:00:00 2001
From: exynos-woa <build@local>
Date: Thu, 12 Nov 2026 03:38:46 +0700
Subject: [PATCH] S10: ARM64 DDI-thread snapshot, repeated snapshots,
 MALIUMD_TC_RESCUE diagnosis

---
 include/win32-compat/malikm_drm.c | 74 +++++++++++++++++++++++++++++--
 1 file changed, 70 insertions(+), 4 deletions(-)

diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
index 4a7a113..6dd0fe1 100644
--- a/include/win32-compat/malikm_drm.c
+++ b/include/win32-compat/malikm_drm.c
@@ -1569,6 +1569,49 @@ mk_snapshot_ddi_thread(void)
    }
    CloseHandle(t);
    malikm_tlog("tc: DDI thread %lu: %s", tid, line);
+#elif defined(_M_ARM64) || defined(__aarch64__)
+   /* S10 port (patches-s10/s10-0006, notes/beyond1-port.md 2026-11-12): the same scan for native ARM64 (DWM, LogonUI,
+    * the shell) - 0175 had x86 / x64 / ARM64EC only, so the S10 DWM deadlock left no trace. pc, lr (x30), fp chain
+    * and a stack scan, module+offset only (AGENTS rule 11: nothing of Windows' code is examined beyond names). */
+   DWORD tid = mk_ddi_tid;
+   HANDLE t = tid ? OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid)
+                  : NULL;
+   if (!t) {
+      malikm_tlog("tc: no DDI thread to inspect (tid %lu)", tid);
+      return;
+   }
+   static char line[3000];
+   int o = 0, found = 0;
+   line[0] = 0;
+   if (SuspendThread(t) != (DWORD)-1) {
+      CONTEXT c;
+      memset(&c, 0, sizeof c);
+      c.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+      if (GetThreadContext(t, &c)) {
+         o += snprintf(line + o, sizeof line - o, "pc");
+         mk_log_addr(line, &o, sizeof line, (uintptr_t)c.Pc);
+         o += snprintf(line + o, sizeof line - o, " | lr");
+         mk_log_addr(line, &o, sizeof line, (uintptr_t)c.Lr);
+         o += snprintf(line + o, sizeof line - o, " | stack");
+         const uintptr_t *sp = (const uintptr_t *)(uintptr_t)c.Sp;
+         MEMORY_BASIC_INFORMATION mb;
+         uintptr_t top = (uintptr_t)sp;
+         if (VirtualQuery(sp, &mb, sizeof mb))
+            top = (uintptr_t)mb.BaseAddress + mb.RegionSize;
+         for (const uintptr_t *q = sp; (uintptr_t)(q + 1) <= top && found < 48 && o < (int)sizeof line - 80; q++) {
+            HMODULE m = NULL;
+            if (*q > 0x10000 &&
+                GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   (LPCSTR)*q, &m) && m) {
+               mk_log_addr(line, &o, sizeof line, *q);
+               found++;
+            }
+         }
+      }
+      ResumeThread(t);
+   }
+   CloseHandle(t);
+   malikm_tlog("tc: DDI thread %lu: %s", tid, line);
 #endif
 }
 
@@ -1650,13 +1693,36 @@ mk_call(struct mk_req *r)
    InterlockedExchangePointer((PVOID volatile *)&mk_box, r);
    DWORD t0 = GetTickCount();
    int logged = 0;
+   /* S10 s10-0006: MALIUMD_TC_RESCUE=<seconds> (DIAGNOSIS ONLY, AGENTS rule 12) - after that long the driver thread
+    * takes the request back and runs it itself (a runtime callback off the DDI thread, which MS Learn
+    * pfnSetAsyncCallbacksCb does not allow) and logs whether the DDI thread then comes back: tells "the DDI thread
+    * waits for this very submission" apart from "it is stuck elsewhere". Snapshots every 5 s, up to 6. */
+   static int rescue_s = -1;
+   if (rescue_s < 0) {
+      const char *e = getenv("MALIUMD_TC_RESCUE");
+      rescue_s = e && *e ? atoi(e) : 0;
+   }
    while (!r->done) {
       WaitForSingleObject(mk_done_ev, 500);
-      if (!r->done && !logged && GetTickCount() - t0 > 2000) {
-         malikm_tlog("tc: driver thread waits > 2 s for the DDI thread to run callback op %d (DDI thread last "
-                     "seen %lu ms ago, submit queue %u)", r->op, (unsigned long)(GetTickCount() - mk_ddi_tick), wq_n);
+      DWORD waited = GetTickCount() - t0;
+      if (!r->done && logged < 6 && waited > 2000u + 5000u * (DWORD)logged) {
+         malikm_tlog("tc: driver thread waits %lu ms for the DDI thread to run callback op %d (DDI thread last "
+                     "seen %lu ms ago, submit queue %u)", (unsigned long)waited, r->op,
+                     (unsigned long)(GetTickCount() - mk_ddi_tick), wq_n);
          mk_snapshot_ddi_thread();   /* exynos-woa TC T5 diagnosis */
-         logged = 1;
+         logged++;
+      }
+      if (!r->done && rescue_s > 0 && waited > (DWORD)rescue_s * 1000u &&
+          InterlockedCompareExchangePointer((PVOID volatile *)&mk_box, NULL, r) == r) {
+         /* the DDI thread never took it: run it here, on the driver thread (the wddm_lock is ours) */
+         DWORD seen = mk_ddi_tick;
+         mk_exec(r);
+         InterlockedExchange(&r->done, 1);
+         malikm_tlog("tc: RESCUE ran callback op %d on the driver thread after %lu ms (status 0x%08lx)", r->op,
+                     (unsigned long)waited, (unsigned long)r->st);
+         for (int k = 0; k < 50 && mk_ddi_tick == seen; k++)
+            Sleep(100);
+         malikm_tlog("tc: RESCUE: the DDI thread %s within 5 s", mk_ddi_tick != seen ? "came back" : "did NOT come back");
       }
    }
    ReleaseSRWLockExclusive(&mk_call_lock);
-- 
2.43.0

