#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# exynos-woa V1: stand-in for vtn_bindgen2 - copies the bindings made on Linux from the same SPIR-V.
#   vtn_bindgen2 X.spv OUT.cpp OUT.h
import os, shutil, sys
spv, cpp, h = sys.argv[1:4]
base = os.path.splitext(os.path.basename(spv))[0]
pre = os.environ["LIBPAN_PREBUILT"]
shutil.copyfile(os.path.join(pre, base + ".cpp"), cpp)
shutil.copyfile(os.path.join(pre, base + ".h"), h)
