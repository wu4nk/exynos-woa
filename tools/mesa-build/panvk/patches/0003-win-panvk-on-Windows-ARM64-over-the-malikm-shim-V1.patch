+/* ---- exynos-woa V1 (panvk): device enumeration ----
+ * One platform device, "malikm", when the Mali answers: \\.\MaliG52 opens or the maliwddm adapter is found. */
+static int
+malikm_present(void)
+{
+   HANDLE h = CreateFileW(MALIKM_USER_PATH, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                          OPEN_EXISTING, 0, NULL);
+   if (h != INVALID_HANDLE_VALUE) {
+      CloseHandle(h);
+      return 1;
+   }
+   return wddm_init() == 0;
+}
+
+static drmDevicePtr
+malikm_new_device(void)
+{
+   static char render[] = "malikm", fullname[] = "malikm";
+   static char compat0[] = "arm,mali-bifrost";
+   drmDevicePtr d = calloc(1, sizeof(*d) + DRM_NODE_MAX * sizeof(char *) + sizeof(drmPlatformBusInfo) +
+                                 sizeof(drmPlatformDeviceInfo) + 2 * sizeof(char *));
+   if (!d)
+      return NULL;
+   d->nodes = (char **)(d + 1);
+   d->nodes[DRM_NODE_RENDER] = render;
+   d->available_nodes = 1 << DRM_NODE_RENDER;
+   d->bustype = DRM_BUS_PLATFORM;
+   d->businfo.platform = (drmPlatformBusInfoPtr)(d->nodes + DRM_NODE_MAX);
+   memcpy(d->businfo.platform->fullname, fullname, sizeof(fullname));
+   d->deviceinfo.platform = (drmPlatformDeviceInfoPtr)(d->businfo.platform + 1);
+   d->deviceinfo.platform->compatible = (char **)(d->deviceinfo.platform + 1);
+   d->deviceinfo.platform->compatible[0] = compat0;
+   d->deviceinfo.platform->compatible[1] = NULL;
+   return d;
+}
+
+int
+drmGetDevices2(uint32_t flags, drmDevicePtr devices[], int max_devices)
+{
+   (void)flags;
+   if (!malikm_present())
+      return 0;
+   if (!devices || max_devices < 1)
+      return 1;
+   devices[0] = malikm_new_device();
+   return devices[0] ? 1 : -ENOMEM;
+}
+
+void
+drmFreeDevices(drmDevicePtr devices[], int count)
+{
+   for (int i = 0; i < count; i++)
+      free(devices[i]);
+}
+
+int
+drmGetDevice2(int fd, uint32_t flags, drmDevicePtr *device)
+{
+   (void)fd; (void)flags;
+   *device = malikm_new_device();
+   return *device ? 0 : -ENOMEM;
+}
+
+void
+drmFreeDevice(drmDevicePtr *device)
+{
+   if (device && *device) {
+      free(*device);
+      *device = NULL;
+   }
+}
+
+/* Binary syncobjs only (no timelines, no syncobj fds): what the KMD implements. */
+int
+drmGetCap(int fd, uint64_t capability, uint64_t *value)
+{
+   (void)fd;
+   switch (capability) {
+   case DRM_CAP_SYNCOBJ:
+      *value = 1;
+      return 0;
+   case DRM_CAP_SYNCOBJ_TIMELINE:
+      *value = 0;
+      return 0;
+   default:
+      *value = 0;
+      return 0;
+   }
+}
+
 drmVersionPtr
 drmGetVersion(int fd)
 {
