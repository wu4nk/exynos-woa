diff --git a/src/panfrost/lib/kmod/malikm_atoms.c b/src/panfrost/lib/kmod/malikm_atoms.c
new file mode 100644
index 0000000..3409761
--- /dev/null
+++ b/src/panfrost/lib/kmod/malikm_atoms.c
@@ -0,0 +1,202 @@
+/*
+ * Copyright 2026 exynos-woa contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * exynos-woa V1 (panvk on Windows): the kbase job-atom calls panvk's JM queue makes (kbase_kmod.h), on top of the
+ * Panfrost DRM submit and binary syncobjs that the malikm shim (include/win32-compat/malikm_drm.c) gives through
+ * MaliG76Wddm.
+ *
+ * An atom is a number, starting at 1, given to each submitted job chain. Its fence is the out_sync syncobj of the
+ * PANFROST_SUBMIT that ran it. Syncobjs live in a ring of ATOM_RING slots, one per atom number modulo the ring size;
+ * a slot is reused only after the atom it held has completed (waited for here before reuse), so an atom whose slot
+ * now holds a later number is known to be complete. Dependencies become the submit's in_syncs (the KMD also runs the
+ * jobs of one context in submission order).
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/os_time.h"
+#include "util/simple_mtx.h"
+
+#include "drm-uapi/panfrost_drm.h"
+#include "xf86drm.h"
+
+#include "kbase_kmod.h"
+#include "pan_kmod.h"
+
+#define ATOM_RING 1024
+
+struct atom_slot {
+   uint64_t atom;    /* atom number held, 0 = never used */
+   uint32_t syncobj; /* 0 = not created yet */
+};
+
+static struct atom_slot ring[ATOM_RING];
+static uint64_t next_atom = 1;
+static simple_mtx_t ring_lock = SIMPLE_MTX_INITIALIZER;
+
+static int64_t
+abs_deadline(int64_t timeout_ns)
+{
+   if (timeout_ns < 0)
+      return INT64_MAX;
+   return os_time_get_nano() + timeout_ns;
+}
+
+/* The syncobj of a live atom, 0 when it has completed (or was never submitted). Called with ring_lock held. */
+static uint32_t
+atom_syncobj_locked(uint64_t atom)
+{
+   if (!atom)
+      return 0;
+   const struct atom_slot *s = &ring[atom % ATOM_RING];
+   return s->atom == atom ? s->syncobj : 0;
+}
+
+static uint64_t
+submit(struct pan_kmod_dev *dev, uint64_t jc, uint32_t core_req, struct pan_kmod_bo **bos, uint32_t nbo,
+       uint64_t dep0, uint64_t dep1)
+{
+   uint32_t *handles = nbo ? malloc(nbo * sizeof(uint32_t)) : NULL;
+   if (nbo && !handles)
+      return 0;
+   for (uint32_t i = 0; i < nbo; i++)
+      handles[i] = pan_kmod_bo_handle(bos[i]);
+
+   simple_mtx_lock(&ring_lock);
+   uint64_t atom = next_atom++;
+   struct atom_slot *s = &ring[atom % ATOM_RING];
+
+   /* The slot's previous atom must be complete before its fence is replaced. */
+   if (s->atom && s->syncobj)
+      drmSyncobjWait(dev->fd, &s->syncobj, 1, INT64_MAX, 0, NULL);
+   if (!s->syncobj && drmSyncobjCreate(dev->fd, 0, &s->syncobj)) {
+      simple_mtx_unlock(&ring_lock);
+      free(handles);
+      return 0;
+   }
+
+   uint32_t in[2];
+   unsigned nin = 0;
+   uint32_t d0 = atom_syncobj_locked(dep0), d1 = atom_syncobj_locked(dep1);
+   if (d0)
+      in[nin++] = d0;
+   if (d1 && d1 != d0)
+      in[nin++] = d1;
+
+   struct drm_panfrost_submit sub = {
+      .jc = jc,
+      .in_syncs = (uintptr_t)in,
+      .in_sync_count = nin,
+      .out_sync = s->syncobj,
+      .bo_handles = (uintptr_t)handles,
+      .bo_handle_count = nbo,
+      .requirements = (core_req & BASE_JD_REQ_FS) ? PANFROST_JD_REQ_FS : 0,
+   };
+   int ret = drmIoctl(dev->fd, DRM_IOCTL_PANFROST_SUBMIT, &sub);
+   if (ret) {
+      fprintf(stderr, "panvk/malikm: PANFROST_SUBMIT jc 0x%llx failed (errno %d)\n", (unsigned long long)jc, errno);
+      simple_mtx_unlock(&ring_lock);
+      free(handles);
+      return 0;
+   }
+   s->atom = atom;
+   simple_mtx_unlock(&ring_lock);
+   free(handles);
+   return atom;
+}
+
+uint64_t
+kbase_kmod_job_submit_dep(struct pan_kmod_dev *dev, uint64_t jc, uint32_t core_req, struct pan_kmod_bo **bos,
+                          uint32_t nbo, uint64_t dep0, uint8_t dep0_type, uint64_t dep1, uint8_t dep1_type,
+                          bool no_waiter)
+{
+   (void)dep0_type; (void)dep1_type; (void)no_waiter;
+   return submit(dev, jc, core_req, bos, nbo, dep0, dep1);
+}
+
+uint64_t
+kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc, uint32_t core_req, struct pan_kmod_bo **bos,
+                      uint32_t nbo, struct base_external_resource *ext_res, uint32_t next_res)
+{
+   (void)ext_res; (void)next_res;
+   return submit(dev, jc, core_req, bos, nbo, 0, 0);
+}
+
+bool
+kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom_number, int64_t timeout_ns)
+{
+   simple_mtx_lock(&ring_lock);
+   uint32_t so = atom_syncobj_locked(atom_number);
+   simple_mtx_unlock(&ring_lock);
+   if (!so)
+      return true;
+   /* A slot is only refilled after its atom completed, so waiting on a syncobj whose slot moved on is still right. */
+   return drmSyncobjWait(dev->fd, &so, 1, abs_deadline(timeout_ns), 0, NULL) == 0;
+}
+
+bool
+kbase_kmod_job_submit_retry(struct pan_kmod_dev *dev, uint64_t jc, uint32_t core_req, struct pan_kmod_bo **bos,
+                            uint32_t nbo, struct base_external_resource *ext_res, uint32_t next_res, int max_attempts)
+{
+   (void)ext_res; (void)next_res; (void)max_attempts;
+   uint64_t atom = submit(dev, jc, core_req, bos, nbo, 0, 0);
+   return atom && kbase_kmod_wait_atom(dev, atom, -1);
+}
+
+void
+kbase_kmod_atom_release(struct pan_kmod_dev *dev, uint64_t atom_num)
+{
+   (void)dev; (void)atom_num;
+}
+
+void
+kbase_kmod_jm_clean_imports(struct pan_kmod_dev *dev)
+{
+   (void)dev;
+}
+
+void
+kbase_kmod_jm_busy_track(struct pan_kmod_dev *dev)
+{
+   (void)dev;
+}
+
+uint64_t
+kbase_kmod_jm_busy_ns(struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return 0;
+}
+
+uint32_t
+kbase_kmod_get_flush_id(const struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return 0;
+}
+
+uint64_t
+kbase_kmod_bo_committed_size(struct pan_kmod_dev *dev, struct pan_kmod_bo *bo)
+{
+   (void)dev;
+   return bo->size;
+}
+
+bool
+kbase_kmod_supports_dmabuf(const struct pan_kmod_dev *dev)
+{
+   (void)dev;
+   return false;
+}
+
+int
+kbase_kmod_bo_set_evictable(struct pan_kmod_bo *bo, bool evictable)
+{
+   (void)bo; (void)evictable;
+   return -ENOSYS;
+}
