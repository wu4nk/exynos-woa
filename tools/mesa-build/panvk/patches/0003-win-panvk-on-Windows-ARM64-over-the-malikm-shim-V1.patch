@@ -364,7 +364,9 @@ panvk_jm_kbase_wait_atoms(void *data, const uint64_t targets[PANVK_KBASE_SYNC_TA
     * fixed on v9 first; jm-v7 093 uses CLOCK_MONOTONIC on v6/v7 as well.
     * PANVK_V7_RAW_CLOCK=1 restores MONOTONIC_RAW there (A/B only).
     */
-#if PAN_ARCH == 9
+#if defined(_WIN32)
+   /* exynos-woa: vk_sync deadlines are os_time_get_nano() (QueryPerformanceCounter) here. */
+#elif PAN_ARCH == 9
    const clockid_t clk = CLOCK_MONOTONIC;
 #else
    static int raw_clock = -1;
@@ -381,18 +383,26 @@ panvk_jm_kbase_wait_atoms(void *data, const uint64_t targets[PANVK_KBASE_SYNC_TA
 
       int64_t timeout_ns = -1;
       if (abs_timeout_ns != UINT64_MAX) {
+#ifdef _WIN32
+         int64_t now_ns = os_time_get_nano();
+#else
          struct timespec now;
          clock_gettime(clk, &now);
          int64_t now_ns = (int64_t)now.tv_sec * 1000000000ll + now.tv_nsec;
+#endif
          timeout_ns = MAX2((int64_t)abs_timeout_ns - now_ns, 0);
       }
 
       if (!P4_WAIT(kmod_dev, targets[i], timeout_ns))
          {
          if (abs_timeout_ns != UINT64_MAX) {
+#ifdef _WIN32
+            int64_t now2_ns = os_time_get_nano();
+#else
             struct timespec now2;
             clock_gettime(clk, &now2);
             int64_t now2_ns = (int64_t)now2.tv_sec * 1000000000ll + now2.tv_nsec;
+#endif
             if (now2_ns >= (int64_t)abs_timeout_ns)
                return VK_TIMEOUT;
          }
