+/* Packs struct bifrost_header in GCC's packed, LSB-first bitfield layout, which is the
+ * hardware encoding. MSVC lays mixed-type bitfields out differently, so the
+ * encoding must not depend on the struct's in-memory layout. */
+static inline uint64_t
+bifrost_header_pack(const struct bifrost_header *f)
+{
+   uint64_t v = 0;
+   v |= ((uint64_t)f->zero1 & 0x1full) << 0;
+   v |= ((uint64_t)f->flush_to_zero & 0x3ull) << 5;
+   v |= ((uint64_t)f->suppress_inf & 0x1ull) << 7;
+   v |= ((uint64_t)f->suppress_nan & 0x1ull) << 8;
+   v |= ((uint64_t)f->float_exceptions & 0x3ull) << 9;
+   v |= ((uint64_t)f->flow_control & 0x7ull) << 11;
