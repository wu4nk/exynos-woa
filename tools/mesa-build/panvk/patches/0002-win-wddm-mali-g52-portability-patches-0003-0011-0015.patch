+/* Packs struct bifrost_fmt_constant (128 bits: pos 4, tag 4, imm_1 60,
+ * imm_2 60) in GCC's packed bitfield layout; imm_1 straddles bit 64. */
+static inline void
+bifrost_fmt_constant_pack(const struct bifrost_fmt_constant *f, uint64_t out[2])
+{
+   uint64_t imm_1 = f->imm_1 & ((1ull << 60) - 1);
+   uint64_t imm_2 = f->imm_2 & ((1ull << 60) - 1);
+
+   out[0] = (f->pos & 0xfull) | ((f->tag & 0xfull) << 4) | (imm_1 << 8);
+   out[1] = (imm_1 >> 56) | (imm_2 << 4);
+}
 
