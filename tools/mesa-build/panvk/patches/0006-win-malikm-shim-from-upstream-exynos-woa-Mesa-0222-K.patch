+/* exynos-woa H4 (notes/gpu-hw-path.md): a timing log of the slow events only (GPU idle waits, present copies, the
+ * runtime's present callback), per process, when MALIKM_TGSI_DIR is set (it is machine-wide on the S10e, so DWM
+ * writes one too): <dir>\malikm-<exe>-<pid>.txt, lines "<GetTickCount ms> <event>". Unbuffered. */
+static FILE *
+tlog_file(void)
+{
+   static int init;
+   static FILE *f;
+   if (!init) {
+      const char *d = getenv("MALIKM_TGSI_DIR");
+      init = 1;
+      if (d && *d) {
+         char exe[MAX_PATH] = "x", p[MAX_PATH];
+         GetModuleFileNameA(NULL, exe, MAX_PATH);
+         const char *b = strrchr(exe, '\\');
+         b = b ? b + 1 : exe;
+         snprintf(p, sizeof(p), "%s\\malikm-%s-%lu.txt", d, b, (unsigned long)GetCurrentProcessId());
+         f = fopen(p, "a");
+         if (f)
+            setvbuf(f, NULL, _IONBF, 0);
+      }
+   }
+   return f;
+}
+
+void
+malikm_tlog(const char *fmt, ...)
+{
+   FILE *f = tlog_file();
+   if (!f)
+      return;
+   char line[1800];   /* exynos-woa: the "app umd top" report lines were cut at 255 chars */
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(line, sizeof(line), fmt, ap);
+   va_end(ap);
+   fprintf(f, "%lu %s\n", (unsigned long)GetTickCount(), line);
+}
+
+/* exynos-woa H5 (notes/gpu-hw-path.md): crash evidence from processes nobody watches. LogonUI dies in abort()
+ * (0xC0000409 in ucrtbase, every run since h3g) - a Mesa assert whose text went to a stderr that does not exist; the
+ * d3dtri tex test dies with 0xC0000005 at its draw and leaves no WER event. With MALIKM_TGSI_DIR set: a process
+ * without a stderr gets one in the tlog directory (malikm-<exe>-<pid>-stderr.txt), and the first 4 access
+ * violations (first chance - also ones that are handled) go to the tlog with module + offset, for the PDB. */
+static LONG CALLBACK
+malikm_veh(EXCEPTION_POINTERS *e)
+{
+   static volatile LONG n;
+   if (e->ExceptionRecord->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && InterlockedIncrement(&n) <= 4) {
+      void *pc = e->ExceptionRecord->ExceptionAddress;
+      HMODULE m = NULL;
+      char name[MAX_PATH] = "?";
+      GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         (LPCSTR)pc, &m);
+      if (m)
+         GetModuleFileNameA(m, name, MAX_PATH);
+      const char *b = strrchr(name, '\\');
+      malikm_tlog("ACCESS VIOLATION (first chance) at %s+0x%llx, %s address 0x%llx, thread %lu", b ? b + 1 : name,
+                  (unsigned long long)((uintptr_t)pc - (uintptr_t)m),
+                  e->ExceptionRecord->ExceptionInformation[0] ? "write" : "read",
+                  (unsigned long long)e->ExceptionRecord->ExceptionInformation[1], GetCurrentThreadId());
+#if defined(_M_IX86) || defined(_M_ARM64) || defined(_M_AMD64) || defined(_M_ARM64EC)
+      /* exynos-woa TC T5 diagnosis: x86 Mesa has no frame pointers - scan the stack for values inside the faulting
+       * module (return-address candidates, newest first) for llvm-symbolizer */
+      if (m) {
+         const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)m;
+         const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)((const char *)m + dos->e_lfanew);
+         const uintptr_t lo = (uintptr_t)m, hi = lo + nt->OptionalHeader.SizeOfImage;
+#if defined(_M_IX86)
+         const uintptr_t *sp = (const uintptr_t *)(uintptr_t)e->ContextRecord->Esp;
+#elif defined(_M_ARM64)
+         const uintptr_t *sp = (const uintptr_t *)(uintptr_t)e->ContextRecord->Sp;   /* T1d: ARM64 too */
+#else
+         const uintptr_t *sp = (const uintptr_t *)(uintptr_t)e->ContextRecord->Rsp;  /* x64 / ARM64EC context */
+#endif
+         MEMORY_BASIC_INFORMATION mb;
+         uintptr_t top = (uintptr_t)sp;
+         if (VirtualQuery(sp, &mb, sizeof mb))
+            top = (uintptr_t)mb.BaseAddress + mb.RegionSize;
+         char line[600];
+         int o = 0, found = 0;
+         line[0] = 0;
+         for (const uintptr_t *q = sp; (uintptr_t)(q + 1) <= top && found < 40 && o < (int)sizeof line - 16; q++) {
+            if (*q > lo && *q < hi) {
+               o += snprintf(line + o, sizeof line - o, " %llx", (unsigned long long)(*q - lo));
+               found++;
+            }
+         }
+         malikm_tlog("  stack scan:%s", line);
+      }
+#endif
+   }
+   return EXCEPTION_CONTINUE_SEARCH;
+}
+
+static void *malikm_veh_handle;
+
+static void
+malikm_veh_remove(void)
+{
+   if (malikm_veh_handle)
+      RemoveVectoredExceptionHandler(malikm_veh_handle);
+   malikm_veh_handle = NULL;
+}
+
+void
+malikm_diag_init(void)
+{
+   static int done;
+   const char *d = getenv("MALIKM_TGSI_DIR");
+   if (done)
+      return;
+   done = 1;
+   /* exynos-woa 0079: a GUI or sandboxed process (Edge's GPU process) has no usable stderr (CRT fd -2 / no handle);
+    * the first fprintf(stderr) of this DLL or of Mesa then hits the CRT invalid-parameter handler and the process
+    * fail-fasts (0xC0000409 in ucrtbase!_write_internal <- malikm wddm_drm fprintf, Edge GPU process, 0078 run).
+    * Without a log directory such a stderr goes to NUL. */
+   HANDLE h = GetStdHandle(STD_ERROR_HANDLE);
+   intptr_t oh = _fileno(stderr) >= 0 ? _get_osfhandle(_fileno(stderr)) : (intptr_t)INVALID_HANDLE_VALUE;
+   bool no_stderr = h == NULL || h == INVALID_HANDLE_VALUE || oh == (intptr_t)INVALID_HANDLE_VALUE ||
+                    GetFileType((HANDLE)oh) == FILE_TYPE_UNKNOWN;
+   if (no_stderr) {
+      /* 0082: the tlog file only if it can really be opened - a failed freopen closes stderr, and AppContainer
+       * processes (StartMenuExperienceHost, SearchHost, ShellExperienceHost: 0xC0000409 in ucrtbase!_write_internal
+       * <- maliumd d3d10_create_screen fwrite, 0081c dumps) cannot write C:\S10eTmp\tlog. Otherwise NUL. */
+      bool done_file = false;
+      if (d && *d) {
+         char exe[MAX_PATH] = "x", p[MAX_PATH];
+         GetModuleFileNameA(NULL, exe, MAX_PATH);
+         const char *b = strrchr(exe, '\\');
+         b = b ? b + 1 : exe;
+         snprintf(p, sizeof(p), "%s\\malikm-%s-%lu-stderr.txt", d, b, (unsigned long)GetCurrentProcessId());
+         FILE *t = fopen(p, "a");
+         if (t) {
+            fclose(t);
+            if (freopen(p, "a", stderr)) {
+               setvbuf(stderr, NULL, _IONBF, 0);
+               done_file = true;
+            }
+         }
+      }
+      if (!done_file) {
+         /* 0082b: the process's own temp directory (GetTempPath is the AppContainer's AC\Temp in a sandboxed
+          * package process - writable there) keeps the diagnostics; NUL only if even that fails */
+         char tp[MAX_PATH], exe[MAX_PATH] = "x", p[MAX_PATH];
+         DWORD n = GetTempPathA(MAX_PATH, tp);
+         GetModuleFileNameA(NULL, exe, MAX_PATH);
+         const char *b = strrchr(exe, '\\');
+         b = b ? b + 1 : exe;
+         FILE *t = NULL;
+         if (n && n < MAX_PATH) {
+            snprintf(p, sizeof(p), "%smalikm-%s-%lu-stderr.txt", tp, b, (unsigned long)GetCurrentProcessId());
+            t = fopen(p, "a");
+         }
+         if (t) {
+            fclose(t);
+            if (freopen(p, "a", stderr))
+               setvbuf(stderr, NULL, _IONBF, 0);
+            else
+               freopen("NUL", "w", stderr);
+         } else {
+            freopen("NUL", "w", stderr);
+         }
+      }
+   }
+   if (!d || !*d)
+      return;
+   /* exynos-woa H5 (0058): only in the test (d3dtri), and removed when this DLL unloads. Run h3q: LogonUI unloads
+    * the UMD; the handler 0057 left registered then ran in unloaded memory on the next exception (an ordinary
+    * RPC cancel), faulted, recursed and overflowed the stack - 0057 itself crashed LogonUI. */
+   char exe[MAX_PATH] = "x";
+   GetModuleFileNameA(NULL, exe, MAX_PATH);
+   const char *b = strrchr(exe, '\\');
+   b = b ? b + 1 : exe;
+   if (_strnicmp(b, "d3dtri", 6) == 0) {
+      malikm_veh_handle = AddVectoredExceptionHandler(1, malikm_veh);
+      atexit(malikm_veh_remove);   /* a DLL's atexit runs at its unload (DLL_PROCESS_DETACH) */
+   }
+}
