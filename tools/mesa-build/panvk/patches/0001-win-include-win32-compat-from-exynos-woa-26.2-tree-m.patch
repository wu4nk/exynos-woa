diff --git a/include/win32-compat/libgen.h b/include/win32-compat/libgen.h
new file mode 100644
index 0000000..2f154f8
--- /dev/null
+++ b/include/win32-compat/libgen.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#pragma once
+#include <string.h>
+/* POSIX basename(): may modify path; returns the last component. */
+static inline char *basename(char *path)
+{
+   char *p = path, *last = path;
+   if (!path || !*path)
+      return (char *)".";
+   for (; *p; p++)
+      if ((*p == '/' || *p == '\\') && p[1])
+         last = p + 1;
+   size_t n = strlen(last);
+   while (n > 1 && (last[n - 1] == '/' || last[n - 1] == '\\'))
+      last[--n] = '\0';
+   return last;
+}
diff --git a/include/win32-compat/malikm_drm.c b/include/win32-compat/malikm_drm.c
new file mode 100644
index 0000000..e61df3b
--- /dev/null
+++ b/include/win32-compat/malikm_drm.c
@@ -0,0 +1,3342 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * libdrm and mmap for Panfrost on Windows: each call becomes a DeviceIoControl
+ * on \\.\MaliG52 (drivers/malikm), whose ABI is include/malikm_ioctl.h.
+ *
+ * The fd Panfrost holds is a CRT fd wrapping the device handle
+ * (_open_osfhandle in d3d10_gdi.c), so _get_osfhandle gets it back.
+ *
+ * What does not carry over from Linux:
+ *  - Pointers to user arrays inside DRM structs are sent inline instead.
+ *  - Absolute CLOCK_MONOTONIC deadlines become relative, measured on the
+ *    clock Mesa took them from (os_time_get_nano).
+ *  - A sync file is a sequence number kept here against a placeholder fd.
+ */
+#include <windows.h>
+#include <winternl.h>
+#include <d3dkmthk.h>
+#include <d3d9types.h>   /* d3dumddi.h uses the D3D9 types */
+#include <d3dumddi.h>
+#include <dxgiddi.h>
+#include <io.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/os_time.h"
+#include "drm-uapi/drm.h"
+#include "drm-uapi/panfrost_drm.h"
+#include "malikm_ioctl.h"
+#include "maliwddm_abi.h"
+#include "xf86drm.h"
+#include "sys/mman.h"
+
+/* The maliwddm backend, below. */
+static int wddm_on(void);
+static int wddm_init(void);
+static void wddm_ioctl(int fd, DWORD code, void *buf, DWORD len);
+static void wtls_bind_fd(int fd);   /* below (0053) */
+
+/* Linux errno, as the driver reports it, to the CRT's. Most agree. */
+static int
+crt_errno(int e)
+{
+   switch (e) {
+   case MK_ETIMEDOUT: return ETIMEDOUT;
+   case MK_ETIME:     return ETIME;
+   case MK_ENOSYS:    return ENOSYS;
+   default:           return e;
+   }
+}
+
+/* The device handle behind Mesa's fd. The UCRT will not wrap a handle whose
+ * GetFileType is FILE_TYPE_UNKNOWN, which a KMDF device without a device type
+ * is, so malikm_open() hands Mesa a placeholder fd (NUL) and keeps the real
+ * handle here. Mesa _dup()s the fd it is given; a duplicate is not in the
+ * table, and falls back to the handle this process opened. */
+#define MAX_DEV_FDS 64
+static struct { int fd; HANDLE h; } dev_fds[MAX_DEV_FDS];
+static HANDLE dev_handle = INVALID_HANDLE_VALUE;
+static SRWLOCK dev_lock = SRWLOCK_INIT;
+
+static int trace_on(void);
+
+/* G2b-3 (0048): a CRT descriptor that only stands for something (the device, a syncobj file, an imported
+ * allocation). Run g2b3-8: SearchHost and StartMenuExperienceHost (AppContainers) logged "Panfrost found no Mali
+ * device, using softpipe" although their device was bound to the Mali - malikm_open's only failure left is this
+ * _open("NUL") (SUSPECTED: NUL not openable from an AppContainer; the log line below confirms or refutes it). So fall
+ * back to the read end of an anonymous pipe, which any process may create. -1 if neither works. */
+static int
+token_fd(void)
+{
+   int fd = _open("NUL", _O_RDWR | _O_NOINHERIT);
+   if (fd >= 0)
+      return fd;
+   HANDLE r = NULL, w = NULL;
+   static int said;
+   if (!said++)
+      fprintf(stderr, "malikm: pid %lu: _open(NUL) failed (errno %d) - a pipe stands for the device instead\n",
+              GetCurrentProcessId(), errno);
+   if (!CreatePipe(&r, &w, NULL, 0))
+      return -1;
+   CloseHandle(w);
+   fd = _open_osfhandle((intptr_t)r, _O_RDONLY);
+   if (fd < 0)
+      CloseHandle(r);
+   return fd;
+}
+
+int
+malikm_open(void)
+{
+   HANDLE h = CreateFileW(MALIKM_USER_PATH, GENERIC_READ | GENERIC_WRITE,
+                          FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+   if (h == INVALID_HANDLE_VALUE) {
+      DWORD err = GetLastError();
+      /* No malikm: the Mali may be driven by maliwddm, the WDDM driver,
+       * reached through the D3DKMT system calls instead. */
+      if (wddm_init() == 0) {
+         if (trace_on())
+            fprintf(stderr, "malikm: no \\\\.\\MaliG52; using the maliwddm adapter\n");
+         int tfd = token_fd();
+         wtls_bind_fd(tfd);   /* 0053: this screen belongs to the device bound just before on this thread */
+         return tfd;
+      }
+      fprintf(stderr, "malikm: cannot open \\\\.\\MaliG52 (error %lu), and no maliwddm adapter\n",
+              (unsigned long)err);
+      errno = err == ERROR_FILE_NOT_FOUND ? ENOENT : ENODEV;
+      return -1;
+   }
+   int fd = token_fd();
+   if (fd < 0) {
+      CloseHandle(h);
+      return -1;
+   }
+   AcquireSRWLockExclusive(&dev_lock);
+   for (int i = 0; i < MAX_DEV_FDS; i++) {
+      if (dev_fds[i].h == NULL) {
+         dev_fds[i].fd = fd;
+         dev_fds[i].h = h;
+         break;
+      }
+   }
+   if (dev_handle == INVALID_HANDLE_VALUE)
+      dev_handle = h;
+   ReleaseSRWLockExclusive(&dev_lock);
+   if (trace_on())
+      fprintf(stderr, "malikm: opened \\\\.\\MaliG52 as fd %d\n", fd);
+   return fd;
+}
+
+static HANDLE
+fd_handle(int fd)
+{
+   HANDLE h = INVALID_HANDLE_VALUE;
+   AcquireSRWLockShared(&dev_lock);
+   for (int i = 0; i < MAX_DEV_FDS && h == INVALID_HANDLE_VALUE; i++)
+      if (dev_fds[i].h != NULL && dev_fds[i].fd == fd)
+         h = dev_fds[i].h;
+   if (h == INVALID_HANDLE_VALUE)
+      h = dev_handle;
+   ReleaseSRWLockShared(&dev_lock);
+   return h;
+}
+
+/* Send Buf (a MALIKM_DRM_HEADER and what follows) and return the driver's
+ * result, 0 or -1 with errno set. */
+static int fake_on(void);
+static void fake_ioctl(DWORD code, void *buf, DWORD len);
+
+/* MALIKM_TRACE=1: log every call to the real driver, with the DRM number,
+ * the driver's result and any Win32 error. */
+static int
+trace_on(void)
+{
+   static int t = -1;
+   if (t < 0) {
+      const char *e = getenv("MALIKM_TRACE");
+      t = e && *e && *e != '0';
+   }
+   return t;
+}
+
+static int
+call(int fd, DWORD code, void *buf, DWORD len)
+{
+   HANDLE h = fd_handle(fd);
+   DWORD got = 0;
+
+   if (fake_on() || wddm_on()) {
+      if (fake_on())
+         fake_ioctl(code, buf, len);
+      else
+         wddm_ioctl(fd, code, buf, len);
+      int r = ((MALIKM_DRM_HEADER *)buf)->Result;
+      if (r < 0) {
+         errno = crt_errno(-r);
+         return -1;
+      }
+      return 0;
+   }
+   if (h == INVALID_HANDLE_VALUE) {
+      if (trace_on())
+         fprintf(stderr, "malikm: fd %d has no handle\n", fd);
+      errno = EBADF;
+      return -1;
+   }
+   if (!DeviceIoControl(h, code, buf, len, buf, len, &got, NULL)) {
+      DWORD err = GetLastError();
+      if (trace_on())
+         fprintf(stderr, "malikm: ioctl 0x%lx nr 0x%x len %lu: DeviceIoControl failed, error %lu\n",
+                 (unsigned long)code, ((MALIKM_DRM_HEADER *)buf)->Nr, (unsigned long)len,
+                 (unsigned long)err);
+      errno = err == ERROR_INVALID_FUNCTION ? ENOTTY : EIO;
+      return -1;
+   }
+   int r = ((MALIKM_DRM_HEADER *)buf)->Result;
+   if (trace_on())
+      fprintf(stderr, "malikm: ioctl 0x%lx nr 0x%x len %lu -> %d (got %lu)\n", (unsigned long)code,
+              ((MALIKM_DRM_HEADER *)buf)->Nr, (unsigned long)len, r, (unsigned long)got);
+   if (r < 0) {
+      errno = crt_errno(-r);
+      return -1;
+   }
+   return 0;
+}
+
+static int64_t
+relative_timeout(int64_t abs_ns)
+{
+   if (abs_ns == INT64_MAX)
+      return MALIKM_TIMEOUT_INFINITE;
+   int64_t now = os_time_get_nano();
+   return abs_ns > now ? abs_ns - now : 0;
+}
+
+int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+   unsigned nr = request & 0xff;
+   unsigned size = (request >> 16) & 0x1fff;
+   size_t extra = 0;
+
+   switch (nr) {
+   case MALIKM_NR_PANFROST_SUBMIT: {
+      const struct drm_panfrost_submit *s = arg;
+      extra = ((size_t)s->in_sync_count + s->bo_handle_count) * 4;
+      break;
+   }
+   case MALIKM_NR_SYNCOBJ_WAIT:
+      extra = (size_t)((const struct drm_syncobj_wait *)arg)->count_handles * 4;
+      break;
+   case MALIKM_NR_SYNCOBJ_RESET:
+   case MALIKM_NR_SYNCOBJ_SIGNAL:
+      extra = (size_t)((const struct drm_syncobj_array *)arg)->count_handles * 4;
+      break;
+   }
+
+   size_t len = sizeof(MALIKM_DRM_HEADER) + size + extra;
+   uint8_t *buf = calloc(1, len);
+   if (!buf) {
+      errno = ENOMEM;
+      return -1;
+   }
+   MALIKM_DRM_HEADER *hdr = (MALIKM_DRM_HEADER *)buf;
+   uint8_t *body = buf + sizeof(*hdr);
+   hdr->Nr = nr;
+   hdr->Size = size;
+   memcpy(body, arg, size);
+
+   /* Inline the arrays; their "pointers" become offsets from body. */
+   switch (nr) {
+   case MALIKM_NR_PANFROST_SUBMIT: {
+      const struct drm_panfrost_submit *s = arg;
+      struct drm_panfrost_submit *d = (void *)body;
+      size_t in = (size_t)s->in_sync_count * 4;
+      d->in_syncs = size;
+      d->bo_handles = size + in;
+      if (in)
+         memcpy(body + size, (void *)(uintptr_t)s->in_syncs, in);
+      if (s->bo_handle_count)
+         memcpy(body + size + in, (void *)(uintptr_t)s->bo_handles, (size_t)s->bo_handle_count * 4);
+      break;
+   }
+   case MALIKM_NR_PANFROST_WAIT_BO: {
+      struct drm_panfrost_wait_bo *d = (void *)body;
+      d->timeout_ns = relative_timeout(d->timeout_ns);
+      break;
+   }
+   case MALIKM_NR_SYNCOBJ_WAIT: {
+      const struct drm_syncobj_wait *s = arg;
+      struct drm_syncobj_wait *d = (void *)body;
+      d->handles = size;
+      d->timeout_nsec = relative_timeout(s->timeout_nsec);
+      memcpy(body + size, (void *)(uintptr_t)s->handles, extra);
+      break;
+   }
+   case MALIKM_NR_SYNCOBJ_RESET:
+   case MALIKM_NR_SYNCOBJ_SIGNAL: {
+      const struct drm_syncobj_array *s = arg;
+      ((struct drm_syncobj_array *)body)->handles = size;
+      memcpy(body + size, (void *)(uintptr_t)s->handles, extra);
+      break;
+   }
+   }
+
+   int ret = call(fd, IOCTL_MALIKM_DRM, buf, (DWORD)len);
+   if (ret == 0 && (request & IOC_OUT)) {
+      /* Copy the results back, keeping the caller's own pointer and
+       * timeout fields as they were. */
+      switch (nr) {
+      case MALIKM_NR_PANFROST_SUBMIT:
+      case MALIKM_NR_PANFROST_WAIT_BO:
+         break;   /* nothing comes back */
+      case MALIKM_NR_SYNCOBJ_WAIT:
+         ((struct drm_syncobj_wait *)arg)->first_signaled =
+            ((struct drm_syncobj_wait *)body)->first_signaled;
+         break;
+      case MALIKM_NR_SYNCOBJ_RESET:
+      case MALIKM_NR_SYNCOBJ_SIGNAL:
+         break;
+      default:
+         memcpy(arg, body, size);
+         break;
+      }
+   }
+   free(buf);
+   return ret;
+}
+
+drmVersionPtr
+drmGetVersion(int fd)
+{
+   MALIKM_VERSION v = {0};
+   HANDLE h = fd_handle(fd);
+   DWORD got = 0;
+
+   if (fake_on())
+      fake_ioctl(IOCTL_MALIKM_VERSION, &v, sizeof(v));
+   else if (wddm_on())
+      wddm_ioctl(fd, IOCTL_MALIKM_VERSION, &v, sizeof(v));
+   else if (h == INVALID_HANDLE_VALUE ||
+            !DeviceIoControl(h, IOCTL_MALIKM_VERSION, &v, sizeof(v), &v, sizeof(v), &got, NULL) ||
+            got < sizeof(v)) {
+      if (trace_on())
+         fprintf(stderr, "malikm: VERSION failed (fd %d, error %lu)\n", fd, (unsigned long)GetLastError());
+      errno = ENODEV;
+      return NULL;
+   }
+   if (trace_on())
+      fprintf(stderr, "malikm: VERSION %.16s %d.%d\n", v.Name, v.Major, v.Minor);
+   drmVersionPtr r = calloc(1, sizeof(*r));
+   if (!r)
+      return NULL;
+   v.Name[sizeof(v.Name) - 1] = 0;
+   r->version_major = v.Major;
+   r->version_minor = v.Minor;
+   r->version_patchlevel = v.Patch;
+   r->name = _strdup(v.Name);
+   r->name_len = (int)strlen(v.Name);
+   r->date = _strdup("");
+   r->desc = _strdup("wddm-mali-g52 malikm");
+   r->desc_len = (int)strlen(r->desc ? r->desc : "");
+   return r;
+}
+
+void
+drmFreeVersion(drmVersionPtr v)
+{
+   if (!v)
+      return;
+   free(v->name);
+   free(v->date);
+   free(v->desc);
+   free(v);
+}
+
+int
+drmCloseBufferHandle(int fd, uint32_t handle)
+{
+   struct drm_gem_close c = {.handle = handle};
+   return drmIoctl(fd, DRM_IOCTL_GEM_CLOSE, &c);
+}
+
+int
+drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *prime_fd)
+{
+   (void)fd; (void)handle; (void)flags; (void)prime_fd;
+   errno = ENOSYS;
+   return -ENOSYS;
+}
+
+static int wddm_prime_to_handle(int fd, int prime_fd, uint32_t *handle);
+
+int
+drmPrimeFDToHandle(int fd, int prime_fd, uint32_t *handle)
+{
+   /* G2b-3 (0046): an opened allocation (malikm_import_alloc) */
+   int r = wddm_prime_to_handle(fd, prime_fd, handle);
+   if (r < 0) {
+      errno = crt_errno(-r);
+      return -1;
+   }
+   return 0;
+}
+
+/* ---- syncobjs: return conventions as libdrm's ---- */
+
+int
+drmSyncobjCreate(int fd, uint32_t flags, uint32_t *handle)
+{
+   struct drm_syncobj_create c = {.flags = flags};
+   int ret = drmIoctl(fd, DRM_IOCTL_SYNCOBJ_CREATE, &c);
+   if (ret)
+      return ret;
+   *handle = c.handle;
+   return 0;
+}
+
+int
+drmSyncobjDestroy(int fd, uint32_t handle)
+{
+   struct drm_syncobj_destroy d = {.handle = handle};
+   return drmIoctl(fd, DRM_IOCTL_SYNCOBJ_DESTROY, &d);
+}
+
+int
+drmSyncobjWait(int fd, uint32_t *handles, unsigned num_handles,
+               int64_t timeout_nsec, unsigned flags, uint32_t *first_signaled)
+{
+   struct drm_syncobj_wait w = {
+      .handles = (uintptr_t)handles,
+      .timeout_nsec = timeout_nsec,
+      .count_handles = num_handles,
+      .flags = flags,
+   };
+   if (drmIoctl(fd, DRM_IOCTL_SYNCOBJ_WAIT, &w) < 0)
+      return -errno;
+   if (first_signaled)
+      *first_signaled = w.first_signaled;
+   return 0;
+}
+
+int
+drmSyncobjReset(int fd, const uint32_t *handles, uint32_t handle_count)
+{
+   struct drm_syncobj_array a = {.handles = (uintptr_t)handles, .count_handles = handle_count};
+   return drmIoctl(fd, DRM_IOCTL_SYNCOBJ_RESET, &a);
+}
+
+int
+drmSyncobjSignal(int fd, const uint32_t *handles, uint32_t handle_count)
+{
+   struct drm_syncobj_array a = {.handles = (uintptr_t)handles, .count_handles = handle_count};
+   return drmIoctl(fd, DRM_IOCTL_SYNCOBJ_SIGNAL, &a);
+}
+
+int
+drmSyncobjHandleToFD(int fd, uint32_t handle, int *obj_fd)
+{
+   (void)fd; (void)handle; (void)obj_fd;
+   errno = ENOSYS;
+   return -1;
+}
+
+int
+drmSyncobjFDToHandle(int fd, int obj_fd, uint32_t *handle)
+{
+   (void)fd; (void)obj_fd; (void)handle;
+   errno = ENOSYS;
+   return -1;
+}
+
+int
+drmSyncobjTimelineWait(int fd, uint32_t *handles, uint64_t *points, unsigned num_handles,
+                       int64_t timeout_nsec, unsigned flags, uint32_t *first_signaled)
+{
+   (void)fd; (void)handles; (void)points; (void)num_handles;
+   (void)timeout_nsec; (void)flags; (void)first_signaled;
+   errno = ENOSYS;
+   return -ENOSYS;
+}
+
+int
+drmSyncobjTransfer(int fd, uint32_t dst_handle, uint64_t dst_point,
+                   uint32_t src_handle, uint64_t src_point, uint32_t flags)
+{
+   (void)fd; (void)dst_handle; (void)dst_point; (void)src_handle; (void)src_point; (void)flags;
+   errno = ENOSYS;
+   return -1;
+}
+
+/* ---- sync files ----
+ * Panfrost snapshots a syncobj's fence by exporting it to a sync file and
+ * importing that into a new syncobj. Here the snapshot is the fence's
+ * sequence number, filed under a placeholder fd that close() can take. An fd
+ * this table does not know (a dup, say) imports as "everything so far". */
+
+#define SYNC_FDS 4096
+static uint64_t sync_seq[SYNC_FDS];        /* seq + 1; 0 = unknown */
+static SRWLOCK sync_lock = SRWLOCK_INIT;
+
+int
+drmSyncobjExportSyncFile(int fd, uint32_t handle, int *sync_file_fd)
+{
+   struct {
+      MALIKM_DRM_HEADER h;
+      MALIKM_SYNCOBJ_SEQ s;
+   } m = {{MALIKM_NR_SYNCOBJ_EXPORT_SEQ, sizeof(MALIKM_SYNCOBJ_SEQ)}, {handle}};
+
+   if (call(fd, IOCTL_MALIKM_DRM, &m, sizeof(m)))
+      return -1;
+   int sfd = token_fd();
+   if (sfd < 0)
+      return -1;
+   AcquireSRWLockExclusive(&sync_lock);
+   if (sfd < SYNC_FDS)
+      sync_seq[sfd] = m.s.Seq + 1;
+   ReleaseSRWLockExclusive(&sync_lock);
+   *sync_file_fd = sfd;
+   return 0;
+}
+
+int
+drmSyncobjImportSyncFile(int fd, uint32_t handle, int sync_file_fd)
+{
+   struct {
+      MALIKM_DRM_HEADER h;
+      MALIKM_SYNCOBJ_SEQ s;
+   } m = {{MALIKM_NR_SYNCOBJ_IMPORT_SEQ, sizeof(MALIKM_SYNCOBJ_SEQ)}, {handle, 0, MALIKM_SEQ_LATEST}};
+
+   AcquireSRWLockShared(&sync_lock);
+   if (sync_file_fd >= 0 && sync_file_fd < SYNC_FDS && sync_seq[sync_file_fd] != 0)
+      m.s.Seq = sync_seq[sync_file_fd] - 1;
+   ReleaseSRWLockShared(&sync_lock);
+   return call(fd, IOCTL_MALIKM_DRM, &m, sizeof(m));
+}
+
+/* ---- mmap ----
+ * munmap has no fd, so remember which device each mapping came from. */
+
+struct mapping {
+   void *addr;
+   int fd;
+};
+static struct mapping *maps;
+static size_t nmaps, capmaps;
+static SRWLOCK map_lock = SRWLOCK_INIT;
+
+void *
+mmap(void *addr, size_t len, int prot, int flags, int fd, off_t off)
+{
+   struct {
+      MALIKM_DRM_HEADER h;
+      MALIKM_MAP m;
+   } m = {{0}, {(uint64_t)(uint32_t)off, len, 0}};
+   (void)addr; (void)prot; (void)flags;
+
+   if (call(fd, IOCTL_MALIKM_MAP, &m, sizeof(m))) {
+      if (trace_on())
+         fprintf(stderr, "malikm: mmap fd %d offset 0x%llx len %zu failed\n", fd,
+                 (unsigned long long)(uint32_t)off, len);
+      return MAP_FAILED;
+   }
+   void *va = (void *)(uintptr_t)m.m.Address;
+
+   AcquireSRWLockExclusive(&map_lock);
+   if (nmaps == capmaps) {
+      size_t cap = capmaps ? capmaps * 2 : 256;
+      struct mapping *n = realloc(maps, cap * sizeof(*n));
+      if (n) {
+         maps = n;
+         capmaps = cap;
+      }
+   }
+   if (nmaps < capmaps)
+      maps[nmaps++] = (struct mapping){va, fd};
+   ReleaseSRWLockExclusive(&map_lock);
+   return va;
+}
+
+int
+munmap(void *addr, size_t len)
+{
+   int fd = -1;
+   (void)len;
+
+   AcquireSRWLockExclusive(&map_lock);
+   for (size_t i = 0; i < nmaps; i++) {
+      if (maps[i].addr == addr) {
+         fd = maps[i].fd;
+         maps[i] = maps[--nmaps];
+         break;
+      }
+   }
+   ReleaseSRWLockExclusive(&map_lock);
+   if (fd < 0) {
+      errno = EINVAL;
+      return -1;
+   }
+
+   struct {
+      MALIKM_DRM_HEADER h;
+      MALIKM_UNMAP u;
+   } m = {{0}, {(uint64_t)(uintptr_t)addr}};
+   return call(fd, IOCTL_MALIKM_UNMAP, &m, sizeof(m));
+}
+
+
+/* ---- maliwddm ----
+ * The Panfrost uAPI over the WDDM driver (drivers/maliwddm), through the
+ * D3DKMT system calls in win32u (WinPE's gdi32 forwards its D3DKMT exports
+ * to dxcore, which WinPE lacks). One D3DKMT device and context per process.
+ *
+ *   CREATE_BO      CreateAllocation (MW_ALLOCATION_INFO); its fixed GPU
+ *                  address from MW_ESCAPE_ALLOC_INFO
+ *   mmap           a Lock held until GEM_CLOSE
+ *   SUBMIT         one MW_CMD_JOB through Render, the BOs as the allocation
+ *                  list (the KMD patches each, which makes VidMm map them)
+ *   WAIT_BO, syncobj waits
+ *                  the sequence number of the submission they wait for,
+ *                  done when its CPU event is set (the KMD runs one queue
+ *                  in order); D3DKMT tools: WaitForIdle (0057)
+ *   GET_PARAM      MW_ESCAPE_GPU_INFO
+ */
+
+typedef NTSTATUS (APIENTRY *KMT_FN)(void *);
+static struct {
+   KMT_FN CreateDevice, DestroyDevice, CreateContext, CreateAllocation, DestroyAllocation,
+          Lock, Unlock, Render, Escape, EnumAdapters2, WaitForIdle;
+} kmt;
+
+struct wbo_s {
+   D3DKMT_HANDLE h;
+   uint64_t size, va;
+   void *cpu;
+   uint64_t listed;     /* submit that last put it in the allocation list */
+   /* G2b-3 (0046): WBO_OPENED - another process's allocation this one opened (drmPrimeFDToHandle on a
+    * malikm_import_alloc fd): never locked, never destroyed here. WBO_RUNTIME - the allocation of a MISC_SHARED
+    * resource, created with the runtime resource handle (malikm_shared_bo_begin): the runtime frees it with the
+    * resource, so GEM_CLOSE only unlocks it. */
+   int foreign;
+   /* G2b-3 (0057): the newest submission that NAMED it (Panfrost's bo_handles, not the residency extras):
+    * WAIT_BO waits for that one only, as Linux's implicit fences do. */
+   uint64_t busy;
+   /* 0063: seen = has been in an allocation list (VidMm has paged it in, maliwddm mapped it for the GPU);
+    * pinned = created before its context's first submission (the screen's own BOs, which no batch names). */
+   uint8_t seen, pinned;
+};
+#define WBO_OPENED  1
+#define WBO_RUNTIME 2
+static D3DKMT_HANDLE wadapter, wdevice, wcontext;
+static MW_ESCAPE_GPU_INFO_DATA wgpu;
+static int wddm = -1;
+static SRWLOCK wddm_lock = SRWLOCK_INIT;
+
+/* Inside a hardware UMD (maliumd.dll, d3d10umd), the runtime's device and
+ * its kernel callbacks replace the D3DKMT calls: the buffers then are the
+ * runtime device's allocations, which Present needs. malikm_bind_d3dddi()
+ * switches over before the device's screen is created. */
+struct wddi {
+   int on;
+   HANDLE adapter, device, context;
+   D3DDDI_DEVICECALLBACKS cb;
+   const DXGI_DDI_BASE_CALLBACKS *dxgi;
+   /* The surface DXGI presents from: X8R8G8B8, linear, its size told to the
+    * KMD at creation, kept locked. */
+   D3DKMT_HANDLE present;
+   void *present_cpu;
+   unsigned present_w, present_h;
+   /* G13 (exynos-woa): flips go to primaries only (DxgKrnl "Source of Flip must be primary", run g21full): two
+    * primary present surfaces (VidPN source 0, the S10e's only one), used in turn so a flip never names the
+    * surface that is being scanned out. */
+   D3DKMT_HANDLE prim[2];
+   void *prim_cpu[2];
+   unsigned prim_w, prim_h, prim_next;
+};
+
+/* Allocations whose BO is closed but which a job submitted earlier may
+ * still use. Linux's panfrost keeps a BO alive until its jobs are done,
+ * and Mesa's BO cache relies on that: it closes buffers without waiting.
+ * Destroying the allocation at GEM_CLOSE let VidMm unmap pages under a
+ * running job (PE runs 18 on: two job faults per present.exe, a read
+ * translation fault, 0x4002c3, every time at the same VA). They are
+ * destroyed once the newest submission at their close is done (0057; until then: after the next wait for idle). */
+struct wdead_s { D3DKMT_HANDLE h; uint64_t seq; };
+#define WDEAD_MAX 2048   /* this many still waiting: drain the queue */
+
+/* G2b-3 (0057): SUBMISSIONS IN FLIGHT. Until 0056 every WAIT_BO and syncobj wait drained this context's whole
+ * queue, whatever its timeout: Panfrost's polls (timeout 0 - the BO cache looking for an idle buffer, a
+ * WRITE_DISCARD map asking "busy?") became full GPU round trips, and wddm_lock was held through them, so every
+ * other thread and device of the process stopped too. Run g2b3-19: DWM composed the desktop and lagged badly.
+ * Now each submission has a sequence number and the CPU event the scheduler sets when the context reaches it;
+ * the queue is in order, so the newest signalled event retires everything up to it. */
+#define WPEND 64
+struct wpend { uint64_t seq; HANDLE ev; };   /* ev NULL: none could be enqueued; the KMD's fences tell */
+
+/* G2b-3 (0053): ONE CONTEXT PER RUNTIME DEVICE. Until 0052 a process had one shim state (and, since
+ * os_same_file_description cannot compare Windows descriptors, one Panfrost screen) for all its D3D devices; 0045
+ * then routed every device's kernel work through the first device. Allocations tied to a runtime resource (shared
+ * swap-chain buffers, composition surfaces, primaries) were thus created through a device that does not own the
+ * resource: run g2b3-15, Windows Terminal's composition swap chain (its second device) was still refused with
+ * D3DDDIERR_INVALIDHANDLE when presented as its own allocation, and the XAML hosts - which also run two devices -
+ * kept dying with E_INVALIDARG. Now every device gets its own screen (os_file.c compares handles, 0053) and its
+ * own wctx: callbacks, context, command/allocation lists, BO table. A descriptor finds its wctx by the kernel
+ * object behind it (dup'ed descriptors from Panfrost match too); the frontend's calls by malikm_use_device(). */
+#define MAX_KPRIM 16
+struct wkprim { D3DKMT_HANDLE h; void *cpu; unsigned w, hgt; };
+struct wctx {
+   int used;
+   HANDLE fdh;                       /* OS handle behind the descriptor malikm_open gave this device's screen */
+   struct wddi d;
+   struct wbo_s *bo;
+   uint32_t bo_cap;
+   void *cmd;
+   UINT cmd_size;
+   D3DDDI_ALLOCATIONLIST *alist;
+   UINT alist_size;
+   D3DDDI_PATCHLOCATIONLIST *plist;
+   UINT plist_size;
+   uint64_t seq;                     /* the newest submission's sequence number */
+   uint64_t done;                    /* 0057: every submission up to this one has completed */
+   struct wpend pend[WPEND];         /* 0057: the ones not known complete, oldest first */
+   uint32_t pend_head, pend_n;
+   uint64_t *sobj;                   /* 0057: syncobj h -> (seq of its fence) + 1 at [h - 1]; 0 = free */
+   uint32_t sobj_cap;
+   struct wdead_s *dead;
+   uint32_t dead_n, dead_cap;
+   struct wkprim kp[MAX_KPRIM];
+};
+#define MAX_WCTX 16
+static struct wctx wctxs[MAX_WCTX];   /* [0] also serves the D3DKMT path (tools without a runtime device) */
+static struct wctx *wcur = &wctxs[0];
+#define ddi         (wcur->d)
+#define wbo         (wcur->bo)
+#define wbo_cap     (wcur->bo_cap)
+#define wcmd        (wcur->cmd)
+#define wcmd_size   (wcur->cmd_size)
+#define walloc      (wcur->alist)
+#define walloc_size (wcur->alist_size)
+#define wpatch      (wcur->plist)
+#define wpatch_size (wcur->plist_size)
+#define wseq        (wcur->seq)
+#define wdone       (wcur->done)
+#define wdead       (wcur->dead)
+#define wdead_n     (wcur->dead_n)
+#define wdead_cap   (wcur->dead_cap)
+#define kprim       (wcur->kp)
+
+static __declspec(thread) struct wctx *wtls_bound;   /* the wctx malikm_bind_d3dddi made last on this thread */
+static __declspec(thread) HANDLE wtls_dev;          /* malikm_use_device() */
+
+/* Same kernel object? (CompareObjectHandles, Windows 10 1607+; looked up at run time) */
+static int
+same_object(HANDLE a, HANDLE b)
+{
+   static BOOL (WINAPI *cmp)(HANDLE, HANDLE);
+   static int looked;
+   if (a == b)
+      return 1;
+   if (!looked) {
+      HMODULE k = GetModuleHandleW(L"kernelbase.dll");
+      if (!k)
+         k = GetModuleHandleW(L"kernel32.dll");
+      cmp = k ? (BOOL (WINAPI *)(HANDLE, HANDLE))(void *)GetProcAddress(k, "CompareObjectHandles") : NULL;
+      looked = 1;
+   }
+   return cmp && a && b && a != INVALID_HANDLE_VALUE && b != INVALID_HANDLE_VALUE && cmp(a, b);
+}
+
+/* The wctx of a descriptor (the screen's fd or Panfrost's dup of it); wctxs[0] if none matches. wddm_lock held. */
+static struct { int fd; HANDLE h; struct wctx *c; } fdcache[32];   /* entries of a freed wctx are cleared */
+#define cache fdcache
+static struct wctx *
+fd_ctx(int fd)
+{
+   HANDLE h = (HANDLE)_get_osfhandle(fd);
+   if (h == INVALID_HANDLE_VALUE)
+      return &wctxs[0];
+   for (int i = 0; i < 32; i++)
+      if (cache[i].c && cache[i].fd == fd && cache[i].h == h && cache[i].c->used)
+         return cache[i].c;
+   struct wctx *only = NULL;
+   unsigned used = 0;
+   for (int i = 0; i < MAX_WCTX; i++) {
+      if (wctxs[i].used) {
+         used++;
+         only = &wctxs[i];
+      }
+      if (wctxs[i].used && wctxs[i].fdh && same_object(h, wctxs[i].fdh)) {
+         static unsigned next;
+         unsigned k = next++ % 32;
+         cache[k].fd = fd;
+         cache[k].h = h;
+         cache[k].c = &wctxs[i];
+         return &wctxs[i];
+      }
+   }
+   if (used == 1)
+      return only;
+   if (used > 1) {
+      static unsigned warned;
+      if (warned++ < 4)
+         fprintf(stderr, "malikm-wddm: pid %lu: fd %d matches none of %u device contexts - using the first\n",
+                 GetCurrentProcessId(), fd, used);
+   }
+   return &wctxs[0];
+}
+
+/* The wctx of a runtime device (malikm_use_device), else the first one in use, else wctxs[0]. wddm_lock held. */
+static struct wctx *
+dev_ctx(HANDLE dev)
+{
+   struct wctx *first = NULL;
+   for (int i = 0; i < MAX_WCTX; i++) {
+      if (!wctxs[i].used)
+         continue;
+      if (dev && wctxs[i].d.device == dev)
+         return &wctxs[i];
+      if (!first)
+         first = &wctxs[i];
+   }
+   return first ? first : &wctxs[0];
+}
+
+static void
+wtls_bind_fd(int fd)
+{
+   AcquireSRWLockExclusive(&wddm_lock);
+   /* a duplicate of the handle: d3d10_create_screen closes its descriptor once Panfrost has dup'ed it, and the
+    * kernel object must stay comparable for the screen's lifetime */
+   HANDLE h = fd >= 0 ? (HANDLE)_get_osfhandle(fd) : INVALID_HANDLE_VALUE, keep = NULL;
+   if (h != INVALID_HANDLE_VALUE && wtls_bound && wtls_bound->used && !wtls_bound->fdh &&
+       DuplicateHandle(GetCurrentProcess(), h, GetCurrentProcess(), &keep, 0, FALSE, DUPLICATE_SAME_ACCESS))
+      wtls_bound->fdh = keep;
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+/* The frontend names the runtime device its next shim calls are for (CreateResource, OpenResource,
+ * DestroyResource, Present, SetDisplayMode). */
+void
+malikm_use_device(void *hRTDevice)
+{
+   wtls_dev = hRTDevice;
+}
+
+static KMT_FN
+kmt_resolve(const char *name)
+{
+   char nt[96];
+   HMODULE w = LoadLibraryA("win32u.dll"), g = LoadLibraryA("gdi32.dll");
+   FARPROC f = NULL;
+
+   snprintf(nt, sizeof(nt), "NtGdiDdDDI%s", name);
+   if (w)
+      f = GetProcAddress(w, nt);
+   if (!f && g) {
+      snprintf(nt, sizeof(nt), "D3DKMT%s", name);
+      f = GetProcAddress(g, nt);
+   }
+   return (KMT_FN)(void *)f;
+}
+
+static NTSTATUS
+kmt_escape(D3DKMT_HANDLE device, void *data, UINT size)
+{
+   D3DKMT_ESCAPE e = {0};
+   e.hAdapter = wadapter;
+   e.hDevice = device;
+   e.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+   e.pPrivateDriverData = data;
+   e.PrivateDriverDataSize = size;
+   return kmt.Escape(&e);
+}
+
+static int
+wddm_on(void)
+{
+   return wddm > 0;
+}
+
+/* Find the adapter that answers MW_ESCAPE_GPU_INFO, open a device and a
+ * context on it. 0 on success. */
+static int
+wddm_init(void)
+{
+   if (wddm >= 0)
+      return wddm > 0 ? 0 : -1;
+   wddm = 0;
+   const char *off = getenv("MALIKM_WDDM");
+   if (off && *off == '0')
+      return -1;
+
+#define R(n) kmt.n = kmt_resolve(#n)
+   R(CreateDevice); R(DestroyDevice); R(CreateContext); R(CreateAllocation); R(DestroyAllocation);
+   R(Lock); R(Unlock); R(Render); R(Escape); R(EnumAdapters2); R(WaitForIdle);
+#undef R
+   if (!kmt.CreateDevice || !kmt.CreateContext || !kmt.CreateAllocation || !kmt.DestroyAllocation ||
+       !kmt.Lock || !kmt.Unlock || !kmt.Render || !kmt.Escape || !kmt.EnumAdapters2 || !kmt.WaitForIdle)
+      return -1;
+
+   D3DKMT_ADAPTERINFO info[16];
+   D3DKMT_ENUMADAPTERS2 en = {0};
+   en.NumAdapters = 16;
+   en.pAdapters = info;
+   if (kmt.EnumAdapters2(&en) < 0)
+      return -1;
+   for (ULONG i = 0; i < en.NumAdapters && !wadapter; i++) {
+      MW_ESCAPE_GPU_INFO_DATA g = {0};
+      g.Code = MW_ESCAPE_GPU_INFO;
+      wadapter = info[i].hAdapter;
+      if (kmt_escape(0, &g, sizeof(g)) >= 0 && g.Count != 0 && g.Valid != 0)
+         wgpu = g;
+      else
+         wadapter = 0;
+   }
+   if (!wadapter)
+      return -1;
+
+   D3DKMT_CREATEDEVICE dev = {0};
+   dev.hAdapter = wadapter;
+   if (kmt.CreateDevice(&dev) < 0)
+      return -1;
+   wdevice = dev.hDevice;
+   D3DKMT_CREATECONTEXT ctx = {0};
+   ctx.hDevice = wdevice;
+   ctx.NodeOrdinal = 0;
+   ctx.EngineAffinity = 1;
+   ctx.ClientHint = D3DKMT_CLIENTHINT_DX10;
+   if (kmt.CreateContext(&ctx) < 0)
+      return -1;
+   wcontext = ctx.hContext;
+   wcmd = ctx.pCommandBuffer;
+   wcmd_size = ctx.CommandBufferSize;
+   walloc = ctx.pAllocationList;
+   walloc_size = ctx.AllocationListSize;
+   wpatch = ctx.pPatchLocationList;
+   wpatch_size = ctx.PatchLocationListSize;
+   wddm = 1;
+   if (trace_on())
+      fprintf(stderr, "malikm-wddm: adapter 0x%x device 0x%x context 0x%x, %u allocation slots\n",
+              wadapter, wdevice, wcontext, walloc_size);
+   return 0;
+}
+
+/* ---- G2b-3 (0063): where a frame's WALL time goes ----
+ * Run g2b3-24 (0062): 7-8 presents/s whatever the job count (1068-2478 submits per 10 s), DWM at ~30 % of a core:
+ * something costs ~90 ms per present and the 0057 line does not see it. Added to that line: time inside each kind
+ * of runtime callback (they can block in VidMm), time spent waiting for wddm_lock, Panfrost's flush reasons; a
+ * second line with the call chains that create big BOs (one 17.5 MB BO is created and destroyed per present); and
+ * the profiler thread times one present packet at a time through the scheduler (the KMD's CPU blt). */
+enum { WCB_ESCAPE, WCB_ALLOC, WCB_FREE, WCB_LOCK, WCB_UNLOCK, WCB_N };
+static int64_t wcb_t[WCB_N], wlockwait_t;
+static uint32_t wcb_n[WCB_N];
+
+static int64_t
+cb_now(void)
+{
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   return t.QuadPart;
+}
+
+/* maliumd.dll's own address range */
+static uintptr_t wimg_lo, wimg_hi;
+
+static void
+wimg_init(void)
+{
+   HMODULE me = NULL;
+   if (wimg_lo)
+      return;
+   GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                      (LPCWSTR)(void *)wimg_init, &me);
+   if (!me)
+      return;
+   const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)me;
+   const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)((const uint8_t *)me + dos->e_lfanew);
+   wimg_hi = (uintptr_t)me + nt->OptionalHeader.SizeOfImage;
+   wimg_lo = (uintptr_t)me;
+}
+
+/* Who creates the big BOs: the frames inside maliumd.dll of each creation of 4 MB or more (image offsets of the
+ * return addresses, innermost first), added up per chain. wddm_lock held. */
+#define WBIG_MIN (4u << 20)
+#define WBIG_FR 24
+static struct { uint64_t key; uint32_t n, len; uint64_t bytes; uint32_t fr[WBIG_FR]; } wbig[32];
+
+static void
+wbig_note(uint64_t size)
+{
+   uint32_t chain[WBIG_FR], m = 0;
+   uint64_t key = 1469598103934665603ull;
+   wimg_init();
+   /* 0065: walk with the unwind data. RtlCaptureStackBackTrace found no frame of ours (run g2b3-25: every chain
+    * empty) - it follows frame pointers and the image is built without them. This is the calling thread's own
+    * live stack, so the plain walk is safe. */
+   CONTEXT c;
+   RtlCaptureContext(&c);
+   for (int depth = 0; depth < 96 && m < WBIG_FR; depth++) {
+      DWORD64 base = 0, est = 0, pc = c.Pc;
+      void *hd = NULL;
+      if (!pc)
+         break;
+      if (depth && pc >= wimg_lo && pc < wimg_hi) {
+         chain[m] = (uint32_t)(pc - wimg_lo);
+         key = (key ^ chain[m]) * 1099511628211ull;
+         m++;
+      }
+      DWORD64 look = depth ? pc - 4 : pc;
+      PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(look, &base, NULL);
+      if (!fe) {
+         if (depth || !c.Lr || c.Lr == pc)
+            break;
+         c.Pc = c.Lr;
+      } else {
+         DWORD64 sp = c.Sp;
+         RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, look, fe, &c, &hd, &est, NULL);
+         if (c.Sp <= sp && depth)
+            break;   /* no progress: stop rather than loop */
+      }
+   }
+   key |= 1;
+   for (int i = 0; i < 32; i++) {
+      if (!wbig[i].key) {
+         wbig[i].key = key;
+         wbig[i].len = m;
+         memcpy(wbig[i].fr, chain, m * sizeof(chain[0]));
+      }
+      if (wbig[i].key == key) {
+         wbig[i].n++;
+         wbig[i].bytes += size;
+         return;
+      }
+   }
+}
+
+/* Panfrost's reasons for submitting a batch (pan_job.c), counted per reason string. Any thread, no lock. */
+static struct { const char *volatile reason; volatile LONG n; } wflush[24];
+
+void
+malikm_flush_note(const char *reason)
+{
+   static const char other[] = "(no reason given)";
+   if (!reason)
+      reason = other;
+   for (int i = 0; i < 24; i++) {
+      const char *r = wflush[i].reason;
+      if (!r)
+         r = InterlockedCompareExchangePointer((void *volatile *)&wflush[i].reason, (void *)reason, NULL);
+      if (!r || r == reason) {
+         InterlockedIncrement(&wflush[i].n);
+         return;
+      }
+   }
+}
+
+/* One present packet at a time, timed by the profiler thread: a = the last render submission before it (NULL:
+ * none in flight), b = an event queued right behind the present. */
+static struct {
+   volatile LONG state;   /* 0 free, 1 armed (the profiler thread's), 2 being armed */
+   HANDLE a, b;
+   int64_t t_call;        /* QPC just before pfnPresentCb */
+} wpres;
+static int wprof_on = -1;
+
+/* ---- the kernel calls, by D3DKMT or by the runtime's callbacks ---- */
+
+static NTSTATUS
+w_escape(void *data, UINT size)
+{
+   if (ddi.on) {
+      D3DDDICB_ESCAPE e = {0};
+      e.hDevice = ddi.device;
+      e.pPrivateDriverData = data;
+      e.PrivateDriverDataSize = size;
+      int64_t t0 = cb_now();
+      HRESULT hr = ddi.cb.pfnEscapeCb(ddi.adapter, &e);
+      wcb_t[WCB_ESCAPE] += cb_now() - t0;
+      wcb_n[WCB_ESCAPE]++;
+      return hr >= 0 ? 0 : (NTSTATUS)0xC0000001;
+   }
+   return kmt_escape(wdevice, data, size);
+}
+
+static NTSTATUS
+w_create(D3DDDI_ALLOCATIONINFO *ai)
+{
+   if (ddi.on) {
+      D3DDDICB_ALLOCATE a = {0};
+      a.NumAllocations = 1;
+      a.pAllocationInfo = ai;
+      int64_t t0 = cb_now();
+      HRESULT hr = ddi.cb.pfnAllocateCb(ddi.device, &a);
+      wcb_t[WCB_ALLOC] += cb_now() - t0;
+      wcb_n[WCB_ALLOC]++;
+      return hr >= 0 ? 0 : (NTSTATUS)0xC0000017;
+   }
+   D3DKMT_CREATEALLOCATION ca = {0};
+   ca.hDevice = wdevice;
+   ca.NumAllocations = 1;
+   ca.pAllocationInfo = ai;
+   return kmt.CreateAllocation(&ca);
+}
+
+static void
+w_destroy(D3DKMT_HANDLE h)
+{
+   if (ddi.on) {
+      D3DDDICB_DEALLOCATE d = {0};
+      d.NumAllocations = 1;
+      d.HandleList = &h;
+      int64_t t0 = cb_now();
+      ddi.cb.pfnDeallocateCb(ddi.device, &d);
+      wcb_t[WCB_FREE] += cb_now() - t0;
+      wcb_n[WCB_FREE]++;
+      return;
+   }
+   D3DKMT_DESTROYALLOCATION da = {0};
+   da.hDevice = wdevice;
+   da.phAllocationList = &h;
+   da.AllocationCount = 1;
+   kmt.DestroyAllocation(&da);
+}
+
+static void *
+w_lock(D3DKMT_HANDLE h)
+{
+   if (ddi.on) {
+      D3DDDICB_LOCK l = {0};
+      l.hAllocation = h;
+      l.Flags.IgnoreSync = 1;
+      int64_t t0 = cb_now();
+      HRESULT hr = ddi.cb.pfnLockCb(ddi.device, &l);
+      wcb_t[WCB_LOCK] += cb_now() - t0;
+      wcb_n[WCB_LOCK]++;
+      return hr >= 0 ? l.pData : NULL;
+   }
+   D3DKMT_LOCK l = {0};
+   l.hDevice = wdevice;
+   l.hAllocation = h;
+   l.Flags.IgnoreSync = 1;
+   return kmt.Lock(&l) >= 0 ? l.pData : NULL;
+}
+
+static void
+w_unlock(D3DKMT_HANDLE h)
+{
+   if (ddi.on) {
+      D3DDDICB_UNLOCK u = {0};
+      u.NumAllocations = 1;
+      u.phAllocations = &h;
+      int64_t t0 = cb_now();
+      ddi.cb.pfnUnlockCb(ddi.device, &u);
+      wcb_t[WCB_UNLOCK] += cb_now() - t0;
+      wcb_n[WCB_UNLOCK]++;
+      return;
+   }
+   D3DKMT_UNLOCK u = {0};
+   u.hDevice = wdevice;
+   u.NumAllocations = 1;
+   u.phAllocations = &h;
+   kmt.Unlock(&u);
+}
+
+/* ---- G2b-3 (0057): where the time goes ----
+ * Run g2b3-19 lagged badly and nothing said where. One line per process for every 10 s it used the GPU, always
+ * (stderr is the UMD log): presents, submissions and their allocation lists, time inside the runtime's Render and
+ * Present callbacks, blocking waits and polls, BO churn, the process's CPU time, and the KMD's own counters over the
+ * same 10 s (adapter-wide: every process's jobs). wddm_lock held for all of it. */
+static struct {
+   int64_t t0;                         /* QPC at the start of the interval; 0 = not started */
+   uint32_t submits, named, listed, render_fails;
+   int64_t render_t;                   /* in pfnRenderCb and the completion event's enqueue */
+   uint32_t polls, polls_busy;         /* timeout-0 waits, and those that found the GPU still busy */
+   uint32_t waits, waits_late, drains; /* blocking waits, those that timed out, waits for everything */
+   int64_t wait_t;
+   uint32_t bo_new, bo_close;
+   uint64_t bo_new_bytes;
+   uint32_t presents, present_fails;
+   int64_t present_t;                  /* in pfnPresentCb */
+   uint64_t cpu_user, cpu_kernel;      /* 100 ns units, at t0 */
+   MW_ESCAPE_STATS_DATA k;             /* the KMD's counters at t0 */
+   int k_ok;
+} wperf;
+
+/* G2b-3 (0058): Panfrost's own CPU work, added up where it happens (pan_shader.c, pan_resource.c) and taken by
+ * perf_tick: [0] shader variants compiled, [1] their ns, [2] bytes tiled/untiled on the CPU (texture uploads and
+ * read-backs through pan_store/load_tiled_image), [3] their ns. Atomics: any thread, no lock. */
+int64_t s10_perf_mesa[4];
+
+static int64_t
+perf_now(void)
+{
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   return t.QuadPart;
+}
+
+static double
+perf_ms(int64_t ticks)
+{
+   static LARGE_INTEGER f;
+   if (!f.QuadPart)
+      QueryPerformanceFrequency(&f);
+   return f.QuadPart ? (double)ticks * 1000.0 / (double)f.QuadPart : 0.0;
+}
+
+/* Everything the KMD was given has completed (every process's): its fences agree and nothing is queued or
+ * running. 1 yes, 0 no, -1 the escape failed. For submissions without an event. */
+static int
+w_kmd_idle(void)
+{
+   MW_ESCAPE_STATS_DATA st = {0};
+   st.Code = MW_ESCAPE_STATS;
+   if (w_escape(&st, sizeof(st)) < 0)
+      return -1;
+   return st.LastCompletedFence == st.LastSubmittedFence && !st.Queued && !st.Running;
+}
+
+/* The oldest submission in flight is done (or given up on): retire it. */
+static void
+pend_pop(void)
+{
+   struct wpend *p = &wcur->pend[wcur->pend_head];
+   if (p->ev)
+      CloseHandle(p->ev);
+   if (p->seq > wdone)
+      wdone = p->seq;
+   p->ev = NULL;
+   wcur->pend_head = (wcur->pend_head + 1) % WPEND;
+   wcur->pend_n--;
+}
+
+/* File the newest submission (wseq) with its event. A full ring waits for its oldest entry first. */
+static void
+pend_push(HANDLE ev)
+{
+   if (wcur->pend_n == WPEND) {
+      struct wpend *p = &wcur->pend[wcur->pend_head];
+      int64_t t0 = perf_now();
+      if (p->ev) {
+         WaitForSingleObject(p->ev, 10000);
+      } else {
+         for (int ms = 0; ms < 10000 && w_kmd_idle() == 0; ms++)
+            Sleep(1);
+      }
+      wperf.waits++;
+      wperf.wait_t += perf_now() - t0;
+      pend_pop();
+   }
+   struct wpend *n = &wcur->pend[(wcur->pend_head + wcur->pend_n) % WPEND];
+   n->seq = wseq;
+   n->ev = ev;
+   wcur->pend_n++;
+}
+
+/* Render what is in the command buffer and allocation list; on return the
+ * buffers are the new ones the runtime handed back. A submission that went
+ * through is wseq from here on. */
+static NTSTATUS
+w_render(UINT commandLength, UINT allocations)
+{
+   if (ddi.on) {
+      D3DDDICB_RENDER r = {0};
+      int64_t t0 = perf_now();
+      r.hContext = ddi.context;
+      r.CommandLength = commandLength;
+      r.NumAllocations = allocations;
+      if (ddi.cb.pfnRenderCb(ddi.device, &r) < 0) {
+         wperf.render_t += perf_now() - t0;
+         return (NTSTATUS)0xC0000001;
+      }
+      wcmd = r.pNewCommandBuffer;
+      wcmd_size = r.NewCommandBufferSize;
+      walloc = r.pNewAllocationList;
+      walloc_size = r.NewAllocationListSize;
+      wpatch = r.pNewPatchLocationList;
+      wpatch_size = r.NewPatchLocationListSize;
+      wseq++;
+
+      /* A CPU event the scheduler sets when the context gets here. */
+      HANDLE ev = CreateEventW(NULL, TRUE, FALSE, NULL);
+      if (ev) {
+         D3DDDICB_SIGNALSYNCHRONIZATIONOBJECT2 sig = {0};
+         sig.hContext = ddi.context;
+         sig.Flags.EnqueueCpuEvent = 1;
+         sig.CpuEventHandle = ev;
+         if (ddi.cb.pfnSignalSynchronizationObject2Cb(ddi.device, &sig) >= 0) {
+            pend_push(ev);
+            wperf.render_t += perf_now() - t0;
+            return 0;
+         }
+         CloseHandle(ev);
+      }
+      static unsigned no_event;
+      if (no_event++ < 3 || trace_on())
+         fprintf(stderr, "malikm-wddm: pid %lu: no completion event for submission %llu;"
+                 " its waits poll the KMD until it catches up\n", GetCurrentProcessId(), (unsigned long long)wseq);
+      pend_push(NULL);
+      wperf.render_t += perf_now() - t0;
+      return 0;
+   }
+   D3DKMT_RENDER r = {0};
+   r.hContext = wcontext;
+   r.CommandLength = commandLength;
+   r.AllocationCount = allocations;
+   NTSTATUS st = kmt.Render(&r);
+   if (st < 0)
+      return st;
+   wcmd = r.pNewCommandBuffer;
+   wcmd_size = r.NewCommandBufferSize;
+   walloc = r.pNewAllocationList;
+   walloc_size = r.NewAllocationListSize;
+   wpatch = r.pNewPatchLocationList;
+   wpatch_size = r.NewPatchLocationListSize;
+   wseq++;
+   return 0;
+}
+
+/* Destroy the closed allocations no submission in flight can use any more. */
+static void
+wdead_flush(void)
+{
+   uint32_t kept = 0, gone = 0;
+   for (uint32_t i = 0; i < wdead_n; i++) {
+      if (wdead[i].seq <= wdone) {
+         w_destroy(wdead[i].h);
+         gone++;
+      } else {
+         wdead[kept++] = wdead[i];
+      }
+   }
+   wdead_n = kept;
+   if (gone && trace_on())
+      fprintf(stderr, "malikm-wddm: destroyed %u closed allocations, %u wait for their jobs\n", gone, kept);
+}
+
+/* Retire, without waiting, the submissions that are done. */
+static void
+w_retire(void)
+{
+   uint64_t was = wdone;
+   if (wcur->pend_n > 1) {
+      /* the newest done means all are (one queue, in order) */
+      struct wpend *t = &wcur->pend[(wcur->pend_head + wcur->pend_n - 1) % WPEND];
+      if (t->ev && WaitForSingleObject(t->ev, 0) == WAIT_OBJECT_0) {
+         while (wcur->pend_n)
+            pend_pop();
+      }
+   }
+   while (wcur->pend_n) {
+      struct wpend *p = &wcur->pend[wcur->pend_head];
+      if (p->ev) {
+         if (WaitForSingleObject(p->ev, 0) != WAIT_OBJECT_0)
+            break;
+         pend_pop();
+      } else {
+         if (w_kmd_idle() != 1)
+            break;
+         while (wcur->pend_n)
+            pend_pop();
+         wdone = wseq;
+      }
+   }
+   if (wdone != was && wdead_n)
+      wdead_flush();
+}
+
+/* Submission seq is done, waiting at most timeout_ns (relative; MALIKM_TIMEOUT_INFINITE waits up to 10 s, then
+ * -ETIMEDOUT as before). Timeout 0 is a poll: -EBUSY at once if it is not done, as Linux's WAIT_BO answers.
+ * unlock: let go of wddm_lock while blocked, so the process's other threads and devices go on (only for callers
+ * that keep no pointer into the shim's tables across the call). */
+static int
+w_wait_seq(uint64_t seq, int64_t timeout_ns, int unlock)
+{
+   if (seq > wseq)
+      seq = wseq;
+   if (!ddi.on) {
+      /* D3DKMT (tools): no events; the device's WaitForIdle covers everything */
+      if (seq <= wdone)
+         return 0;
+      if (timeout_ns == 0) {
+         wperf.polls++;
+         if (w_kmd_idle() == 1) {
+            wdone = wseq;
+            wdead_flush();
+            return 0;
+         }
+         wperf.polls_busy++;
+         return -MK_EBUSY;
+      }
+      D3DKMT_WAITFORIDLE w = {0};
+      w.hDevice = wdevice;
+      int64_t t0 = perf_now();
+      int ok = kmt.WaitForIdle(&w) >= 0;
+      wperf.waits++;
+      wperf.wait_t += perf_now() - t0;
+      if (!ok)
+         return -MK_EIO;
+      wdone = wseq;
+      wdead_flush();
+      return 0;
+   }
+   if (timeout_ns == 0)
+      wperf.polls++;
+   if (seq <= wdone)
+      return 0;
+   w_retire();
+   if (seq <= wdone)
+      return 0;
+   if (timeout_ns == 0) {
+      wperf.polls_busy++;
+      return -MK_EBUSY;
+   }
+   DWORD ms = 10000;
+   if (timeout_ns < MALIKM_TIMEOUT_INFINITE && timeout_ns / 1000000 < 10000)
+      ms = (DWORD)((timeout_ns + 999999) / 1000000);
+   struct wpend *p = NULL;
+   for (uint32_t k = 0; k < wcur->pend_n; k++) {
+      struct wpend *q = &wcur->pend[(wcur->pend_head + k) % WPEND];
+      if (q->seq >= seq) {
+         p = q;
+         break;
+      }
+   }
+   int64_t t0 = perf_now();
+   wperf.waits++;
+   if (p && p->ev) {
+      struct wctx *me = wcur;
+      HANDLE dup = NULL;
+      if (unlock && DuplicateHandle(GetCurrentProcess(), p->ev, GetCurrentProcess(), &dup, SYNCHRONIZE, FALSE, 0)) {
+         ReleaseSRWLockExclusive(&wddm_lock);
+         WaitForSingleObject(dup, ms);
+         AcquireSRWLockExclusive(&wddm_lock);
+         CloseHandle(dup);
+         wcur = me;
+      } else {
+         WaitForSingleObject(p->ev, ms);
+      }
+   } else {
+      /* no event to wait on: the KMD's fences, every ms */
+      for (DWORD i = 0; i < ms; i++) {
+         int r = w_kmd_idle();
+         if (r < 0)
+            break;
+         if (r == 1) {
+            while (wcur->pend_n)
+               pend_pop();
+            wdone = wseq;
+            break;
+         }
+         Sleep(1);
+      }
+   }
+   wperf.wait_t += perf_now() - t0;
+   w_retire();
+   if (seq <= wdone)
+      return 0;
+   wperf.waits_late++;
+   return -MK_ETIMEDOUT;
+}
+
+/* A job that failed since the last report (KMD-wide), with the BO trace above it that says which buffer its fault
+ * address belongs to. exynos-woa G2b-3 0044: always (not only with MALIKM_TRACE) - DWM's black screen on the S10
+ * had one faulted job (fault 0x223002c2 @0x10) and nothing else to go on. */
+static void
+report_failed(const MW_ESCAPE_STATS_DATA *st)
+{
+   static uint32_t failed_seen;
+   if (st->JobsFailed != failed_seen) {
+      fprintf(stderr, "malikm-wddm: pid %lu: %u job(s) failed by now: js 0x%x fault 0x%x @0x%llx (jobs done %u)\n",
+              GetCurrentProcessId(), st->JobsFailed, st->LastJsStatus, st->LastFaultStatus,
+              (unsigned long long)st->LastFaultAddress, st->JobsDone);
+      failed_seen = st->JobsFailed;
+   }
+}
+
+/* Everything submitted so far is done (one in-order queue in the KMD). */
+static int
+wddm_idle(void)
+{
+   wperf.drains++;
+   int ret = w_wait_seq(wseq, MALIKM_TIMEOUT_INFINITE, 0);
+   if (ret == 0) {
+      wdead_flush();
+      MW_ESCAPE_STATS_DATA st = {0};
+      st.Code = MW_ESCAPE_STATS;
+      if (w_escape(&st, sizeof(st)) >= 0)
+         report_failed(&st);
+   }
+   return ret;
+}
+
+static void
+perf_cpu(uint64_t *user, uint64_t *kernel)
+{
+   FILETIME c, e, k, u;
+   *user = *kernel = 0;
+   if (GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u)) {
+      *user = ((uint64_t)u.dwHighDateTime << 32) | u.dwLowDateTime;
+      *kernel = ((uint64_t)k.dwHighDateTime << 32) | k.dwLowDateTime;
+   }
+}
+
+static int wperf_started;
+
+/* The 0057 line, when 10 s have passed. wddm_lock held, wcur set. */
+static void
+perf_tick(void)
+{
+   int64_t now = perf_now();
+   if (wperf.t0 && perf_ms(now - wperf.t0) < 10000.0)
+      return;
+   if (wperf.t0 && (wperf.submits || wperf.presents)) {
+      uint64_t u, k;
+      perf_cpu(&u, &k);
+      MW_ESCAPE_STATS_DATA ks = {0};
+      ks.Code = MW_ESCAPE_STATS;
+      int k_ok = wperf.k_ok && w_escape(&ks, sizeof(ks)) >= 0;
+      uint32_t live = 0, dead = 0, ctxs = 0, inflight = 0;
+      uint64_t live_bytes = 0;
+      for (int i = 0; i < MAX_WCTX; i++) {
+         const struct wctx *c = &wctxs[i];
+         for (uint32_t j = 0; j < c->bo_cap; j++) {
+            if (c->bo[j].h) {
+               live++;
+               live_bytes += c->bo[j].size;
+            }
+         }
+         dead += c->dead_n;
+         ctxs += c->used;
+         inflight += c->pend_n;
+      }
+      char exe[MAX_PATH] = "?";
+      GetModuleFileNameA(NULL, exe, sizeof(exe));
+      const char *base = strrchr(exe, '\\');
+      base = base ? base + 1 : exe;
+      double s = perf_ms(now - wperf.t0) / 1000.0;
+      unsigned subs = wperf.submits ? wperf.submits : 1, pres = wperf.presents ? wperf.presents : 1;
+      fprintf(stderr, "malikm-perf: pid %lu %s %.1fs: %u presents (%.1f/s, %.2f ms each in PresentCb, %u failed) | "
+              "%u submits (%.1f per present, %.1f named + %.1f listed BOs, %.2f ms each in RenderCb, %u failed) | "
+              "waits %u (%.1f ms, %u late), polls %u (%u busy), drains %u, in flight %u | "
+              "BOs +%u (%.1f MB) -%u, live %u (%.0f MB), dead %u, contexts %u | cpu user %.2fs kernel %.2fs",
+              GetCurrentProcessId(), base, s, wperf.presents, wperf.presents / s, perf_ms(wperf.present_t) / pres,
+              wperf.present_fails, wperf.submits, (double)wperf.submits / pres, (double)wperf.named / subs,
+              (double)(wperf.listed - wperf.named) / subs, perf_ms(wperf.render_t) / subs, wperf.render_fails,
+              wperf.waits, perf_ms(wperf.wait_t), wperf.waits_late, wperf.polls, wperf.polls_busy, wperf.drains,
+              inflight, wperf.bo_new, wperf.bo_new_bytes / 1048576.0, wperf.bo_close, live,
+              live_bytes / 1048576.0, dead, ctxs, (u - wperf.cpu_user) / 1e7, (k - wperf.cpu_kernel) / 1e7);
+      if (k_ok) {
+         uint32_t paging = 0;
+         for (int i = 0; i < 16; i++)
+            paging += ks.PagingOps[i] - wperf.k.PagingOps[i];
+         fprintf(stderr, " | KMD (all processes): %u jobs, %u failed, %u timed out, %u blts, %u submits, %u irqs, "
+                 "%u paging ops, queued %u", ks.JobsDone - wperf.k.JobsDone, ks.JobsFailed - wperf.k.JobsFailed,
+                 ks.JobsTimedOut - wperf.k.JobsTimedOut, ks.PresentBlts - wperf.k.PresentBlts,
+                 ks.Submits - wperf.k.Submits, ks.Irqs - wperf.k.Irqs, paging, ks.Queued);
+      }
+      int64_t mc = InterlockedExchange64((volatile LONG64 *)&s10_perf_mesa[0], 0);
+      int64_t mct = InterlockedExchange64((volatile LONG64 *)&s10_perf_mesa[1], 0);
+      int64_t mtb = InterlockedExchange64((volatile LONG64 *)&s10_perf_mesa[2], 0);
+      int64_t mtt = InterlockedExchange64((volatile LONG64 *)&s10_perf_mesa[3], 0);
+      fprintf(stderr, " | Mesa: %lld compiles (%.0f ms), %.1f MB tiled on the CPU (%.0f ms)", (long long)mc,
+              mct / 1e6, mtb / 1048576.0, mtt / 1e6);
+      /* 0063 */
+      fprintf(stderr, " | callbacks: escape %u (%.1f ms), allocate %u (%.1f ms), deallocate %u (%.1f ms), lock %u "
+              "(%.1f ms), unlock %u (%.1f ms); waited %.1f ms for wddm_lock | flushes:",
+              wcb_n[WCB_ESCAPE], perf_ms(wcb_t[WCB_ESCAPE]), wcb_n[WCB_ALLOC], perf_ms(wcb_t[WCB_ALLOC]),
+              wcb_n[WCB_FREE], perf_ms(wcb_t[WCB_FREE]), wcb_n[WCB_LOCK], perf_ms(wcb_t[WCB_LOCK]),
+              wcb_n[WCB_UNLOCK], perf_ms(wcb_t[WCB_UNLOCK]), perf_ms(wlockwait_t));
+      for (int i = 0; i < 24; i++) {
+         LONG fn = InterlockedExchange(&wflush[i].n, 0);
+         if (fn && wflush[i].reason)
+            fprintf(stderr, " '%s' x%ld", wflush[i].reason, (long)fn);
+      }
+      fprintf(stderr, "\n");
+      for (int top = 0; top < 3; top++) {
+         int bi = -1;
+         for (int i = 0; i < 32; i++)
+            if (wbig[i].key && wbig[i].n && (bi < 0 || wbig[i].bytes > wbig[bi].bytes))
+               bi = i;
+         if (bi < 0)
+            break;
+         fprintf(stderr, "malikm-bigbo: pid %lu: %u BOs of 4 MB+ (%.1f MB) created by:", GetCurrentProcessId(),
+                 wbig[bi].n, wbig[bi].bytes / 1048576.0);
+         for (uint32_t f = 0; f < wbig[bi].len; f++)
+            fprintf(stderr, " +0x%x", wbig[bi].fr[f]);
+         fprintf(stderr, "\n");
+         wbig[bi].n = 0;
+      }
+      if (k_ok)
+         report_failed(&ks);
+   }
+   memset(&wperf, 0, sizeof(wperf));
+   memset(wbig, 0, sizeof(wbig));
+   memset(wcb_t, 0, sizeof(wcb_t));
+   memset(wcb_n, 0, sizeof(wcb_n));
+   wlockwait_t = 0;
+   if (!wperf_started) {
+      /* 0058: the first interval starts clean (compiles before it would be counted in it otherwise) */
+      for (int i = 0; i < 4; i++)
+         InterlockedExchange64((volatile LONG64 *)&s10_perf_mesa[i], 0);
+      wperf_started = 1;
+   }
+   wperf.t0 = now;
+   perf_cpu(&wperf.cpu_user, &wperf.cpu_kernel);
+   wperf.k.Code = MW_ESCAPE_STATS;
+   wperf.k_ok = w_escape(&wperf.k, sizeof(wperf.k)) >= 0;
+}
+
+/* Present for d3d10umd on the hardware runtime: Bgrx is the frame, linear
+ * and top-down; it is copied into a surface of the runtime device and
+ * handed to DXGI, which has maliwddm blt it (on the CPU, for now) to the
+ * screen. 0 if presented; -1 if not bound to the runtime (the caller falls
+ * back to GDI). */
+/* G13 (exynos-woa): kernel primary allocations for the runtime's DXGI primaries (d3d10umd CreateResource with
+ * pPrimaryDesc): allocated through the bound runtime's pfnAllocateCb WITH the runtime resource handle and
+ * Flags.Primary, so dxgkrnl ties them to the swap-chain resource; kept locked for CPU writes. */
+static int present_copy(D3DKMT_HANDLE h, const void *bgrx, unsigned w, unsigned hgt);   /* below (G13 0024) */
+
+int
+malikm_primary_create(void *hRTResource, unsigned vidpn, unsigned w, unsigned h, unsigned *hAlloc, int scanout)
+{
+   int ret = -1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (!ddi.on || !ddi.cb.pfnAllocateCb)
+      goto out;
+   for (int i = 0; i < MAX_KPRIM; i++) {
+      if (kprim[i].h)
+         continue;
+      MW_ALLOCATION_INFO pi = {0};
+      D3DDDI_ALLOCATIONINFO ai = {0};
+      D3DDDICB_ALLOCATE a = {0};
+      pi.Version = MW_ABI_VERSION;
+      /* G13 0026: every DXGI primary is a kernel primary again, NO_SCANOUT or not. Run g30full, dxgkrnl ETW 494
+       * "destination must be primary" + Present 0xC000000D on each DWM Blt into the 0025 non-primary destination;
+       * the KMD blts into the framebuffer when the destination carries MW_ALLOC_PRIMARY (command.c DoPresent).
+       * NO_SCANOUT still keeps DXGI on blt presents (no flips, which failed PRESENT_MODE_CHANGED in g22-g26). */
+      (void)scanout;
+      pi.Flags = MW_ALLOC_NOEXEC | MW_ALLOC_PRIMARY;
+      pi.Width = w;
+      pi.Height = h;
+      pi.Pitch = w * 4;
+      pi.Format = D3DDDIFMT_A8R8G8B8;
+      pi.Size = (uint64_t)w * h * 4;
+      ai.pPrivateDriverData = &pi;
+      ai.PrivateDriverDataSize = sizeof(pi);
+      ai.VidPnSourceId = vidpn;
+      ai.Flags.Primary = 1;
+      a.hResource = (HANDLE)hRTResource;
+      a.NumAllocations = 1;
+      a.pAllocationInfo = &ai;
+      HRESULT hr = ddi.cb.pfnAllocateCb(ddi.device, &a);
+      if (trace_on())
+         fprintf(stderr, "malikm: primary for runtime resource %p %ux%u source %u: hr 0x%08lx alloc 0x%x\n",
+                 hRTResource, w, h, vidpn, (unsigned long)hr, (unsigned)ai.hAllocation);
+      if (hr < 0)
+         goto out;
+      kprim[i].h = ai.hAllocation;
+      kprim[i].cpu = NULL;
+      kprim[i].w = w;
+      kprim[i].hgt = h;
+      *hAlloc = ai.hAllocation;
+      ret = 0;
+      goto out;
+   }
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+void
+malikm_primary_destroy(unsigned hAlloc)
+{
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   for (int i = 0; i < MAX_KPRIM; i++) {
+      if (kprim[i].h != hAlloc)
+         continue;
+      /* The runtime frees a resource's allocations itself when the resource goes (pfnAllocateCb with
+       * hResource); only forget it here. */
+      kprim[i].h = 0;
+      kprim[i].cpu = NULL;
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+/* G13 0037: the kernel allocation behind a MISC_SHARED resource. MS Learn PFND3DDDI_ALLOCATECB / D3DDDICB_ALLOCATE:
+ * allocations for CreateResource(D3D10) with D3D10_DDI_RESOURCE_MISC_SHARED must be created with a non-NULL hResource
+ * (the hRTResource), once per resource (no later additions). d3d10umd created none, so the runtime had nothing to make
+ * a shared handle from: d3d11!CDevice::CreateCompositionBuffer failed E_INVALIDARG on the Mali adapter (run g50) and
+ * LogonUI's DComp atlas with it (g47/g49). One allocation with the KMD's MW_ALLOCATION_INFO (d3dfmt as the openers
+ * read it, 0 when it has no D3DDDIFORMAT here), then locked for writing: the creator renders straight into it.
+ * Returns 0 with *hAlloc (and *cpu / *pitch, *cpu NULL when the lock was refused), -1 on failure. */
+int
+malikm_shared_create(void *hRTResource, unsigned w, unsigned h, unsigned cpp, unsigned d3dfmt, unsigned *hAlloc,
+                     void **cpu, unsigned *pitch)
+{
+   int ret = -1;
+   MW_ALLOCATION_INFO pi = {0};
+   D3DDDI_ALLOCATIONINFO ai = {0};
+   D3DDDICB_ALLOCATE a = {0};
+   HRESULT hr;
+
+   *hAlloc = 0;
+   *cpu = NULL;
+   *pitch = w * cpp;
+   if (w == 0 || h == 0 || cpp == 0 || hRTResource == NULL)
+      return -1;
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (!ddi.on || !ddi.cb.pfnAllocateCb)
+      goto out;
+   pi.Version = MW_ABI_VERSION;
+   pi.Flags = MW_ALLOC_NOEXEC;
+   pi.Width = w;
+   pi.Height = h;
+   pi.Pitch = *pitch;
+   pi.Format = d3dfmt;
+   pi.Size = (uint64_t)*pitch * h;
+   ai.pPrivateDriverData = &pi;
+   ai.PrivateDriverDataSize = sizeof(pi);
+   a.hResource = (HANDLE)hRTResource;
+   a.NumAllocations = 1;
+   a.pAllocationInfo = &ai;
+   hr = ddi.cb.pfnAllocateCb(ddi.device, &a);
+   if (hr >= 0) {
+      *hAlloc = ai.hAllocation;
+      ret = 0;
+      if (ddi.cb.pfnLockCb) {
+         D3DDDICB_LOCK l = {0};
+         l.hAllocation = ai.hAllocation;
+         l.Flags.IgnoreSync = 1;
+         if (ddi.cb.pfnLockCb(ddi.device, &l) >= 0)
+            *cpu = l.pData;
+      }
+   }
+   if (trace_on())
+      fprintf(stderr, "malikm: shared resource %p %ux%u cpp %u fmt %u: alloc hr 0x%08lx 0x%x cpu %p\n", hRTResource,
+              w, h, cpp, d3dfmt, (unsigned long)hr, *hAlloc, *cpu);
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+/* G13 0028: DXGI's SetDisplayMode -> the runtime's pfnSetDisplayModeCb with the resource's kernel primary, which is
+ * how dxgkrnl makes that primary the VidPN source's current one and the device its exclusive owner. d3d10umd's
+ * _SetDisplayMode was a stub, so every present into DWM's primary failed 0xC01E0000 NOT_EXCLUSIVE_MODE_OWNER, then
+ * 0xC01E0005 PRESENT_MODE_CHANGED (run g31full; the same status the flips got in g22-g26). Returns the HRESULT, or
+ * 1 when not bound to the maliwddm runtime / no callback (the caller then keeps the stub's S_OK). */
+long
+malikm_set_display_mode(unsigned hAlloc)
+{
+   long hr = 1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (ddi.on && ddi.cb.pfnSetDisplayModeCb && hAlloc) {
+      D3DDDICB_SETDISPLAYMODE m = {0};
+      m.hPrimaryAllocation = hAlloc;
+      hr = ddi.cb.pfnSetDisplayModeCb(ddi.device, &m);
+      if (trace_on())
+         fprintf(stderr, "malikm: SetDisplayModeCb alloc 0x%x: hr 0x%08lx attr 0x%x\n", hAlloc, (unsigned long)hr,
+                 m.PrivateDriverFormatAttribute);
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return hr;
+}
+
+/* G13 0034: OpenResource of an allocation another process (or the OS: CDD's shared primary / shadow surface) created.
+ * Run g42full: DWM opens 4 x MW_ALLOC_PRIMARY + 1 x plain A8R8G8B8 1080x2280 allocations at start; d3d10umd's
+ * OpenResource was a stub (E_OUTOFMEMORY), so DWM composed black. The description comes only from the allocation's
+ * private data (MS Learn PFND3DDDI_OPENRESOURCE: the same data DxgkDdiCreateAllocation got) - here the KMD's
+ * MW_ALLOCATION_INFO. The pixels: openers may not lock a shared allocation "unless it's a GDI non-managed primary
+ * allocation" (D3DDDICB_LOCKFLAGS), so the lock is attempted and *cpu stays NULL when refused (the caller then
+ * makes a blank texture). Returns 0 with the description, -1 when the data is not ours. Traced under MALIKM_TRACE. */
+int
+malikm_open_shared(const void *priv, unsigned size, unsigned hAlloc, unsigned *w, unsigned *h, unsigned *pitch,
+                   unsigned *d3dfmt, void **cpu)
+{
+   const MW_ALLOCATION_INFO *pi = (const MW_ALLOCATION_INFO *)priv;
+
+   *cpu = NULL;
+   if (pi == NULL || size < sizeof(*pi) || pi->Version != MW_ABI_VERSION || pi->Width == 0 || pi->Height == 0)
+      return -1;
+   *w = pi->Width;
+   *h = pi->Height;
+   *pitch = pi->Pitch ? pi->Pitch : pi->Width * 4;
+   *d3dfmt = pi->Format;
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (ddi.on && ddi.cb.pfnLockCb) {
+      D3DDDICB_LOCK l = {0};
+      HRESULT hr;
+      l.hAllocation = hAlloc;
+      l.Flags.ReadOnly = 1;
+      l.Flags.IgnoreSync = 1;
+      hr = ddi.cb.pfnLockCb(ddi.device, &l);
+      if (hr >= 0)
+         *cpu = l.pData;
+      if (trace_on())
+         fprintf(stderr, "malikm: open shared alloc 0x%x %ux%u pitch %u fmt %u flags 0x%x: lock hr 0x%08lx cpu %p\n",
+                 hAlloc, *w, *h, *pitch, *d3dfmt, pi->Flags, (unsigned long)hr, *cpu);
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return 0;
+}
+
+void
+malikm_close_shared(unsigned hAlloc)
+{
+   D3DKMT_HANDLE hk = hAlloc;
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (ddi.on && ddi.cb.pfnUnlockCb) {
+      D3DDDICB_UNLOCK u = {0};
+      u.NumAllocations = 1;
+      u.phAllocations = &hk;
+      ddi.cb.pfnUnlockCb(ddi.device, &u);
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+/* G2b-3 (0045): presents per process, always logged (rate-limited): DWM on Panfrost reached the KMD (179 presents)
+ * but the panel stayed black, and nothing said which path its frames took. kind 0 runtime primary, 1 flip, 2 blt. */
+static void
+present_note(int kind, HRESULT hr, unsigned w, unsigned h)
+{
+   static unsigned ok[4], bad[4];
+   static const char *const names[4] = { "runtime primary", "flip", "blt", "shared allocation" };
+   unsigned n;
+   if (hr >= 0)
+      n = ++ok[kind];
+   else
+      n = ++bad[kind];
+   if (n <= 3 || n % 300 == 0)
+      fprintf(stderr, "malikm-wddm: pid %lu: present %s %ux%u %s 0x%08lx (#%u; ok %u/%u/%u/%u failed %u/%u/%u/%u)\n",
+              GetCurrentProcessId(), names[kind], w, h, hr >= 0 ? "ok" : "FAILED", (unsigned long)hr, n,
+              ok[0], ok[1], ok[2], ok[3], bad[0], bad[1], bad[2], bad[3]);
+}
+
+/* 0063: have the profiler thread time this present packet (if it is free). wddm_lock held, wcur set, right after a
+ * successful pfnPresentCb. */
+static void
+wpres_arm(int64_t t_call)
+{
+   if (wprof_on != 1 || !ddi.on || InterlockedCompareExchange(&wpres.state, 2, 0) != 0)
+      return;
+   HANDLE a = NULL, b = CreateEventW(NULL, TRUE, FALSE, NULL);
+   D3DDDICB_SIGNALSYNCHRONIZATIONOBJECT2 sig = {0};
+   sig.hContext = ddi.context;
+   sig.Flags.EnqueueCpuEvent = 1;
+   sig.CpuEventHandle = b;
+   if (!b || ddi.cb.pfnSignalSynchronizationObject2Cb(ddi.device, &sig) < 0) {
+      if (b)
+         CloseHandle(b);
+      InterlockedExchange(&wpres.state, 0);
+      return;
+   }
+   if (wcur->pend_n) {
+      struct wpend *p = &wcur->pend[(wcur->pend_head + wcur->pend_n - 1) % WPEND];
+      if (p->ev)
+         DuplicateHandle(GetCurrentProcess(), p->ev, GetCurrentProcess(), &a, SYNCHRONIZE, FALSE, 0);
+   }
+   wpres.a = a;
+   wpres.b = b;
+   wpres.t_call = t_call;
+   InterlockedExchange(&wpres.state, 1);
+}
+
+/* G2b-3 (0052): present an allocation that already holds the frame (a shared swap-chain buffer, rendered by the GPU
+ * into its own runtime allocation). 0 if the runtime accepted it. */
+int
+malikm_present_alloc(unsigned hSrc, unsigned hDst, void *dxgi_context, unsigned w, unsigned h)
+{
+   int ret = -1;
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (ddi.on && ddi.dxgi && ddi.dxgi->pfnPresentCb) {
+      DXGIDDICB_PRESENT p = {0};
+      p.hSrcAllocation = hSrc;
+      p.hDstAllocation = hDst;
+      p.pDXGIContext = dxgi_context;
+      p.hContext = ddi.context;
+      int64_t t0 = perf_now();
+      HRESULT hr = ddi.dxgi->pfnPresentCb(ddi.device, &p);
+      wperf.present_t += perf_now() - t0;
+      wperf.presents++;
+      wperf.present_fails += hr < 0;
+      ret = hr >= 0 ? 0 : -1;
+      if (hr >= 0)
+         wpres_arm(t0);   /* 0063 */
+      present_note(3, hr, w, h);
+      perf_tick();   /* 0057 */
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+int
+malikm_primary_present(unsigned hAlloc, unsigned hDst, const void *bgrx, unsigned w, unsigned h, void *dxgi_context)
+{
+   int ret = -1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (!ddi.on || !ddi.dxgi || !ddi.dxgi->pfnPresentCb)
+      goto out;
+   for (int i = 0; i < MAX_KPRIM; i++) {
+      if (kprim[i].h != hAlloc)
+         continue;
+      if (kprim[i].w != w || kprim[i].hgt != h)
+         goto out;
+      if (present_copy(kprim[i].h, bgrx, w, h) != 0)
+         goto out;
+      DXGIDDICB_PRESENT p = {0};
+      p.hSrcAllocation = kprim[i].h;
+      p.hDstAllocation = hDst;        /* G13 0025: the destination resource's allocation, if DXGI named one */
+      p.pDXGIContext = dxgi_context;
+      p.hContext = ddi.context;
+      int64_t t0 = perf_now();
+      HRESULT hr = ddi.dxgi->pfnPresentCb(ddi.device, &p);
+      wperf.present_t += perf_now() - t0;
+      wperf.presents++;
+      wperf.present_fails += hr < 0;
+      ret = hr >= 0 ? 0 : -1;
+      present_note(0, hr, w, h);
+      perf_tick();   /* 0057 */
+      goto out;
+   }
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+/* G13 (exynos-woa, patch 0024): copy a frame into a present surface with the allocation locked only for the
+ * copy. The surfaces used to stay locked for their whole life, and dxgkrnl does not run a present whose source
+ * allocation is CPU-locked: run g27full, DWM's 4 Blt presents were accepted (ETW 184 status 0) but never reached
+ * the KMD's DxgkDdiPresent, and DWM stopped at its frame latency. 0 if copied. wddm_lock held. */
+static int
+present_copy(D3DKMT_HANDLE h, const void *bgrx, unsigned w, unsigned hgt)
+{
+   void *cpu = w_lock(h);
+   if (!cpu)
+      return -1;
+   memcpy(cpu, bgrx, (size_t)w * hgt * 4);
+   w_unlock(h);
+   return 0;
+}
+
+/* G13: a primary present surface pair for flips; 0 if ready. Called with wddm_lock held. */
+static int
+present_primaries(unsigned w, unsigned h)
+{
+   if (ddi.prim[0] && (ddi.prim_w != w || ddi.prim_h != h)) {
+      for (int i = 0; i < 2; i++) {
+         if (ddi.prim[i])
+            w_destroy(ddi.prim[i]);
+         ddi.prim[i] = 0;
+         ddi.prim_cpu[i] = NULL;
+      }
+   }
+   for (int i = 0; i < 2; i++) {
+      if (ddi.prim[i])
+         continue;
+      MW_ALLOCATION_INFO pi = {0};
+      D3DDDI_ALLOCATIONINFO ai = {0};
+      pi.Version = MW_ABI_VERSION;
+      pi.Flags = MW_ALLOC_NOEXEC | MW_ALLOC_PRIMARY;
+      pi.Width = w;
+      pi.Height = h;
+      pi.Pitch = w * 4;
+      pi.Format = D3DDDIFMT_A8R8G8B8;   /* as the VidPN source mode (MaliG76Wddm FillSourceMode) */
+      pi.Size = (uint64_t)w * h * 4;
+      ai.pPrivateDriverData = &pi;
+      ai.PrivateDriverDataSize = sizeof(pi);
+      ai.VidPnSourceId = 0;
+      ai.Flags.Primary = 1;
+      if (w_create(&ai) < 0) {
+         if (trace_on())
+            fprintf(stderr, "malikm: primary present surface %ux%u: allocate failed\n", w, h);
+         return -1;
+      }
+      ddi.prim[i] = ai.hAllocation;
+   }
+   ddi.prim_w = w;
+   ddi.prim_h = h;
+   return 0;
+}
+
+int
+malikm_present_d3dddi(const void *bgrx, unsigned w, unsigned h, void *dxgi_context, int primary)
+{
+   int ret = -1;
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (!ddi.on || !ddi.dxgi || !ddi.dxgi->pfnPresentCb)
+      goto out;
+   if (primary) {
+      /* G13: a flip - from one of the two primaries, in turn. */
+      if (present_primaries(w, h) != 0)
+         goto out;
+      unsigned i = ddi.prim_next;
+      ddi.prim_next ^= 1;
+      if (present_copy(ddi.prim[i], bgrx, w, h) != 0)
+         goto out;
+      DXGIDDICB_PRESENT fp = {0};
+      fp.hSrcAllocation = ddi.prim[i];
+      fp.pDXGIContext = dxgi_context;
+      fp.hContext = ddi.context;
+      int64_t t0 = perf_now();
+      HRESULT hr = ddi.dxgi->pfnPresentCb(ddi.device, &fp);
+      wperf.present_t += perf_now() - t0;
+      wperf.presents++;
+      wperf.present_fails += hr < 0;
+      ret = hr >= 0 ? 0 : -1;
+      present_note(1, hr, w, h);
+      perf_tick();   /* 0057 */
+      goto out;
+   }
+   if (ddi.present && (ddi.present_w != w || ddi.present_h != h)) {
+      w_destroy(ddi.present);
+      ddi.present = 0;
+      ddi.present_cpu = NULL;
+   }
+   if (!ddi.present) {
+      MW_ALLOCATION_INFO pi = {0};
+      D3DDDI_ALLOCATIONINFO ai = {0};
+      pi.Version = MW_ABI_VERSION;
+      pi.Flags = MW_ALLOC_NOEXEC;
+      pi.Width = w;
+      pi.Height = h;
+      pi.Pitch = w * 4;
+      pi.Format = D3DDDIFMT_X8R8G8B8;
+      pi.Size = (uint64_t)w * h * 4;
+      ai.pPrivateDriverData = &pi;
+      ai.PrivateDriverDataSize = sizeof(pi);
+      if (w_create(&ai) < 0)
+         goto out;
+      ddi.present = ai.hAllocation;
+      ddi.present_w = w;
+      ddi.present_h = h;
+   }
+   if (present_copy(ddi.present, bgrx, w, h) != 0)
+      goto out;
+
+   DXGIDDICB_PRESENT p = {0};
+   p.hSrcAllocation = ddi.present;
+   p.pDXGIContext = dxgi_context;
+   p.hContext = ddi.context;
+   int64_t t0 = perf_now();
+   HRESULT hr = ddi.dxgi->pfnPresentCb(ddi.device, &p);
+   wperf.present_t += perf_now() - t0;
+   wperf.presents++;
+   wperf.present_fails += hr < 0;
+   ret = hr >= 0 ? 0 : -1;
+   present_note(2, hr, w, h);
+   perf_tick();   /* 0057 */
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+/* The runtime's device and callbacks, from d3d10umd's CreateDevice. 0 if
+ * this is maliwddm's adapter and Panfrost now goes through the callbacks.
+ * G13 (exynos-woa): 1 if it is maliwddm's adapter WITHOUT a GPU (GPU_INFO
+ * Count != 0, Valid == 0): the callbacks are kept for presenting only
+ * (malikm_present_d3dddi), Panfrost stays off (wddm is not set). -1 else. */
+int
+malikm_bind_d3dddi(HANDLE hRTAdapter, HANDLE hRTDevice, const void *pKTCallbacks,
+                   const void *pDXGIBaseCallbacks)
+{
+   const D3DDDI_DEVICECALLBACKS *cb = pKTCallbacks;
+   MW_ESCAPE_GPU_INFO_DATA g = {0};
+   int ret = -1;
+
+   if (!cb || !cb->pfnEscapeCb || !cb->pfnAllocateCb || !cb->pfnRenderCb || !cb->pfnCreateContextCb)
+      return -1;
+   AcquireSRWLockExclusive(&wddm_lock);
+   /* G2b-3 (0053): every runtime device gets its own wctx (0045 shared the first one - see struct wctx). */
+   struct wctx *nc = NULL;
+   for (int i = 0; i < MAX_WCTX && !nc; i++)
+      if (!wctxs[i].used)
+         nc = &wctxs[i];
+   if (!nc) {
+      fprintf(stderr, "malikm-wddm: pid %lu: device %p: all %d shim contexts in use\n", GetCurrentProcessId(),
+              hRTDevice, MAX_WCTX);
+      ReleaseSRWLockExclusive(&wddm_lock);
+      return -1;
+   }
+   memset(nc, 0, sizeof(*nc));
+   wcur = nc;
+   /* Ask the adapter through the callbacks: a software runtime routes them
+    * to d3d10umd's own D3DKMT stubs, which fail. */
+   D3DDDICB_ESCAPE e = {0};
+   e.hDevice = hRTDevice;
+   e.pPrivateDriverData = &g;
+   e.PrivateDriverDataSize = sizeof(g);
+   g.Code = MW_ESCAPE_GPU_INFO;
+   NTSTATUS es = cb->pfnEscapeCb(hRTAdapter, &e);
+   if (es >= 0 && g.Count != 0 && g.Valid == 0 && cb->pfnLockCb && cb->pfnUnlockCb && cb->pfnDeallocateCb) {
+      D3DDDICB_CREATECONTEXT c = {0};
+      c.NodeOrdinal = 0;
+      c.EngineAffinity = 1;
+      if (cb->pfnCreateContextCb(hRTDevice, &c) >= 0) {
+         ddi.on = 1;
+         ddi.adapter = hRTAdapter;
+         ddi.device = hRTDevice;
+         ddi.context = c.hContext;
+         ddi.cb = *cb;
+         ddi.dxgi = pDXGIBaseCallbacks;
+         ret = 1;
+         nc->used = 1;
+         wtls_bound = nc;
+      }
+   } else if (es >= 0 && g.Count != 0 && g.Valid != 0) {
+      D3DDDICB_CREATECONTEXT c = {0};
+      c.NodeOrdinal = 0;
+      c.EngineAffinity = 1;
+      if (cb->pfnCreateContextCb(hRTDevice, &c) >= 0) {
+         ddi.on = 1;
+         ddi.adapter = hRTAdapter;
+         ddi.device = hRTDevice;
+         ddi.context = c.hContext;
+         ddi.cb = *cb;
+         ddi.dxgi = pDXGIBaseCallbacks;
+         wcmd = c.pCommandBuffer;
+         wcmd_size = c.CommandBufferSize;
+         walloc = c.pAllocationList;
+         walloc_size = c.AllocationListSize;
+         wpatch = c.pPatchLocationList;
+         wpatch_size = c.PatchLocationListSize;
+         wgpu = g;
+         wddm = 1;
+         ret = 0;
+         nc->used = 1;
+         wtls_bound = nc;
+         unsigned in_use = 0;
+         for (int i = 0; i < MAX_WCTX; i++)
+            in_use += wctxs[i].used;
+         if (in_use > 1)
+            fprintf(stderr, "malikm-wddm: pid %lu: device %p has its own shim context (%u in this process)\n",
+                    GetCurrentProcessId(), hRTDevice, in_use);
+      }
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+   if (trace_on())
+      fprintf(stderr, "malikm: bind to the runtime device %p: %s\n", hRTDevice,
+              ret == 0 ? "yes, through its callbacks" :
+              ret == 1 ? "present only (maliwddm without a GPU)" : "no (not maliwddm, or software runtime)");
+   return ret;
+}
+
+/* G2b-3 (0045): DestroyDevice (d3d10umd), after the device dropped its screen reference. When the last device
+ * bound to the GPU goes, the next CreateDevice binds afresh (its own kernel device and context). */
+void
+malikm_unbind_d3dddi(HANDLE hRTDevice)
+{
+   /* 0053: the device's own wctx goes with it (its screen is already destroyed: DestroyDevice drops it first). */
+   AcquireSRWLockExclusive(&wddm_lock);
+   for (int i = 0; i < MAX_WCTX; i++) {
+      struct wctx *c = &wctxs[i];
+      if (!c->used || !c->d.on || c->d.device != hRTDevice)
+         continue;
+      wcur = c;
+      wddm_idle();
+      while (c->pend_n)   /* 0057: done or given up on; their events closed */
+         pend_pop();
+      wdone = wseq;
+      wdead_flush();
+      free(c->sobj);
+      uint32_t live = 0;
+      for (uint32_t j = 0; j < wbo_cap; j++)
+         live += wbo[j].h != 0;
+      if (live)
+         fprintf(stderr, "malikm-wddm: pid %lu: device %p destroyed with %u BOs still open\n", GetCurrentProcessId(),
+                 hRTDevice, live);
+      free(c->bo);
+      free(c->dead);
+      if (c->fdh)
+         CloseHandle(c->fdh);
+      for (int k = 0; k < 32; k++)
+         if (fdcache[k].c == c)
+            fdcache[k].c = NULL;
+      if (wtls_bound == c)
+         wtls_bound = NULL;
+      memset(c, 0, sizeof(*c));
+      wcur = &wctxs[0];
+      break;
+   }
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+static struct wbo_s *
+wddm_bo(uint32_t h)
+{
+   return h && h <= wbo_cap && wbo[h - 1].h ? &wbo[h - 1] : NULL;
+}
+
+/* A free BO handle (1-based), growing the table; 0 if out of memory. wddm_lock held. */
+static uint32_t
+wbo_slot(void)
+{
+   for (uint32_t i = 0; i < wbo_cap; i++)
+      if (!wbo[i].h)
+         return i + 1;
+   uint32_t cap = wbo_cap ? wbo_cap * 2 : 256;
+   struct wbo_s *n = realloc(wbo, cap * sizeof(*n));
+   if (!n)
+      return 0;
+   memset(n + wbo_cap, 0, (cap - wbo_cap) * sizeof(*n));
+   wbo = n;
+   uint32_t h = wbo_cap + 1;
+   wbo_cap = cap;
+   return h;
+}
+
+/* ---- G2b-3 (0046): DXGI shared resources on the GPU ----
+ * Run g2b3-5 (UMD 12a5e28b): every allocation DWM opened was "not lockable" (Explorer's, the terminal's, the CDD
+ * surfaces), so the 0045 CPU copy never ran and DWM composed blank textures; the creators' side was no better (their
+ * MISC_SHARED textures were Panfrost textures unrelated to the shared allocation). The KMD gives every allocation
+ * one GPU address for its whole life in the one address space all processes share (memory.c NewAllocation), so
+ * neither side needs a copy:
+ *  - the creator's texture BO is the shared allocation itself: malikm_shared_bo_begin() before resource_create, and
+ *    the next CREATE_BO of that thread allocates with the runtime resource handle and the surface description;
+ *  - an opener imports the allocation as a BO: malikm_import_alloc() returns a CRT fd standing for it, which
+ *    Panfrost's resource_from_handle(WINSYS_HANDLE_TYPE_FD) takes through drmPrimeFDToHandle (below) and
+ *    pan_kmod_bo_import's size query (malikm_prime_size). */
+static __declspec(thread) struct {
+   int on;
+   void *hres;
+   unsigned w, h, pitch, fmt;
+   D3DKMT_HANDLE got;
+   int primary;          /* 0054: a DXGI primary - Flags.Primary on VidPN source vidpn, MW_ALLOC_PRIMARY */
+   unsigned vidpn;
+} wshared;
+
+void
+malikm_shared_bo_begin(void *hRTResource, unsigned w, unsigned h, unsigned pitch, unsigned d3dfmt)
+{
+   wshared.on = 1;
+   wshared.hres = hRTResource;
+   wshared.w = w;
+   wshared.h = h;
+   wshared.pitch = pitch;
+   wshared.fmt = d3dfmt;
+   wshared.got = 0;
+}
+
+/* G2b-3 (0054): the same for a DXGI primary (DWM's swap chain): the BO is the kernel primary allocation, created
+ * as malikm_primary_create does (Flags.Primary, the VidPN source, MW_ALLOC_PRIMARY, A8R8G8B8, pitch w * 4), so the
+ * GPU renders straight into what the KMD scans out or blts - no read-back, no CPU copy per frame. */
+void
+malikm_primary_bo_begin(void *hRTResource, unsigned vidpn, unsigned w, unsigned h)
+{
+   malikm_shared_bo_begin(hRTResource, w, h, w * 4, D3DDDIFMT_A8R8G8B8);
+   wshared.primary = 1;
+   wshared.vidpn = vidpn;
+}
+
+/* G2b-3 (0069): the next CREATE_BO of this thread is the framebuffer alias (MW_ALLOC_FBALIAS, w x h, A8R8G8B8,
+ * pitch w * 4): a device allocation whose GPU pages the KMD maps onto the GOP framebuffer. */
+static __declspec(thread) struct {
+   int on;
+   unsigned w, h;
+   D3DKMT_HANDLE got;
+} walias;
+
+void
+malikm_fbalias_bo_begin(unsigned w, unsigned h)
+{
+   walias.on = 1;
+   walias.w = w;
+   walias.h = h;
+   walias.got = 0;
+}
+
+unsigned
+malikm_fbalias_bo_end(void)
+{
+   unsigned got = walias.got;
+   walias.on = 0;
+   return got;
+}
+
+unsigned
+malikm_shared_bo_end(void)
+{
+   unsigned got = wshared.got;
+   memset(&wshared, 0, sizeof(wshared));
+   return got;
+}
+
+#define MAX_PRIMES 16
+static struct { int fd; D3DKMT_HANDLE h; uint64_t va, size; } primes[MAX_PRIMES];
+
+int
+malikm_import_alloc(unsigned hAlloc)
+{
+   int fd = -1;
+   MW_ESCAPE_ALLOC_INFO_DATA where = {0};
+
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = dev_ctx(wtls_dev);   /* 0053 */
+   if (!ddi.on || wddm != 1)
+      goto out;
+   where.Code = MW_ESCAPE_ALLOC_INFO;
+   where.hAllocation = hAlloc;
+   if (w_escape(&where, sizeof(where)) < 0 || where.GpuVa == 0 || where.Size == 0) {
+      fprintf(stderr, "malikm-wddm: pid %lu: opened allocation 0x%x: no GPU address\n", GetCurrentProcessId(), hAlloc);
+      goto out;
+   }
+   for (int i = 0; i < MAX_PRIMES; i++) {
+      if (primes[i].fd == 0) {
+         fd = token_fd();
+         if (fd < 0)
+            break;
+         primes[i].fd = fd;
+         primes[i].h = hAlloc;
+         primes[i].va = where.GpuVa;
+         primes[i].size = where.Size;
+         break;
+      }
+   }
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return fd;
+}
+
+void
+malikm_import_done(int fd)
+{
+   AcquireSRWLockExclusive(&wddm_lock);
+   for (int i = 0; i < MAX_PRIMES; i++)
+      if (primes[i].fd == fd && fd > 0)
+         memset(&primes[i], 0, sizeof(primes[i]));
+   ReleaseSRWLockExclusive(&wddm_lock);
+   if (fd >= 0)
+      _close(fd);
+}
+
+/* pan_kmod_bo_import's dma-buf size (lseek(fd, 0, SEEK_END) on Linux). 0 if fd is not an import. */
+uint64_t
+malikm_prime_size(int fd)
+{
+   uint64_t size = 0;
+   AcquireSRWLockShared(&wddm_lock);
+   for (int i = 0; i < MAX_PRIMES; i++)
+      if (primes[i].fd == fd && fd > 0)
+         size = primes[i].size;
+   ReleaseSRWLockShared(&wddm_lock);
+   return size;
+}
+
+static int
+wddm_prime_to_handle(int fd, int prime_fd, uint32_t *handle)
+{
+   int ret = -MK_EINVAL;
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = fd_ctx(fd);   /* 0053 */
+   for (int i = 0; i < MAX_PRIMES; i++) {
+      if (primes[i].fd != prime_fd || prime_fd <= 0)
+         continue;
+      /* the same allocation imported twice is the same BO, as with a dma-buf */
+      for (uint32_t j = 0; j < wbo_cap; j++) {
+         if (wbo[j].h == primes[i].h) {
+            *handle = j + 1;
+            ret = 0;
+            goto out;
+         }
+      }
+      uint32_t h = wbo_slot();
+      if (!h) {
+         ret = -MK_ENOMEM;
+         goto out;
+      }
+      wbo[h - 1] = (struct wbo_s){primes[i].h, primes[i].size, primes[i].va, NULL};
+      wbo[h - 1].foreign = WBO_OPENED;
+      *handle = h;
+      ret = 0;
+      goto out;
+   }
+out:
+   ReleaseSRWLockExclusive(&wddm_lock);
+   return ret;
+}
+
+static int
+wddm_drm(uint32_t nr, uint8_t *b, uint32_t size)
+{
+   switch (nr) {
+   case MALIKM_NR_PANFROST_GET_PARAM: {
+      struct drm_panfrost_get_param *a = (void *)b;
+      if (a->param >= MW_GPU_PARAMS || !(wgpu.Valid & (1ull << a->param)))
+         return -MK_EINVAL;
+      a->value = wgpu.Value[a->param];
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_CREATE_BO: {
+      struct drm_panfrost_create_bo *a = (void *)b;
+      uint64_t sz = ((uint64_t)a->size + 4095) & ~4095ull;
+      if (a->flags & PANFROST_BO_HEAP)
+         sz = (sz + 0x1fffff) & ~0x1fffffull;
+      MW_ALLOCATION_INFO pi = {0};
+      pi.Version = MW_ABI_VERSION;
+      pi.Flags = (a->flags & PANFROST_BO_NOEXEC) ? MW_ALLOC_NOEXEC : 0;
+      pi.Size = sz;
+      D3DDDI_ALLOCATIONINFO ai = {0};
+      ai.pPrivateDriverData = &pi;
+      ai.PrivateDriverDataSize = sizeof(pi);
+      int foreign = 0;
+      if (wshared.on && !wshared.got && ddi.on && sz >= (uint64_t)wshared.pitch * wshared.h) {
+         /* G2b-3 (0046): the BO of a MISC_SHARED resource IS its runtime allocation (created with the resource
+          * handle, so the runtime can share it), described for openers: size, pitch, format. */
+         D3DDDICB_ALLOCATE ra = {0};
+         pi.Width = wshared.w;
+         pi.Height = wshared.h;
+         pi.Pitch = wshared.pitch;
+         pi.Format = wshared.fmt;
+         if (wshared.primary) {
+            pi.Flags |= MW_ALLOC_PRIMARY;
+            ai.VidPnSourceId = wshared.vidpn;
+            ai.Flags.Primary = 1;
+         }
+         ra.hResource = wshared.hres;
+         ra.NumAllocations = 1;
+         ra.pAllocationInfo = &ai;
+         HRESULT hr = ddi.cb.pfnAllocateCb(ddi.device, &ra);
+         if (hr < 0) {
+            fprintf(stderr, "malikm-wddm: pid %lu: shared BO %ux%u for resource %p: allocate 0x%08lx\n",
+                    GetCurrentProcessId(), wshared.w, wshared.h, wshared.hres, (unsigned long)hr);
+            wshared.on = 0;
+            return -MK_ENOMEM;
+         }
+         wshared.got = ai.hAllocation;
+         foreign = WBO_RUNTIME;
+      } else {
+         if (walias.on && !walias.got && sz >= (uint64_t)walias.w * 4 * walias.h) {   /* 0069 */
+            pi.Flags |= MW_ALLOC_FBALIAS;
+            pi.Width = walias.w;
+            pi.Height = walias.h;
+            pi.Pitch = walias.w * 4;
+            pi.Format = D3DDDIFMT_A8R8G8B8;
+         }
+         if (w_create(&ai) < 0)
+            return -MK_ENOMEM;
+         if (pi.Flags & MW_ALLOC_FBALIAS)
+            walias.got = ai.hAllocation;
+      }
+      MW_ESCAPE_ALLOC_INFO_DATA where = {0};
+      where.Code = MW_ESCAPE_ALLOC_INFO;
+      where.hAllocation = ai.hAllocation;
+      if (w_escape(&where, sizeof(where)) < 0 || where.GpuVa == 0) {
+         if (!foreign)
+            w_destroy(ai.hAllocation);
+         return -MK_ENOMEM;
+      }
+      uint32_t h = wbo_slot();
+      if (!h)
+         return -MK_ENOMEM;
+      wbo[h - 1] = (struct wbo_s){ai.hAllocation, where.Size, where.GpuVa, NULL};
+      wbo[h - 1].foreign = foreign;
+      wbo[h - 1].pinned = wseq == 0;   /* 0063 */
+      a->handle = h;
+      a->offset = where.GpuVa;
+      wperf.bo_new++;
+      wperf.bo_new_bytes += where.Size;
+      if (where.Size >= WBIG_MIN)
+         wbig_note(where.Size);   /* 0063 */
+      /* Where every BO lives, so a GPU fault address can be traced back to
+       * the buffer it fell in (the 0x4002c3 faults at a fixed VA). */
+      if (trace_on())
+         fprintf(stderr, "malikm-wddm: bo %u va 0x%llx-0x%llx flags 0x%x%s\n", h,
+                 (unsigned long long)where.GpuVa,
+                 (unsigned long long)(where.GpuVa + where.Size),
+                 (unsigned)a->flags, (a->flags & PANFROST_BO_HEAP) ? " HEAP" : "");
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_MMAP_BO: {
+      struct drm_panfrost_mmap_bo *a = (void *)b;
+      if (!wddm_bo(a->handle))
+         return -MK_ENOENT;
+      a->offset = MALIKM_MMAP_OFFSET(a->handle);
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_GET_BO_OFFSET: {
+      struct drm_panfrost_get_bo_offset *a = (void *)b;
+      struct wbo_s *bo = wddm_bo(a->handle);
+      if (!bo)
+         return -MK_ENOENT;
+      a->offset = bo->va;
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_MADVISE:
+      ((struct drm_panfrost_madvise *)b)->retained = 1;
+      return 0;
+   case MALIKM_NR_PANFROST_WAIT_BO: {
+      /* 0057: the BO's own newest submission, within the timeout (0 = "busy?") - no longer a full drain */
+      struct drm_panfrost_wait_bo *a = (void *)b;
+      struct wbo_s *bo = wddm_bo(a->handle);
+      if (!bo)
+         return -MK_ENOENT;
+      return w_wait_seq(bo->busy, a->timeout_ns, 1);
+   }
+   case MALIKM_NR_PANFROST_SUBMIT: {
+      struct drm_panfrost_submit *a = (void *)b;
+      const uint32_t *bos = (const uint32_t *)(b + a->bo_handles);
+      if (!a->jc)
+         return -MK_EINVAL;
+      if (a->bo_handle_count > walloc_size || sizeof(MW_COMMAND) > wcmd_size)
+         return -MK_E2BIG;
+      w_retire();   /* 0057: frees the closed allocations whose jobs are done */
+      static uint64_t mark;
+      uint32_t n = 0;
+      mark++;
+      for (uint32_t i = 0; i < a->bo_handle_count; i++) {
+         struct wbo_s *bo = wddm_bo(bos[i]);
+         if (!bo)
+            return -MK_ENOENT;
+         if (bo->listed == mark)
+            continue;
+         bo->listed = mark;
+         bo->seen = 1;
+         memset(&walloc[n], 0, sizeof(walloc[n]));
+         walloc[n].hAllocation = bo->h;
+         walloc[n].WriteOperation = 1;
+         n++;
+      }
+      /* Every other live BO too. Linux's panfrost maps a BO into the GPU
+       * VM when it is created, so a job may touch BOs it does not name,
+       * and Mesa relies on that. VidMm only pages in (and maliwddm only
+       * maps) what is in the allocation list, so such a job faulted: PE,
+       * 2026-10-17, two read translation faults (0x4002c3) at 0xa131000,
+       * the first byte of a 64 KiB BO, in every present.exe run.
+       * 0063: only until it has been listed once (it is paged in and mapped from then on; the aperture is 1 GB
+       * and nothing evicts while it is far from full), and always for the BOs made before the context's first
+       * submission (the screen's own: sample positions and the like, which no batch names). Run g2b3-24 listed
+       * ~240 unnamed BOs with every one of 100-250 submissions per second - RenderCb 0.4-1.1 ms each, plus the
+       * scheduler preparing them all per DMA buffer - and with more than 256 live BOs the high handles were never
+       * listed anyway, without a fault. S10_LIST_ALL=1: the old rule. */
+      static int list_all = -1;
+      if (list_all < 0) {
+         const char *e = getenv("S10_LIST_ALL");
+         list_all = e && *e == '1';
+      }
+      uint32_t named = n;
+      for (uint32_t i = 0; i < wbo_cap && n < walloc_size; i++) {
+         struct wbo_s *bo = &wbo[i];
+         if (!bo->h || bo->listed == mark)
+            continue;
+         if (!list_all && bo->seen && !bo->pinned)
+            continue;
+         bo->seen = 1;
+         bo->listed = mark;
+         memset(&walloc[n], 0, sizeof(walloc[n]));
+         walloc[n].hAllocation = bo->h;
+         walloc[n].WriteOperation = 1;
+         n++;
+      }
+      if (trace_on() && n != named)
+         fprintf(stderr, "malikm-wddm: submit names %u BOs, %u more listed for residency\n",
+                 named, n - named);
+      MW_COMMAND *c = wcmd;
+      c->Type = MW_CMD_JOB;
+      c->Slot = (a->requirements & PANFROST_JD_REQ_FS) ? 0 : 1;
+      c->Jc = a->jc;
+      NTSTATUS st = w_render(sizeof(*c), n);
+      if (st < 0) {
+         /* exynos-woa 0044: always, rate-limited - the S10's DWM got 364 x "panfrost_batch_submit failed: 5" and the
+          * status was never printed. */
+         static unsigned render_fails;
+         render_fails++;
+         wperf.render_fails++;
+         if (trace_on() || render_fails <= 8 || render_fails % 100 == 0) {
+            uint32_t live = 0;
+            for (uint32_t i = 0; i < wbo_cap; i++)
+               live += wbo[i].h != 0;
+            fprintf(stderr, "malikm-wddm: pid %lu: Render failed 0x%08lx (#%u): jc 0x%llx slot %u, %u BOs named, "
+                    "%u listed of %u slots, %u live BOs, ddi %d\n",
+                    GetCurrentProcessId(), (unsigned long)st, render_fails, (unsigned long long)a->jc, c->Slot,
+                    named, n, walloc_size, live, ddi.on);
+         }
+         return -MK_EIO;
+      }
+      /* 0057: what this submission is the fence of (w_render made it wseq) */
+      for (uint32_t i = 0; i < a->bo_handle_count; i++) {
+         struct wbo_s *bo = wddm_bo(bos[i]);
+         if (bo)
+            bo->busy = wseq;
+      }
+      if (a->out_sync && a->out_sync <= wcur->sobj_cap && wcur->sobj[a->out_sync - 1])
+         wcur->sobj[a->out_sync - 1] = wseq + 1;
+      wperf.submits++;
+      wperf.named += named;
+      wperf.listed += n;
+      return 0;
+   }
+   case MALIKM_NR_GEM_CLOSE: {
+      struct wbo_s *bo = wddm_bo(((struct drm_gem_close *)b)->handle);
+      if (!bo)
+         return -MK_EINVAL;
+      if (trace_on())
+         fprintf(stderr, "malikm-wddm: close bo %u va 0x%llx\n",
+                 ((struct drm_gem_close *)b)->handle, (unsigned long long)bo->va);
+      wperf.bo_close++;
+      if (bo->cpu)
+         w_unlock(bo->h);
+      if (bo->foreign) {
+         /* G2b-3 (0046): not this process's to destroy (the runtime closes or frees it with the resource) */
+         memset(bo, 0, sizeof(*bo));
+         return 0;
+      }
+      D3DKMT_HANDLE h = bo->h;
+      memset(bo, 0, sizeof(*bo));   /* the handle number is free at once */
+      /* 0057: nothing in flight could use it - destroyed now; else when the newest submission is done (wdead) */
+      w_retire();
+      if (wseq <= wdone) {
+         w_destroy(h);
+         return 0;
+      }
+      if (wdead_n == wdead_cap) {
+         uint32_t cap = wdead_cap ? wdead_cap * 2 : 64;
+         struct wdead_s *n = realloc(wdead, cap * sizeof(*n));
+         if (!n) {
+            wddm_idle();
+            w_destroy(h);
+            return 0;
+         }
+         wdead = n;
+         wdead_cap = cap;
+      }
+      wdead[wdead_n].h = h;
+      wdead[wdead_n].seq = wseq;
+      wdead_n++;
+      if (wdead_n >= WDEAD_MAX)
+         wddm_idle();
+      return 0;
+   }
+   /* 0057: syncobjs carry the sequence number of their fence (0 = signalled), per descriptor as on Linux; a wait
+    * waits for that submission only, within its timeout. Handles are slots, reused once destroyed (Panfrost makes
+    * one per fence). */
+   case MALIKM_NR_SYNCOBJ_CREATE: {
+      uint32_t i = 0;
+      while (i < wcur->sobj_cap && wcur->sobj[i])
+         i++;
+      if (i == wcur->sobj_cap) {
+         uint32_t cap = wcur->sobj_cap ? wcur->sobj_cap * 2 : 64;
+         uint64_t *n = realloc(wcur->sobj, cap * sizeof(*n));
+         if (!n)
+            return -MK_ENOMEM;
+         memset(n + wcur->sobj_cap, 0, (cap - wcur->sobj_cap) * sizeof(*n));
+         wcur->sobj = n;
+         wcur->sobj_cap = cap;
+      }
+      wcur->sobj[i] = 1;   /* seq 0: signalled (unsignalled ones are not waited on before a submit sets them) */
+      ((struct drm_syncobj_create *)b)->handle = i + 1;
+      return 0;
+   }
+   case MALIKM_NR_SYNCOBJ_WAIT: {
+      struct drm_syncobj_wait *a = (void *)b;
+      const uint32_t *hs = (const uint32_t *)(b + a->handles);
+      int any = !(a->flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL) && a->count_handles > 1;
+      uint64_t target = any ? UINT64_MAX : 0;
+      uint32_t first = 0;
+      for (uint32_t i = 0; i < a->count_handles; i++) {
+         uint32_t h = hs[i];
+         /* one this descriptor never made: everything so far */
+         uint64_t s = h && h <= wcur->sobj_cap && wcur->sobj[h - 1] ? wcur->sobj[h - 1] - 1 : wseq;
+         if (any ? s < target : s > target) {
+            target = s;
+            first = i;
+         }
+      }
+      if (!a->count_handles)
+         target = 0;
+      a->first_signaled = any ? first : 0;
+      int r = w_wait_seq(target, a->timeout_nsec, 1);
+      return r == -MK_ETIMEDOUT || r == -MK_EBUSY ? -MK_ETIME : r;   /* Linux: -ETIME */
+   }
+   case MALIKM_NR_SYNCOBJ_DESTROY: {
+      uint32_t h = ((struct drm_syncobj_destroy *)b)->handle;
+      if (!h || h > wcur->sobj_cap || !wcur->sobj[h - 1])
+         return -MK_EINVAL;
+      wcur->sobj[h - 1] = 0;
+      return 0;
+   }
+   case MALIKM_NR_SYNCOBJ_RESET:
+   case MALIKM_NR_SYNCOBJ_SIGNAL: {
+      struct drm_syncobj_array *a = (void *)b;
+      const uint32_t *hs = (const uint32_t *)(b + a->handles);
+      for (uint32_t i = 0; i < a->count_handles; i++)
+         if (hs[i] && hs[i] <= wcur->sobj_cap && wcur->sobj[hs[i] - 1])
+            wcur->sobj[hs[i] - 1] = 1;
+      return 0;
+   }
+   case MALIKM_NR_SYNCOBJ_EXPORT_SEQ: {
+      MALIKM_SYNCOBJ_SEQ *s = (MALIKM_SYNCOBJ_SEQ *)b;
+      uint32_t h = s->Handle;
+      s->Seq = h && h <= wcur->sobj_cap && wcur->sobj[h - 1] ? wcur->sobj[h - 1] - 1 : wseq;
+      return 0;
+   }
+   case MALIKM_NR_SYNCOBJ_IMPORT_SEQ: {
+      MALIKM_SYNCOBJ_SEQ *s = (MALIKM_SYNCOBJ_SEQ *)b;
+      uint32_t h = s->Handle;
+      if (h && h <= wcur->sobj_cap && wcur->sobj[h - 1])
+         wcur->sobj[h - 1] = (s->Seq == MALIKM_SEQ_LATEST || s->Seq > wseq ? wseq : s->Seq) + 1;
+      return 0;
+   }
+   default:
+      (void)size;
+      return -MK_ENOSYS;
+   }
+}
