+/* ---- G2b-3 (0059, rewritten in 0063): a sampling profiler for dwm.exe ----
+ * 0059-0061 found the CPU hog (util_resource_copy_region's memcpy, fixed in 0062: 0.7 -> 7-8 presents/s). Run
+ * g2b3-24: DWM now uses ~30 % of a core and is BLOCKED the rest of the time, and the old stack scan (first word in
+ * the image) cannot say where - a blocked thread's callee frames hold stale words.
+ * Now: every ~5 ms the thread that last called into the shim is suspended, its registers and up to 32 KB of its
+ * stack are copied (no locks, no allocation while it is suspended) and it is resumed; the COPY is then unwound with
+ * the image's unwind data (RtlVirtualUnwind; frame pointers into the real stack are redirected into the copy, and
+ * 1 MB of zeros follows it so that a bad frame reads zeros and ends the walk). A sample is filed under its leaf
+ * (for a blocked thread: the system call it sits in), the leaf's caller, and the innermost / outermost frame in
+ * maliumd.dll. Every 10 s the 12 busiest are printed, system frames with module!export+off names, ours as image
+ * offsets (symbolize: llvm-symbolizer --obj=libgallium_d3d10.dll 0x180000000+off; return addresses: -4).
+ * "running" = the thread used CPU since the previous sample. dwm.exe only, or every process with S10_PROF=1. */
+static volatile DWORD wprof_tid;
+#define WPROF_STACK (32 * 1024)
+#define WPROF_PAD   (1024 * 1024)
+static uint8_t wprof_stack[WPROF_STACK + WPROF_PAD];
+#define WPROF_SIGS 512
+#define WPROF_FR 4
+struct wprof_sig {
+   uint64_t key;                 /* 0 = free */
+   uintptr_t fr[WPROF_FR];       /* leaf first */
+   uintptr_t inner, outer;       /* innermost / outermost frame in maliumd.dll, 0 = none */
+   uint32_t n, ran, mc_n;
+   uint64_t mc_len;
+};
+static struct wprof_sig wprof_sigs[WPROF_SIGS];
+
+/* The return addresses of the copied stack, leaf first. orig_lo: the stack address the copy starts at. */
+static int
+wprof_walk(CONTEXT *c, uintptr_t orig_lo, size_t got, uintptr_t *pcs, int max)
+{
+   const uintptr_t copy = (uintptr_t)wprof_stack;
+   const intptr_t delta = (intptr_t)(copy - orig_lo);
+   int n = 0;
+   pcs[n++] = (uintptr_t)c->Pc;
+   c->Sp += delta;
+   while (n < max) {
+      if (c->Fp >= orig_lo && c->Fp < orig_lo + got)
+         c->Fp += delta;
+      else if (!(c->Fp >= copy && c->Fp < copy + got))
+         c->Fp = copy + WPROF_STACK;   /* not into the copy: must not be read through - zeros */
+      DWORD64 base = 0, est = 0, pc = c->Pc;
+      void *hd = NULL;
+      DWORD64 look = n == 1 ? pc : pc - 4;   /* a return address may be the first instruction of another function */
+      PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(look, &base, NULL);
+      if (!fe) {
+         /* a leaf: its return address is still in LR. Only the sampled frame can be one. */
+         if (n > 1 || !c->Lr || c->Lr == pc)
+            break;
+         c->Pc = c->Lr;
+      } else {
+         RtlVirtualUnwind(UNW_FLAG_NHANDLER, base, look, fe, c, &hd, &est, NULL);
+      }
+      if (!c->Pc || c->Sp < copy || c->Sp >= copy + got)
+         break;
+      pcs[n++] = (uintptr_t)c->Pc;
+   }
+   return n;
+}
+
+/* module!export+0x.. for a code address (ours: maliumd+0x<image offset>). Not while a thread is suspended. */
+static void
+wprof_name(uintptr_t a, char *out, size_t cap)
+{
+   HMODULE m = NULL;
+   if (!a) {
+      snprintf(out, cap, "-");
+      return;
+   }
+   if (a >= wimg_lo && a < wimg_hi) {
+      snprintf(out, cap, "maliumd+0x%llx", (unsigned long long)(a - wimg_lo));
+      return;
+   }
+   if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (LPCWSTR)(void *)a, &m) || !m) {
+      snprintf(out, cap, "0x%llx", (unsigned long long)a);
+      return;
+   }
+   char path[MAX_PATH] = "";
+   GetModuleFileNameA(m, path, sizeof(path));
+   const char *base = strrchr(path, '\\');
+   base = base ? base + 1 : path;
+   const uint8_t *img = (const uint8_t *)m;
+   uint32_t rva = (uint32_t)(a - (uintptr_t)m), best = 0;
+   const char *bn = NULL;
+   const IMAGE_DOS_HEADER *dos = (const IMAGE_DOS_HEADER *)img;
+   const IMAGE_NT_HEADERS *nt = (const IMAGE_NT_HEADERS *)(img + dos->e_lfanew);
+   IMAGE_DATA_DIRECTORY d = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+   if (d.VirtualAddress && d.Size >= sizeof(IMAGE_EXPORT_DIRECTORY)) {
+      const IMAGE_EXPORT_DIRECTORY *e = (const IMAGE_EXPORT_DIRECTORY *)(img + d.VirtualAddress);
+      const uint32_t *names = (const uint32_t *)(img + e->AddressOfNames);
+      const uint32_t *funcs = (const uint32_t *)(img + e->AddressOfFunctions);
+      const uint16_t *ords = (const uint16_t *)(img + e->AddressOfNameOrdinals);
+      for (uint32_t i = 0; i < e->NumberOfNames; i++) {
+         if (ords[i] >= e->NumberOfFunctions)
+            continue;
+         uint32_t f = funcs[ords[i]];
+         if (f <= rva && f > best && !(f >= d.VirtualAddress && f < d.VirtualAddress + d.Size)) {
+            best = f;
+            bn = (const char *)(img + names[i]);
+         }
+      }
+   }
+   if (bn && rva - best < 0x400)
+      snprintf(out, cap, "%s!%s+0x%x", base, bn, rva - best);
+   else
+      snprintf(out, cap, "%s+0x%x", base, rva);
+   FreeLibrary(m);
+}
+
+static void
+wprof_file(const uintptr_t *pcs, int n, int ran, int in_memcpy, uint64_t len)
+{
+   uintptr_t inner = 0, outer = 0;
+   for (int i = in_memcpy ? 1 : 0; i < n; i++) {
+      if (pcs[i] >= wimg_lo && pcs[i] < wimg_hi) {
+         if (!inner)
+            inner = pcs[i];
+         outer = pcs[i];
+      }
+   }
+   uint64_t key = 1469598103934665603ull;
+   key = (key ^ (pcs[0] >> 6)) * 1099511628211ull;
+   key = (key ^ (n > 1 ? pcs[1] : 0)) * 1099511628211ull;
+   key = (key ^ (inner >> 6)) * 1099511628211ull;
+   key = (key ^ (outer >> 6)) * 1099511628211ull;
+   key |= 1;
+   uint32_t i = (uint32_t)(key >> 20) % WPROF_SIGS;
+   for (int k = 0; k < WPROF_SIGS; k++, i = (i + 1) % WPROF_SIGS) {
+      struct wprof_sig *s = &wprof_sigs[i];
+      if (!s->key) {
+         s->key = key;
+         for (int f = 0; f < WPROF_FR; f++)
+            s->fr[f] = f < n ? pcs[f] : 0;
+         s->inner = inner;
+         s->outer = outer;
+      }
+      if (s->key == key) {
+         s->n++;
+         s->ran += ran;
+         if (in_memcpy) {
+            s->mc_n++;
+            s->mc_len += len;
+         }
+         return;
+      }
+   }
+}
+
+static DWORD WINAPI
+wprof_thread(void *arg)
+{
+   (void)arg;
+   typedef LONG (NTAPI *nqit_t)(HANDLE, int, void *, ULONG, ULONG *);
+   wimg_init();
+   if (!wimg_lo)
+      return 0;
+   HMODULE ntdll = GetModuleHandleA("ntdll.dll");
+   nqit_t nqit = ntdll ? (nqit_t)(void *)GetProcAddress(ntdll, "NtQueryInformationThread") : NULL;
+   const uintptr_t mc = (uintptr_t)(void *)memcpy;
+   uint32_t samples = 0, running = 0;
+   int64_t t0 = perf_now(), last = 0, ta = 0;
+   uint32_t pres_n = 0, pres_lost = 0;
+   int64_t pres_t = 0, pres_max = 0, pres_render_t = 0;
+   DWORD cur = 0;
+   HANDLE th = NULL;
+   uintptr_t stack_hi = 0;
+   ULONG64 cyc0 = 0;
+   for (;;) {
+      /* the present being timed (wpres_arm): wake on its events, so the times are exact */
+      HANDLE w = wpres.state == 1 ? (wpres.a ? wpres.a : wpres.b) : NULL;
+      if (w) {
+         DWORD r = WaitForSingleObject(w, 5);
+         int64_t now = perf_now();
+         if (r == WAIT_OBJECT_0 && wpres.a) {
+            ta = now;
+            CloseHandle(wpres.a);
+            wpres.a = NULL;
+         } else if (r == WAIT_OBJECT_0 || perf_ms(now - wpres.t_call) > 3000.0) {
+            if (r == WAIT_OBJECT_0) {
+               int64_t from = ta > wpres.t_call ? ta : wpres.t_call;
+               pres_n++;
+               pres_t += now - from;
+               pres_render_t += from - wpres.t_call;
+               if (now - from > pres_max)
+                  pres_max = now - from;
+            } else {
+               pres_lost++;
+            }
+            if (wpres.a)
+               CloseHandle(wpres.a);
+            CloseHandle(wpres.b);
+            wpres.a = wpres.b = NULL;
+            ta = 0;
+            InterlockedExchange(&wpres.state, 0);
+         }
+      } else {
+         Sleep(5);
+      }
+      int64_t now = perf_now();
+      if (perf_ms(now - last) < 4.5)
+         continue;
+      last = now;
+
+      DWORD tid = wprof_tid;
+      if (tid != cur) {
+         if (th)
+            CloseHandle(th);
+         th = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, tid);
+         cur = tid;
+         stack_hi = 0;
+         cyc0 = 0;
+         if (th && nqit) {
+            struct { LONG status; void *teb; void *cid[2]; ULONG_PTR affinity; LONG prio, base_prio; } bi;
+            memset(&bi, 0, sizeof(bi));
+            if (nqit(th, 0 /* ThreadBasicInformation */, &bi, sizeof(bi), NULL) >= 0 && bi.teb)
+               stack_hi = (uintptr_t)((const NT_TIB *)bi.teb)->StackBase;
+         }
+      }
+      if (th) {
+         ULONG64 cyc = 0;
+         QueryThreadCycleTime(th, &cyc);
+         int ran = cyc0 && cyc - cyc0 > 100000;
+         cyc0 = cyc;
+         if (SuspendThread(th) != (DWORD)-1) {
+            CONTEXT c;
+            memset(&c, 0, sizeof(c));
+            c.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+            int ok = GetThreadContext(th, &c);
+            SIZE_T got = 0;
+            if (ok) {
+               SIZE_T want = 4096;
+               if (stack_hi > c.Sp)
+                  want = stack_hi - c.Sp < WPROF_STACK ? (SIZE_T)(stack_hi - c.Sp) : WPROF_STACK;
+               ReadProcessMemory(GetCurrentProcess(), (void *)(uintptr_t)c.Sp, wprof_stack, want, &got);
+            }
+            ResumeThread(th);
+            if (ok) {
+               uintptr_t pcs[64];
+               const uintptr_t sp = (uintptr_t)c.Sp;
+               const uint64_t x8 = c.X8;
+               if (got < WPROF_STACK)
+                  memset(wprof_stack + got, 0, WPROF_STACK - got);
+               int n = wprof_walk(&c, sp, got, pcs, 64);
+               int in_mc = pcs[0] >= mc && pcs[0] < mc + 0x100;
+               samples++;
+               running += ran;
+               wprof_file(pcs, n, ran, in_mc, x8 + 1);
+            }
+         }
+      }
+      if (perf_ms(now - t0) >= 10000.0) {
+         if (samples) {
+            fprintf(stderr, "malikm-prof: pid %lu tid %lu: %u samples, %u running | present packets timed: %u, "
+                    "%.1f ms each (max %.1f) from the later of {present call, last render done} to done; the last "
+                    "render was done %.1f ms after the call on average; %u not done in 3 s\n",
+                    GetCurrentProcessId(), cur, samples, running, pres_n,
+                    pres_n ? perf_ms(pres_t) / pres_n : 0.0, perf_ms(pres_max),
+                    pres_n ? perf_ms(pres_render_t) / pres_n : 0.0, pres_lost);
+            /* 0068: where ALL the samples are (the 12 biggest signatures below left half of them unexplained in
+             * run 29). By the sampled frame: waiting = an Nt*Wait* / delay call; kernel = any other win32u / ntdll
+             * Nt* call; "in the driver" = some frame of the stack is in maliumd, counted under its entry point. */
+            {
+               uint32_t idle = 0, out_k = 0, out_run = 0, in_wait = 0, in_k = 0, in_run = 0;
+               struct { uintptr_t fn; uint32_t n, w, k; } ent[24];
+               int nent = 0;
+               memset(ent, 0, sizeof(ent));
+               for (int i = 0; i < WPROF_SIGS; i++) {
+                  const struct wprof_sig *g = &wprof_sigs[i];
+                  if (!g->key || !g->n)
+                     continue;
+                  char leaf[160];
+                  wprof_name(g->fr[0], leaf, sizeof(leaf));
+                  const int sys = strstr(leaf, "win32u.dll!Nt") || strstr(leaf, "ntdll.dll!Nt") ||
+                                  strstr(leaf, "ntdll.dll!Zw");
+                  const int wait = sys && (strstr(leaf, "Wait") || strstr(leaf, "DelayExecution") ||
+                                           strstr(leaf, "RemoveIoCompletion") || strstr(leaf, "GetMessage"));
+                  if (!g->outer) {
+                     if (wait) idle += g->n; else if (sys) out_k += g->n; else out_run += g->n;
+                     continue;
+                  }
+                  if (wait) in_wait += g->n; else if (sys) in_k += g->n; else in_run += g->n;
+                  DWORD64 base = 0;
+                  PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry((DWORD64)g->outer - 4, &base, NULL);
+                  const uintptr_t fn = fe ? (uintptr_t)(base + fe->BeginAddress) : g->outer;
+                  int e = 0;
+                  while (e < nent && ent[e].fn != fn)
+                     e++;
+                  if (e == 24)
+                     e = 23;   /* the rest share the last slot */
+                  else if (e == nent)
+                     ent[nent++].fn = fn;
+                  ent[e].n += g->n;
+                  ent[e].w += wait ? g->n : 0;
+                  ent[e].k += !wait && sys ? g->n : 0;
+               }
+               char line[1400];
+               int o = snprintf(line, sizeof(line), "malikm-prof: pid %lu split of %u samples: outside the driver "
+                                "%u waiting + %u in kernel calls + %u running | in the driver %u waiting + %u in "
+                                "kernel calls + %u running | by entry (samples/waiting/kernel):",
+                                GetCurrentProcessId(), samples, idle, out_k, out_run, in_wait, in_k, in_run);
+               for (int top = 0; top < 10 && o < (int)sizeof(line) - 48; top++) {
+                  int best = -1;
+                  for (int e = 0; e < nent; e++)
+                     if (ent[e].n && (best < 0 || ent[e].n > ent[best].n))
+                        best = e;
+                  if (best < 0)
+                     break;
+                  o += snprintf(line + o, sizeof(line) - o, " +0x%llx %u/%u/%u",
+                                (unsigned long long)(ent[best].fn - wimg_lo), ent[best].n, ent[best].w, ent[best].k);
+                  ent[best].n = 0;
+               }
+               fprintf(stderr, "%s\n", line);
+            }
+            for (int top = 0; top < 12; top++) {
+               struct wprof_sig *b = NULL;
+               for (int i = 0; i < WPROF_SIGS; i++)
+                  if (wprof_sigs[i].key && wprof_sigs[i].n && (!b || wprof_sigs[i].n > b->n))
+                     b = &wprof_sigs[i];
+               if (!b)
+                  break;
+               char nm[WPROF_FR][160], mcs[64] = "";
+               for (int f = 0; f < WPROF_FR; f++)
+                  wprof_name(b->fr[f], nm[f], sizeof(nm[f]));
+               if (b->mc_n)
+                  snprintf(mcs, sizeof(mcs), " memcpy x%u avg %llu KB", b->mc_n,
+                           (unsigned long long)(b->mc_len / b->mc_n / 1024));
+               fprintf(stderr, "malikm-prof: pid %lu   x%u (%u running)%s: %s < %s < %s < %s | in maliumd: "
+                       "inner +0x%llx, entry +0x%llx\n", GetCurrentProcessId(), b->n, b->ran, mcs,
+                       nm[0], nm[1], nm[2], nm[3],
+                       (unsigned long long)(b->inner ? b->inner - wimg_lo : 0),
+                       (unsigned long long)(b->outer ? b->outer - wimg_lo : 0));
+               b->n = 0;
+            }
+         }
+         memset(wprof_sigs, 0, sizeof(wprof_sigs));
+         samples = running = 0;
+         pres_n = pres_lost = 0;
+         pres_t = pres_max = pres_render_t = 0;
+         t0 = now;
+      }
+   }
+}
+
+static void
+wprof_note(void)
+{
+   if (wprof_on < 0) {
+      char exe[MAX_PATH] = "";
+      GetModuleFileNameA(NULL, exe, sizeof(exe));
+      const char *b = strrchr(exe, '\\');
+      const char *e = getenv("S10_PROF");
+      int on = (e && *e == '1') || _stricmp(b ? b + 1 : exe, "dwm.exe") == 0;
+      if (on) {
+         HANDLE t = CreateThread(NULL, 0, wprof_thread, NULL, 0, NULL);
+         if (t)
+            CloseHandle(t);
+         else
+            on = 0;
+      }
+      wprof_on = on;
+   }
+   if (wprof_on)
+      wprof_tid = GetCurrentThreadId();
+}
+
+static void
+wddm_ioctl(int fd, DWORD code, void *buf, DWORD len)
+{
+   MALIKM_DRM_HEADER *h = buf;
+   (void)len;
+
+   wprof_note();   /* 0059 */
+   int64_t lw0 = cb_now();
+   AcquireSRWLockExclusive(&wddm_lock);
+   wlockwait_t += cb_now() - lw0;   /* 0063 */
+   wcur = fd_ctx(fd);   /* 0053 */
+   switch (code) {
+   case IOCTL_MALIKM_VERSION: {
+      MALIKM_VERSION *v = buf;
+      memset(v, 0, sizeof(*v));
+      v->Major = MALIKM_DRM_MAJOR;
+      v->Minor = MALIKM_DRM_MINOR;
+      strcpy(v->Name, "panfrost");
+      break;
+   }
+   case IOCTL_MALIKM_MAP: {
+      /* A persistent mapping: Panfrost keeps BOs mapped for their lifetime.
+       * IgnoreSync: the GPU may still use the BO; ordering is Panfrost's. */
+      MALIKM_MAP *m = (MALIKM_MAP *)(h + 1);
+      struct wbo_s *bo = wddm_bo(MALIKM_MMAP_HANDLE(m->Offset));
+      h->Result = -MK_EINVAL;
+      if (bo && m->Size <= bo->size && bo->foreign != WBO_OPENED) {
+         if (!bo->cpu)
+            bo->cpu = w_lock(bo->h);
+         if (bo->cpu) {
+            m->Address = (uint64_t)(uintptr_t)bo->cpu;
+            h->Result = 0;
+         }
+      }
+      break;
+   }
+   case IOCTL_MALIKM_UNMAP:
+      h->Result = 0;   /* the Lock stays until GEM_CLOSE */
+      break;
+   case IOCTL_MALIKM_DRM:
+      h->Result = wddm_drm(h->Nr, (uint8_t *)(h + 1), h->Size);
+      break;
+   default:
+      h->Result = -MK_ENOSYS;
+      break;
+   }
+   if (trace_on() && code == IOCTL_MALIKM_DRM)
+      fprintf(stderr, "malikm-wddm: nr 0x%x -> %d\n", h->Nr, h->Result);
+   if (code == IOCTL_MALIKM_DRM)
+      perf_tick();   /* 0057 */
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+/* G2b-3 (0063): a BO that jobs use for its whole life without naming it (pan_mempool.c: the screen's shader and
+ * descriptor pools) - it stays in every allocation list. */
+void
+malikm_bo_pin(int fd, uint32_t handle)
+{
+   if (!wddm_on())
+      return;
+   AcquireSRWLockExclusive(&wddm_lock);
+   wcur = fd_ctx(fd);
+   struct wbo_s *bo = wddm_bo(handle);
+   if (bo)
+      bo->pinned = 1;
+   ReleaseSRWLockExclusive(&wddm_lock);
+}
+
+/* ---- MALIKM_FAKE ----
+ * The driver, emulated in this process on the same marshalled buffers, for
+ * CI runners with no Mali: buffers are ordinary memory, the GET_PARAM values
+ * are the RK3576's G52 as Linux Panfrost reported it, and every job
+ * "completes" the moment it is submitted without anything running. It drives
+ * Panfrost's whole Windows path (screen, compiler, command streams, the shim's
+ * marshalling) short of the GPU. Pixels read back are whatever was there. */
+
+struct fake_bo {
+   void *cpu;
+   uint64_t size, va;
+   uint32_t flags;
+};
+static struct fake_bo *fbo;
+static uint32_t fbo_cap, fsync_next = 1;
+static uint64_t fva = 0x2000000, fseq, fsubmits;
+static SRWLOCK fake_lock = SRWLOCK_INIT;
+static int fake = -1;
+
+static int
+fake_on(void)
+{
+   if (fake < 0) {
+      const char *e = getenv("MALIKM_FAKE");
+      fake = e && *e && *e != '0';
+   }
+   return fake;
+}
+
+/* MALIKM_FAKE=2: also log every call. */
+static int
+fake_trace(void)
+{
+   const char *e = getenv("MALIKM_FAKE");
+   return e && *e == '2';
+}
+
+static struct fake_bo *
+fake_bo(uint32_t h)
+{
+   return h && h <= fbo_cap && fbo[h - 1].cpu ? &fbo[h - 1] : NULL;
+}
+
+static int
+fake_drm(uint32_t nr, uint8_t *b, uint32_t size)
+{
+   switch (nr) {
+   case MALIKM_NR_PANFROST_GET_PARAM: {
+      struct drm_panfrost_get_param *a = (void *)b;
+      static const uint64_t v[] = {
+         [DRM_PANFROST_PARAM_GPU_PROD_ID] = 0x7402,
+         [DRM_PANFROST_PARAM_GPU_REVISION] = 0x1000,
+         [DRM_PANFROST_PARAM_SHADER_PRESENT] = 0x7,
+         [DRM_PANFROST_PARAM_TILER_PRESENT] = 0x1,
+         [DRM_PANFROST_PARAM_L2_PRESENT] = 0x1,
+         [DRM_PANFROST_PARAM_AS_PRESENT] = 0xff,
+         [DRM_PANFROST_PARAM_JS_PRESENT] = 0x7,
+         [DRM_PANFROST_PARAM_L2_FEATURES] = 0x07120206,
+         [DRM_PANFROST_PARAM_CORE_FEATURES] = 0x2,
+         [DRM_PANFROST_PARAM_TILER_FEATURES] = 0x209,
+         [DRM_PANFROST_PARAM_MEM_FEATURES] = 0x1,
+         [DRM_PANFROST_PARAM_MMU_FEATURES] = 0x2823,
+         [DRM_PANFROST_PARAM_NR_CORE_GROUPS] = 1,
+         [DRM_PANFROST_PARAM_SELECTED_COHERENCY] = DRM_PANFROST_GPU_COHERENCY_NONE,
+      };
+      if (a->param > DRM_PANFROST_PARAM_AFBC_FEATURES &&
+          a->param != DRM_PANFROST_PARAM_SELECTED_COHERENCY)
+         return -MK_EINVAL;
+      a->value = v[a->param];
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_CREATE_BO: {
+      struct drm_panfrost_create_bo *a = (void *)b;
+      uint64_t sz = ((uint64_t)a->size + 4095) & ~4095ull;
+      if (a->flags & PANFROST_BO_HEAP)
+         sz = (sz + 0x1fffff) & ~0x1fffffull;
+      void *cpu = VirtualAlloc(NULL, (SIZE_T)sz, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+      if (!cpu)
+         return -MK_ENOMEM;
+      uint32_t h = 0;
+      for (uint32_t i = 0; i < fbo_cap && !h; i++)
+         if (!fbo[i].cpu)
+            h = i + 1;
+      if (!h) {
+         uint32_t cap = fbo_cap ? fbo_cap * 2 : 256;
+         struct fake_bo *n = realloc(fbo, cap * sizeof(*n));
+         if (!n) {
+            VirtualFree(cpu, 0, MEM_RELEASE);
+            return -MK_ENOMEM;
+         }
+         memset(n + fbo_cap, 0, (cap - fbo_cap) * sizeof(*n));
+         fbo = n;
+         h = fbo_cap + 1;
+         fbo_cap = cap;
+      }
+      /* Executable buffers stay inside one 16 MB window, as in the driver. */
+      if (!(a->flags & PANFROST_BO_NOEXEC) && (fva >> 24) != ((fva + sz - 1) >> 24))
+         fva = (fva + 0xffffff) & ~0xffffffull;
+      fbo[h - 1] = (struct fake_bo){cpu, sz, fva, a->flags};
+      fva += sz;
+      a->handle = h;
+      a->offset = fbo[h - 1].va;
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_MMAP_BO: {
+      struct drm_panfrost_mmap_bo *a = (void *)b;
+      if (!fake_bo(a->handle))
+         return -MK_ENOENT;
+      a->offset = MALIKM_MMAP_OFFSET(a->handle);
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_GET_BO_OFFSET: {
+      struct drm_panfrost_get_bo_offset *a = (void *)b;
+      struct fake_bo *bo = fake_bo(a->handle);
+      if (!bo)
+         return -MK_ENOENT;
+      a->offset = bo->va;
+      return 0;
+   }
+   case MALIKM_NR_PANFROST_MADVISE:
+      ((struct drm_panfrost_madvise *)b)->retained = 1;
+      return 0;
+   case MALIKM_NR_PANFROST_WAIT_BO:
+      return fake_bo(((struct drm_panfrost_wait_bo *)b)->handle) ? 0 : -MK_ENOENT;
+   case MALIKM_NR_PANFROST_SUBMIT: {
+      struct drm_panfrost_submit *a = (void *)b;
+      const uint32_t *bos = (const uint32_t *)(b + a->bo_handles);
+      for (uint32_t i = 0; i < a->bo_handle_count; i++)
+         if (!fake_bo(bos[i]))
+            return -MK_ENOENT;
+      if (!a->jc)
+         return -MK_EINVAL;
+      fseq++;
+      if (++fsubmits <= 16 || (fsubmits & 255) == 0)
+         fprintf(stderr, "malikm-fake: submit %llu jc=0x%llx reqs=%u bos=%u in=%u out=%u\n",
+                 (unsigned long long)fsubmits, (unsigned long long)a->jc, a->requirements,
+                 a->bo_handle_count, a->in_sync_count, a->out_sync);
+      return 0;
+   }
+   case MALIKM_NR_GEM_CLOSE: {
+      struct fake_bo *bo = fake_bo(((struct drm_gem_close *)b)->handle);
+      if (!bo)
+         return -MK_EINVAL;
+      VirtualFree(bo->cpu, 0, MEM_RELEASE);
+      bo->cpu = NULL;
+      return 0;
+   }
+   case MALIKM_NR_SYNCOBJ_CREATE:
+      ((struct drm_syncobj_create *)b)->handle = fsync_next++;
+      return 0;
+   case MALIKM_NR_SYNCOBJ_WAIT:
+      ((struct drm_syncobj_wait *)b)->first_signaled = 0;
+      return 0;
+   case MALIKM_NR_SYNCOBJ_DESTROY:
+   case MALIKM_NR_SYNCOBJ_RESET:
+   case MALIKM_NR_SYNCOBJ_SIGNAL:
+      return 0;
+   case MALIKM_NR_SYNCOBJ_EXPORT_SEQ:
+      ((MALIKM_SYNCOBJ_SEQ *)b)->Seq = fseq;
+      return 0;
+   case MALIKM_NR_SYNCOBJ_IMPORT_SEQ:
+      return 0;
+   default:
+      (void)size;
+      return -MK_ENOSYS;
+   }
+}
+
+static void
+fake_ioctl(DWORD code, void *buf, DWORD len)
+{
+   MALIKM_DRM_HEADER *h = buf;
+   (void)len;
+
+   AcquireSRWLockExclusive(&fake_lock);
+   if (fake_trace())
+      fprintf(stderr, "malikm-fake: ioctl 0x%lx nr 0x%x size %u\n", (unsigned long)code,
+              code == IOCTL_MALIKM_DRM ? h->Nr : 0, code == IOCTL_MALIKM_DRM ? h->Size : 0);
+   switch (code) {
+   case IOCTL_MALIKM_VERSION: {
+      MALIKM_VERSION *v = buf;
+      memset(v, 0, sizeof(*v));
+      v->Major = MALIKM_DRM_MAJOR;
+      v->Minor = MALIKM_DRM_MINOR;
+      strcpy(v->Name, "panfrost");
+      break;
+   }
+   case IOCTL_MALIKM_MAP: {
+      MALIKM_MAP *m = (MALIKM_MAP *)(h + 1);
+      struct fake_bo *bo = fake_bo(MALIKM_MMAP_HANDLE(m->Offset));
+      h->Result = bo && m->Size <= bo->size ? 0 : -MK_EINVAL;
+      if (bo)
+         m->Address = (uint64_t)(uintptr_t)bo->cpu;
+      break;
+   }
+   case IOCTL_MALIKM_UNMAP:
+      h->Result = 0;
+      break;
+   case IOCTL_MALIKM_DRM:
+      h->Result = fake_drm(h->Nr, (uint8_t *)(h + 1), h->Size);
+      break;
+   default:
+      h->Result = -MK_ENOSYS;
+      break;
+   }
+   if (fake_trace() && code != IOCTL_MALIKM_VERSION)
+      fprintf(stderr, "malikm-fake:   -> %d\n", h->Result);
+   ReleaseSRWLockExclusive(&fake_lock);
+}
diff --git a/include/win32-compat/malikm_ioctl.h b/include/win32-compat/malikm_ioctl.h
new file mode 100644
index 0000000..56258cd
--- /dev/null
+++ b/include/win32-compat/malikm_ioctl.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The interface between the Mali kernel driver (drivers/malikm) and the
+ * user-mode libdrm shim (win32-compat/xf86drm.h). Shared by both.
+ *
+ * The driver implements Linux Panfrost's uAPI, version 1.1, so Mesa's own
+ * Linux backend (panfrost_kmod.c) runs unchanged. Every DRM ioctl travels as
+ * IOCTL_MALIKM_DRM: a header naming the DRM ioctl number, then the Linux
+ * struct as is. Pointer fields that name user arrays (a submit's BO and
+ * syncobj lists, a syncobj wait's handles) are rewritten by the shim into
+ * byte offsets from the start of the Linux struct, and the arrays are appended
+ * to the same buffer, so the driver never dereferences a user pointer.
+ *
+ * Timeouts: DRM takes absolute CLOCK_MONOTONIC deadlines. The shim converts
+ * them to relative nanoseconds against the clock Mesa used, so the driver
+ * only ever sees relative ones; MALIKM_TIMEOUT_INFINITE means wait forever.
+ *
+ * Errors come back in the header as negative Linux errno values.
+ *
+ * Mapping a buffer into the caller (mmap on Linux) is its own ioctl, because
+ * it has to run in the calling process.
+ */
+#pragma once
+
+#ifdef _KERNEL_MODE
+#include <ntddk.h>
+#else
+#include <windows.h>
+#include <winioctl.h>
+#endif
+
+typedef unsigned __int32 mk_u32;
+typedef signed __int32   mk_s32;
+typedef unsigned __int64 mk_u64;
+typedef signed __int64   mk_s64;
+
+#define MALIKM_DEVICE_NAME      L"\\Device\\MaliG52"
+#define MALIKM_DOS_NAME         L"\\DosDevices\\MaliG52"
+#define MALIKM_USER_PATH        L"\\\\.\\MaliG52"
+
+#define FILE_DEVICE_MALIKM      0x8A52u   /* unsigned: the codes have bit 31 set */
+#define IOCTL_MALIKM_DRM        CTL_CODE(FILE_DEVICE_MALIKM, 0x800, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_MALIKM_MAP        CTL_CODE(FILE_DEVICE_MALIKM, 0x801, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_MALIKM_UNMAP      CTL_CODE(FILE_DEVICE_MALIKM, 0x802, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_MALIKM_VERSION    CTL_CODE(FILE_DEVICE_MALIKM, 0x803, METHOD_BUFFERED, FILE_ANY_ACCESS)
+
+/* The uAPI version reported to Mesa. 1.1 is the oldest it accepts and keeps
+ * it off the later extensions (timestamps, JM contexts, BO sync and labels). */
+#define MALIKM_DRM_MAJOR        1
+#define MALIKM_DRM_MINOR        1
+
+/* DRM ioctl numbers (the nr byte of the Linux request code). */
+#define MALIKM_NR_GEM_CLOSE             0x09
+#define MALIKM_NR_SYNCOBJ_CREATE        0xBF
+#define MALIKM_NR_SYNCOBJ_DESTROY       0xC0
+#define MALIKM_NR_SYNCOBJ_WAIT          0xC3
+#define MALIKM_NR_SYNCOBJ_RESET         0xC4
+#define MALIKM_NR_SYNCOBJ_SIGNAL        0xC5
+#define MALIKM_NR_PANFROST_SUBMIT       0x40
+#define MALIKM_NR_PANFROST_WAIT_BO      0x41
+#define MALIKM_NR_PANFROST_CREATE_BO    0x42
+#define MALIKM_NR_PANFROST_MMAP_BO      0x43
+#define MALIKM_NR_PANFROST_GET_PARAM    0x44
+#define MALIKM_NR_PANFROST_GET_BO_OFFSET 0x45
+#define MALIKM_NR_PANFROST_MADVISE      0x48
+/* Not DRM: a sync file has no Windows equivalent, so the shim keeps one as
+ * the fence's sequence number and these move it in and out of a syncobj. */
+#define MALIKM_NR_SYNCOBJ_EXPORT_SEQ    0xF0
+#define MALIKM_NR_SYNCOBJ_IMPORT_SEQ    0xF1
+
+typedef struct _MALIKM_DRM_HEADER {
+    mk_u32 Nr;          /* DRM ioctl number, see above */
+    mk_u32 Size;        /* size of the Linux struct that follows */
+    mk_s32 Result;      /* out: 0 or a negative Linux errno */
+    mk_u32 Reserved;
+} MALIKM_DRM_HEADER;
+
+typedef struct _MALIKM_MAP {
+    mk_u64 Offset;      /* in: the fake offset MMAP_BO returned */
+    mk_u64 Size;        /* in */
+    mk_u64 Address;     /* out: user address in the calling process */
+} MALIKM_MAP;
+
+typedef struct _MALIKM_UNMAP {
+    mk_u64 Address;
+} MALIKM_UNMAP;
+
+typedef struct _MALIKM_VERSION {
+    mk_s32 Major, Minor, Patch;
+    char   Name[16];    /* "panfrost" */
+} MALIKM_VERSION;
+
+/* MMAP_BO's fake offset: the BO handle, in pages. Mesa carries it in an
+ * off_t, which is 32 bits on Windows. */
+#define MALIKM_MMAP_OFFSET(handle)      ((mk_u64)(handle) << 12)
+#define MALIKM_MMAP_HANDLE(offset)      ((mk_u32)((offset) >> 12))
+
+#define MALIKM_TIMEOUT_INFINITE         ((mk_s64)0x7FFFFFFFFFFFFFFFLL)
+
+/* EXPORT_SEQ / IMPORT_SEQ. Importing MALIKM_SEQ_LATEST means "everything
+ * submitted so far", the safe reading of a sync file the shim cannot name. */
+typedef struct _MALIKM_SYNCOBJ_SEQ {
+    mk_u32 Handle;
+    mk_u32 Pad;
+    mk_u64 Seq;
+} MALIKM_SYNCOBJ_SEQ;
+#define MALIKM_SEQ_LATEST               (~(mk_u64)0)
+
+/* Linux errno values the driver returns. */
+#define MK_EPERM        1
+#define MK_ENOENT       2
+#define MK_EINTR        4
+#define MK_EIO          5
+#define MK_E2BIG        7
+#define MK_ENOMEM       12
+#define MK_EFAULT       14
+#define MK_EBUSY        16
+#define MK_ENODEV       19
+#define MK_EINVAL       22
+#define MK_ENOSPC       28
+#define MK_ETIME        62
+#define MK_ENOSYS       38
+#define MK_ETIMEDOUT    110
diff --git a/include/win32-compat/maliwddm_abi.h b/include/win32-compat/maliwddm_abi.h
new file mode 100644
index 0000000..59b8ad0
--- /dev/null
+++ b/include/win32-compat/maliwddm_abi.h
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The private data maliwddm (the WDDM 1.3 kernel driver) exchanges with its
+ * user-mode side through the D3D runtime: allocation private data, the
+ * command buffer of a render, and escapes. Shared by the KMD, the UMD's
+ * Panfrost backend and the D3DKMT test (tools/windows/m5test.c).
+ *
+ * The model (docs/M5.2-PLAN.md): the KMD owns the Mali's GPU address space.
+ * It reserves a GPU address for every allocation when it is created, maps
+ * the allocation's pages there whenever VidMm makes it resident, and the UMD
+ * asks for the address once (MW_ESCAPE_ALLOC_INFO). Addresses never move,
+ * so nothing is ever patched.
+ */
+#pragma once
+
+#ifndef _KERNEL_MODE
+#include <stdint.h>
+typedef uint32_t mw_u32;
+typedef uint64_t mw_u64;
+#else
+typedef unsigned __int32 mw_u32;
+typedef unsigned __int64 mw_u64;
+#endif
+
+/* Allocation private data (D3DDDI_ALLOCATIONINFO.pPrivateDriverData). */
+#define MW_ALLOC_NOEXEC         0x1     /* not shader code: may lie anywhere, XN */
+#define MW_ALLOC_PRIMARY        0x2     /* scan-out capable (step d) */
+/* G2b-3 (KMD 1.0.36 / UMD 0069): the GPU pages of this allocation are the GOP framebuffer itself (KMD
+ * Parameters\ScanoutDirect); the UMD copies every finished DWM frame into it with the GPU before flipping, so the
+ * KMD's flip latch has nothing to copy. Width/Height/Pitch/Format must be the framebuffer's. */
+#define MW_ALLOC_FBALIAS        0x4
+
+typedef struct _MW_ALLOCATION_INFO {
+    mw_u32 Version;                     /* MW_ABI_VERSION */
+    mw_u32 Flags;                       /* MW_ALLOC_* */
+    mw_u64 Size;                        /* bytes; rounded up to pages */
+    /* Surfaces the runtime creates itself (primary, shadow, staging); 0 for
+     * plain buffers. Format is a D3DDDIFORMAT. */
+    mw_u32 Width, Height, Pitch, Format;
+} MW_ALLOCATION_INFO;
+
+#define MW_ABI_VERSION          1
+
+/* A render's command buffer is a sequence of these. */
+#define MW_CMD_JOB              1       /* run one job chain, wait for it */
+
+typedef struct _MW_COMMAND {
+    mw_u32 Type;                        /* MW_CMD_* */
+    mw_u32 Slot;                        /* 0: fragment, 1: vertex/tiler/compute */
+    mw_u64 Jc;                          /* GPU address of the first job header */
+} MW_COMMAND;
+
+/* At most this many commands per render; also the DMA buffer private data. */
+#define MW_MAX_COMMANDS         32
+
+/* Escapes (D3DKMTEscape, private driver data starts with the code). */
+#define MW_ESCAPE_ALLOC_INFO    1
+#define MW_ESCAPE_GPU_INFO      2
+#define MW_ESCAPE_STATS         3
+
+typedef struct _MW_ESCAPE_ALLOC_INFO_DATA {
+    mw_u32 Code;                        /* MW_ESCAPE_ALLOC_INFO */
+    mw_u32 hAllocation;                 /* in: D3DKMT allocation handle */
+    mw_u64 GpuVa;                       /* out */
+    mw_u64 Size;                        /* out */
+} MW_ESCAPE_ALLOC_INFO_DATA;
+
+/* GET_PARAM's values for the UMD, by Panfrost parameter number. */
+#define MW_GPU_PARAMS           45
+typedef struct _MW_ESCAPE_GPU_INFO_DATA {
+    mw_u32 Code;                        /* MW_ESCAPE_GPU_INFO */
+    mw_u32 Count;                       /* out: valid entries */
+    mw_u64 Value[MW_GPU_PARAMS];        /* out; index = DRM_PANFROST_PARAM_* */
+    mw_u64 Valid;                       /* out: bit n = Value[n] is meaningful */
+} MW_ESCAPE_GPU_INFO_DATA;
+
+/* The KMD's counters, for tests and bring-up. */
+typedef struct _MW_ESCAPE_STATS_DATA {
+    mw_u32 Code;                        /* MW_ESCAPE_STATS */
+    mw_u32 GpuUp;
+    mw_u32 Renders, Presents, Submits;
+    mw_u32 LastSubmittedFence, LastCompletedFence;
+    mw_u32 Queued, Running;
+    mw_u32 JobsDone, JobsFailed, JobsTimedOut;
+    mw_u32 LastJsStatus, LastFaultStatus;
+    mw_u32 Irqs, Resets;
+    mw_u64 LastFaultAddress;
+    /* BuildPagingBuffer: calls by DXGK_BUILDPAGINGBUFFER_OPERATION (0-15),
+     * and the last aperture map. */
+    mw_u32 PagingOps[16];
+    mw_u32 Maps, MapFails, Unmaps, LastMapPages, LastMapStatus, Allocations;
+    mw_u64 LastMapVa, LastAllocVa;
+    /* What VidMm handed DxgkDdiPatch: the allocation list of the last
+     * patched DMA buffer, first entry. */
+    mw_u32 Patches, PatchAllocations, PatchPatchLocations, PatchSegment0;
+    mw_u64 PatchAddress0;
+    /* Presents carried out on the CPU, and skipped (no pages known). */
+    mw_u32 PresentBlts, PresentFills, PresentSkips, Reserved0;
+} MW_ESCAPE_STATS_DATA;
diff --git a/include/win32-compat/poll.h b/include/win32-compat/poll.h
new file mode 100644
index 0000000..ff61743
--- /dev/null
+++ b/include/win32-compat/poll.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Waiting on fences goes through the Mali driver in M3; nothing to poll yet. */
+#pragma once
+#include <errno.h>
+#include "posix_time.h"
+#if !defined(_WINSOCK2API_) && !defined(_WINSOCKAPI_)
+struct pollfd { int fd; short events; short revents; };
+#define POLLIN   0x0001
+#define POLLPRI  0x0002
+#define POLLOUT  0x0004
+#define POLLERR  0x0008
+#define POLLHUP  0x0010
+#define POLLNVAL 0x0020
+#endif
+static inline int poll(struct pollfd *fds, unsigned long nfds, int timeout)
+{
+   (void)fds; (void)nfds; (void)timeout;
+   errno = ENOSYS;
+   return -1;
+}
diff --git a/include/win32-compat/posix_time.h b/include/win32-compat/posix_time.h
new file mode 100644
index 0000000..598d7ac
--- /dev/null
+++ b/include/win32-compat/posix_time.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* clock_gettime for Panfrost's timeouts and BO cache ages. The UCRT has only
+ * timespec_get(TIME_UTC); it stands in for CLOCK_MONOTONIC, which is fine for
+ * the relative timeouts these callers compute. */
+#pragma once
+#include <time.h>
+#ifndef CLOCK_MONOTONIC
+#define CLOCK_REALTIME  0
+#define CLOCK_MONOTONIC 1
+static inline int clock_gettime(int clk, struct timespec *ts)
+{
+   (void)clk;
+   return timespec_get(ts, TIME_UTC) ? 0 : -1;
+}
+#endif
diff --git a/include/win32-compat/pthread.h b/include/win32-compat/pthread.h
new file mode 100644
index 0000000..a87d6ae
--- /dev/null
+++ b/include/win32-compat/pthread.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Panfrost only uses plain mutexes. They map onto Mesa's simple_mtx, which
+ * (like a Linux pthread mutex, unlike a Windows CRITICAL_SECTION) is valid
+ * when zeroed: Panfrost never initialises dev->bo_map_lock and relies on
+ * that. A CRITICAL_SECTION here crashed the first panfrost_bo_unreference. */
+#pragma once
+#include "util/simple_mtx.h"
+typedef simple_mtx_t pthread_mutex_t;
+static inline int pthread_mutex_init(pthread_mutex_t *m, const void *attr)
+{
+   (void)attr;
+   simple_mtx_init(m, mtx_plain);
+   return 0;
+}
+static inline int pthread_mutex_lock(pthread_mutex_t *m) { simple_mtx_lock(m); return 0; }
+static inline int pthread_mutex_unlock(pthread_mutex_t *m) { simple_mtx_unlock(m); return 0; }
+static inline int pthread_mutex_destroy(pthread_mutex_t *m) { simple_mtx_destroy(m); return 0; }
+
+/* panfrost_kmod.c raises its event thread to SCHED_FIFO; on Windows that
+ * thread is replaced in M3, so the request simply fails. */
+#include <errno.h>
+#ifndef SCHED_FIFO
+#define SCHED_OTHER 0
+#define SCHED_FIFO  1
+#define SCHED_RR    2
+struct sched_param { int sched_priority; };
+static inline int sched_get_priority_max(int policy) { (void)policy; return 0; }
+static inline int sched_get_priority_min(int policy) { (void)policy; return 0; }
+static inline int sched_setscheduler(int pid, int policy, const struct sched_param *param)
+{ (void)pid; (void)policy; (void)param; errno = ENOSYS; return -1; }
+#endif
