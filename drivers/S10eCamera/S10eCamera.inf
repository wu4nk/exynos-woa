; S10eCamera.inf - Galaxy S10 (beyond1lte) front camera (S5K3J1) as a Windows camera: AVStream capture minidriver.
; notes/s10-camera.md. Binds the root-enumerated device camera-s10.ps1 v1.1+ creates (ROOT\S10eCamera, SetupAPI
; DIF_REGISTERDEVICE as devcon does), v1.0's software device SWD\S10eCamera, or a future DSDT node ACPI\SAMS982B.
; KS registration per the WDK's AVStream INF pattern (ks.inf / kscaptur.inf).
[Version]
Signature   = "$WINDOWS NT$"
Class       = Camera
ClassGuid   = {ca3e7ab9-b4c3-4ae6-8251-579ef933890f}
Provider    = %ProviderName%
CatalogFile = S10eCamera.cat
DriverVer   = 11/18/2026,0.12.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
S10eCamera.sys = 1

[DestinationDirs]
DefaultDestDir = 13

[Manufacturer]
%MfgName% = S10e, NTarm64.10.0...16299

[S10e.NTarm64.10.0...16299]
%DeviceDesc% = S10eCamera, ROOT\S10eCamera, SWD\S10eCamera, ACPI\SAMS982B

[S10eCamera]
Include   = ks.inf, kscaptur.inf
Needs     = KS.Registration, KSCAPTUR.Registration.NT
CopyFiles = S10eCamera.CopyFiles

[S10eCamera.CopyFiles]
S10eCamera.sys

[S10eCamera.Interfaces]
; reference string = the filter descriptor's ReferenceGuid (KSNAME_Filter): AVStream registers the interface
; instances as ...\#{9b365890-...}; 0.1-0.3 used "GLOBAL", whose instance no client opens (2026-11-16 registry dump).
AddInterface = %KSCATEGORY_CAPTURE%, %KSNAME_Filter%, CaptureInterface, 0
AddInterface = %KSCATEGORY_VIDEO%, %KSNAME_Filter%, CaptureInterface, 0
AddInterface = %KSCATEGORY_VIDEO_CAMERA%, %KSNAME_Filter%, CaptureInterface, 0

[CaptureInterface]
AddReg = S10eCamera.Reader.AddReg

[S10eCamera.Reader.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%FriendlyName%
; 0.11: sensor mounting offset, degrees clockwise: the camera pipeline counter-rotates (stream/camera-device-orientation)
HKR,,FSSensorOrientation,0x00010001,90

[S10eCamera.Services]
AddService = S10eCamera, 0x00000002, S10eCamera.Service

[S10eCamera.Service]
DisplayName   = %DeviceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\S10eCamera.sys
AddReg        = S10eCamera.Params.AddReg

; HKR here = the service key. 0x00010003 = DWORD + NOCLOBBER: settings changed with camera-s10.ps1 set survive a
; driver update. Rotation 270 = upright (2026-11-16); Mirror 1 (2026-11-17, user); RingWc 1 = write-combined ring.
[S10eCamera.Params.AddReg]
HKR,Parameters,Rotation,0x00010003,270
HKR,Parameters,Mirror,0x00010003,1
HKR,Parameters,RingWc,0x00010003,1

[Strings]
Proxy.CLSID              = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_CAPTURE       = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_VIDEO         = "{6994AD05-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_VIDEO_CAMERA  = "{E5323777-F976-4f5b-9B55-B94699C46E44}"
KSNAME_Filter            = "{9B365890-165F-11D0-A195-0020AFD156E4}"
ProviderName             = "exynos-woa"
MfgName                  = "exynos-woa (Galaxy S10)"
DeviceDesc               = "Galaxy S10 Front Camera (S5K3J1)"
FriendlyName             = "Galaxy S10 Front Camera"
DiskName                 = "S10eCamera"
